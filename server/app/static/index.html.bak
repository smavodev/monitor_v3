        <div style="font-size:11px;color:var(--text-dim);font-family:var(--mono)" id="ahp-serial">--</div>
      </div>
      <div style="display:flex;gap:22px;flex-wrap:wrap">
        <div><div class="side-panel-label">Usuario actual</div><div style="font-size:13px" id="ahp-user">--</div></div>
        <div><div class="side-panel-label">Estado</div><div style="font-size:13px" id="ahp-status">--</div></div>
        <div><div class="side-panel-label">Área</div><div style="font-size:13px" id="ahp-area">--</div></div>
      </div>
