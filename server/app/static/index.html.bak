  const status = document.getElementById('em-status');
  status.style.display = 'none';
  try {
    await api('/api/config/email', {method:'PUT', body: {
      enabled: document.getElementById('em-enabled').checked,
      host: document.getElementById('em-host').value.trim(),
      port: parseInt(document.getElementById('em-port').value) || 587,
      username: document.getElementById('em-user').value.trim(),
      password: document.getElementById('em-pass').value,
      from_addr: document.getElementById('em-from').value.trim(),
      to_addrs: document.getElementById('em-to').value.trim(),
      cc_addrs: document.getElementById('em-cc').value.trim(),
      bcc_addrs: document.getElementById('em-bcc').value.trim(),
      subject_template: document.getElementById('em-subject') ? document.getElementById('em-subject').value.trim() : '',
      html_template: document.getElementById('em-template').value,
    }});
    status.style.color = 'var(--green)';
    status.textContent = 'Guardado correctamente.';
    status.style.display = 'block';
    fetchEmailConfig();
  } catch (e) {
    status.style.color = 'var(--red)';
    status.textContent = e.message;
    status.style.display = 'block';
  }
}

async function testEmail() {
  const status = document.getElementById('em-status');
  status.style.display = 'none';
  const pill = document.getElementById('em-test-pill');
  if (pill) { pill.className = 'em-pill em-pill-busy'; pill.textContent = 'Enviando…'; pill.style.display = 'inline-flex'; }
  try {
    const r = await api('/api/config/email/test', {method:'POST'});
    status.style.color = r.ok ? 'var(--green)' : 'var(--red)';
    status.textContent = r.ok ? 'Correo de prueba enviado.' : (r.error || 'Error al enviar.');
    if (pill) { pill.className = 'em-pill ' + (r.ok ? 'em-pill-ok' : 'em-pill-err'); pill.textContent = r.ok ? 'Conectado' : 'Error'; }
  } catch (e) {
    status.style.color = 'var(--red)';
    status.textContent = e.message;
    if (pill) { pill.className = 'em-pill em-pill-err'; pill.textContent = 'Error'; }
  }
  status.style.display = 'block';
}

// ── Apertura del modal de notificaciones ───────────────────────────────────
async function openNotificationsModal() {
  await loadSettings();
  document.getElementById('notif-channel-select').value = 'smtp';
  switchNotifChannel('smtp');
  openModal('modal-notifications');
}

// Selector de canal de notificacion: muestra un panel a la vez (Correo por defecto).
function switchNotifChannel(name) {
  document.querySelectorAll('.notif-acc-body').forEach(b => b.classList.remove('open'));
  document.getElementById(`notif-section-${name}`)?.classList.add('open');
}

// ── Apertura del modal de política de contraseñas ──────────────────────────
async function openPasswordPolicyModal() {
  await fetchPasswordPolicy();
  openModal('modal-password-policy');
}

// ── Vista previa y restauración de la plantilla HTML ────────────────────────
const DEFAULT_EMAIL_TEMPLATE = `<div style="font-family:'Segoe UI',Arial,sans-serif;max-width:560px;margin:0 auto;background:#eef1f6;padding:24px">
  <div style="border-radius:20px;overflow:hidden;box-shadow:0 8px 32px rgba(15,23,42,.12)">
    <div style="background:#0b1220;padding:28px 28px 32px">
      <table role="presentation" cellpadding="0" cellspacing="0"><tr>
        <td style="width:34px;height:34px;background:#2563eb;border-radius:9px;text-align:center;vertical-align:middle;font-size:17px">🖥️</td>
