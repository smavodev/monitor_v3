<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SmartMonitor</title>
<link rel="icon" type="image/x-icon" href="/static/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#171c2c;--surface:#1e2540;--surface2:#28304f;--border:rgba(255,255,255,.05);
  --accent:#3b82f6;--primary:#3b82f6;--primary-dim:rgba(59,130,246,.15);
  --green:#10b981;--yellow:#f59e0b;--red:#ef4444;--purple:#8b5cf6;
  --text:#e2e8f0;--text-dim:#64748b;--text-mid:#94a3b8;
  --mono:'JetBrains Mono',monospace;--sans:'Inter',sans-serif;
  --radius:22px;--radius-sm:16px;
  /* ── Claymorphism: sombra dual suave (luz arriba-izq, sombra abajo-der) ── */
  --clay-hi:rgba(255,255,255,.045);--clay-lo:rgba(0,0,0,.5);
  --clay:-7px -7px 16px var(--clay-hi),9px 9px 20px var(--clay-lo);
  --clay-sm:-4px -4px 10px var(--clay-hi),6px 6px 14px var(--clay-lo);
  --clay-in:inset -5px -5px 10px var(--clay-hi),inset 6px 6px 14px var(--clay-lo);
  --clay-in-sm:inset -3px -3px 7px var(--clay-hi),inset 4px 4px 9px var(--clay-lo);
}
body{font-family:var(--sans);background:var(--bg);color:var(--text);min-height:100vh}
/* ── Login ── */
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;position:relative;overflow:hidden;background:radial-gradient(ellipse 900px 600px at 50% 0%,#0e1c3f 0%,var(--bg) 65%)}
.login-bg-circuit{position:absolute;width:340px;height:340px;pointer-events:none;opacity:.55;color:var(--accent)}
.login-bg-circuit.tl{top:-40px;left:-40px}
.login-bg-circuit.br{bottom:-40px;right:-40px;transform:rotate(180deg)}
.login-bg-dots{position:absolute;bottom:0;left:0;width:180px;height:180px;background-image:radial-gradient(circle,rgba(59,130,246,.4) 1.5px,transparent 1.5px);background-size:20px 20px;-webkit-mask-image:linear-gradient(135deg,transparent 30%,black 65%,transparent 100%);mask-image:linear-gradient(135deg,transparent 30%,black 65%,transparent 100%);pointer-events:none}
.login-card{background:rgba(17,24,45,.88);backdrop-filter:blur(8px);border:1px solid rgba(59,130,246,.35);border-radius:28px;padding:40px;width:100%;max-width:420px;box-shadow:var(--clay),0 0 70px rgba(37,99,235,.18);position:relative;z-index:1}
.login-logo{text-align:center;margin-bottom:20px}
.login-logo-icon{width:80px;height:80px;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;box-shadow:0 0 0 1px rgba(59,130,246,.45),0 0 44px rgba(37,99,235,.55)}
.login-logo-icon img{width:100%;height:100%;object-fit:cover}
.login-title{font-size:26px;font-weight:700;letter-spacing:-.5px}
.login-sub{font-size:13px;color:var(--text-dim);margin-top:4px}
.login-divider{width:44px;height:2.5px;background:var(--accent);border-radius:2px;margin:18px auto;box-shadow:0 0 10px rgba(59,130,246,.7)}
.login-field-wrap{position:relative}
.login-field-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--accent);pointer-events:none;width:16px;height:16px;opacity:.85}
.login-field-wrap .form-input{padding-left:38px}
.login-pass-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;padding:5px;display:flex;border-radius:6px}
.login-pass-toggle:hover{color:var(--text);background:var(--surface2)}
.login-row{display:flex;align-items:center;justify-content:space-between;margin:2px 0 18px;font-size:12.5px}
.login-remember{display:flex;align-items:center;gap:7px;color:var(--text-mid);cursor:pointer;user-select:none}
.login-remember input{accent-color:var(--accent);width:14px;height:14px;cursor:pointer}
.login-forgot{color:var(--accent);background:none;border:none;font-size:12.5px;font-family:inherit;cursor:pointer;padding:0}
.login-forgot:hover{text-decoration:underline}
.login-submit{background:linear-gradient(135deg,var(--accent),#2563eb);display:flex;align-items:center;justify-content:center;gap:8px}
.login-footer{text-align:center;margin-top:22px;padding-top:16px;border-top:1px solid var(--border);font-size:11.5px;color:var(--text-dim);display:flex;align-items:center;justify-content:center;gap:6px}
.form-group{margin-bottom:16px}
.form-label{font-size:12px;font-weight:600;color:var(--text-mid);text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:6px}
.form-input{width:100%;background:var(--surface);border:none;border-radius:var(--radius-sm);padding:12px 16px;color:var(--text);font-size:14px;font-family:var(--sans);outline:none;transition:box-shadow .15s;box-shadow:var(--clay-in-sm)}
.searchable-select-wrap{position:relative}
.searchable-select-list{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--surface);border-radius:var(--radius-sm);box-shadow:var(--clay);max-height:240px;overflow-y:auto;z-index:80;padding:4px}
.searchable-select-list.open{display:block}
.searchable-select-item{padding:8px 12px;font-size:13px;border-radius:8px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.searchable-select-item:hover,.searchable-select-item.selected{background:var(--surface2)}
.searchable-select-empty{padding:8px 12px;font-size:12px;color:var(--text-dim)}
.form-input:focus{box-shadow:var(--clay-in-sm),0 0 0 2px var(--accent)}
.btn{padding:11px 18px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;border:none;transition:all .12s;font-family:var(--sans);box-shadow:var(--clay-sm)}
.btn:active{box-shadow:var(--clay-in-sm);transform:translateY(1px)}
.btn-primary{background:var(--accent);color:white;width:100%;margin-top:8px}
.btn-primary:hover{background:#2563eb}
.btn-sm{padding:7px 14px!important;font-size:12px!important;width:auto!important;margin-top:0!important}
.btn-xs{padding:4px 9px!important;font-size:11px!important;width:auto!important;margin-top:0!important;border-radius:9px}
.btn-ghost{background:var(--surface);color:var(--text-dim)}
.btn-ghost:hover{color:var(--accent)}
.toggle-switch{position:relative;display:inline-block;width:46px;height:26px;flex-shrink:0}
.toggle-switch input{opacity:0;width:0;height:0;position:absolute}
.toggle-switch .slider{position:absolute;cursor:pointer;inset:0;background:var(--surface);box-shadow:var(--clay-in-sm);border-radius:26px;transition:.2s}
.toggle-switch .slider::before{content:'';position:absolute;height:20px;width:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.toggle-switch input:checked + .slider{background:var(--accent)}
.toggle-switch input:checked + .slider::before{transform:translateX(20px)}
.btn-danger{background:rgba(239,68,68,.15);color:var(--red)}
.btn-danger:hover{background:rgba(239,68,68,.25)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-success{background:rgba(16,185,129,.15);color:var(--green)}
.login-error{background:rgba(239,68,68,.1);color:var(--red);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:16px;display:none;box-shadow:var(--clay-in-sm)}
/* ── App Layout ── */
#app{display:none;min-height:100vh;flex-direction:row}
/* ── Sidebar ── */
.sidenav{width:240px;min-width:240px;background:var(--surface);border-right:none;display:flex;flex-direction:column;height:100vh;position:sticky;top:0;z-index:100;overflow-y:auto;box-shadow:9px 0 20px var(--clay-lo);transition:width .18s ease,min-width .18s ease}
.sidenav.collapsed{width:0;min-width:0;overflow:hidden;box-shadow:none}
.sidenav-toggle{background:none;border:none;cursor:pointer;color:var(--text-dim);padding:6px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sidenav-toggle:hover{background:var(--surface2);color:var(--text)}
.sidenav-toggle svg{width:18px;height:18px}
.sidenav-reopen{position:fixed;top:18px;left:18px;z-index:150;display:none;align-items:center;justify-content:center;background:var(--surface);border:none;border-radius:10px;width:36px;height:36px;box-shadow:var(--clay);cursor:pointer;color:var(--text-dim)}
.sidenav-reopen.visible{display:flex}
.sidenav-reopen svg{width:18px;height:18px}
.nav-logo{display:flex;align-items:center;gap:12px;padding:22px 16px 18px}
.nav-logo-icon{width:38px;height:38px;border-radius:13px;overflow:hidden;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:var(--clay-sm),0 4px 12px rgba(59,130,246,.35)}
.nav-logo-icon img{width:100%;height:100%;object-fit:cover}
.nav-logo-name{font-size:16px;font-weight:700;letter-spacing:-.4px;color:var(--text)}
.sidenav-section{padding:18px 10px 4px}
.sidenav-section-label{font-size:10px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;padding:0 8px;margin-bottom:4px;display:block}
.sidenav-divider{display:none}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--radius-sm);font-size:13px;font-weight:500;color:var(--text-dim);cursor:pointer;border:none;background:none;font-family:var(--sans);transition:all .15s;width:100%;text-align:left}
.nav-item svg{width:16px;height:16px;flex-shrink:0;opacity:.7;transition:opacity .15s}
.nav-item:hover{color:var(--text);background:var(--surface2);box-shadow:var(--clay-sm)}
.nav-item.active{background:var(--accent);color:white;font-weight:600;box-shadow:var(--clay-sm)}
.nav-item.active svg{opacity:1}
.nav-badge{margin-left:auto;background:var(--surface);color:var(--text-mid);font-size:11px;font-weight:600;padding:2px 7px;border-radius:20px;min-width:20px;text-align:center}
.nav-item.active .nav-badge{background:rgba(255,255,255,.2);color:white}
.nav-badge.danger{background:rgba(239,68,68,.15);color:var(--red)}
.nav-item.active .nav-badge.danger{background:rgba(255,255,255,.25);color:white}
.nav-status-widget{margin:12px 10px;background:var(--surface);border:none;border-radius:var(--radius-sm);padding:14px 12px;box-shadow:var(--clay-in-sm)}
.nav-status-title{font-size:10px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.8px;margin-bottom:10px}
.nav-status-rows{display:flex;flex-direction:column;gap:7px}
.nav-status-row{display:flex;align-items:center;justify-content:space-between;font-size:12px}
.nav-status-label{color:var(--text-dim);display:flex;align-items:center;gap:6px}
.nav-status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.nav-status-val{font-weight:700;font-family:var(--mono);font-size:13px}
.nav-spacer{flex:1}
.nav-bottom{padding:12px}
.nav-interval{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
.nav-interval-label{font-size:10px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
.nav-interval-label{font-size:10px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.nav-profile{display:flex;align-items:center;gap:10px;padding:10px 8px;border-radius:var(--radius-sm);transition:box-shadow .15s}
.nav-profile:hover{box-shadow:var(--clay-in-sm)}
.nav-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent);color:white;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;letter-spacing:.5px;box-shadow:var(--clay-sm)}
.nav-profile-info{flex:1;min-width:0}
.nav-profile-name{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-profile-role{font-size:11px;color:var(--text-dim);margin-top:1px}
.nav-logout-btn{background:none;border:none;cursor:pointer;color:var(--text-dim);padding:4px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
.nav-logout-btn:hover{color:var(--red);background:rgba(239,68,68,.1)}
.pulse{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;display:inline-block;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes spin{to{transform:rotate(360deg)}}
.main{flex:1;padding:28px 32px;overflow-y:auto;min-width:0}
/* ── Cards ── */
.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.summary-card{background:var(--surface);border:none;border-radius:var(--radius);padding:20px;display:flex;align-items:center;gap:16px;box-shadow:var(--clay);position:relative}
.filter-card{cursor:pointer;transition:box-shadow .15s,outline-color .15s;outline:2px solid transparent;outline-offset:-2px}
.filter-card:hover{box-shadow:var(--clay-in)}
.filter-card.filter-active{outline-color:var(--accent)}
.assigned-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);user-select:none}
.assigned-toggle .switch{position:relative;display:inline-block;width:38px;height:22px;flex-shrink:0}
.assigned-toggle .switch input{opacity:0;width:0;height:0}
.assigned-toggle .switch-slider{position:absolute;inset:0;background:var(--surface2);border-radius:22px;transition:background .15s;box-shadow:var(--clay-in-sm)}
.assigned-toggle .switch-slider::before{content:"";position:absolute;width:16px;height:16px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .15s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.assigned-toggle .switch input:checked + .switch-slider{background:var(--accent)}
.assigned-toggle .switch input:checked + .switch-slider::before{transform:translateX(16px)}
.alert-trigger{cursor:pointer;transition:box-shadow .15s}
.alert-trigger:hover{box-shadow:var(--clay-in)}
.alert-bell-icon{position:relative;width:34px;height:34px}
.alert-bell-icon svg{width:18px;height:18px;display:block}
.alert-bell-icon .nav-badge{position:absolute;top:-6px;right:-8px;font-size:10px;padding:1px 5px;min-width:16px}
.s-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:var(--clay-sm)}
.s-icon svg{width:22px;height:22px}
.s-icon.blue{background:rgba(59,130,246,.15);color:var(--accent)}
.s-icon.green{background:rgba(16,185,129,.15);color:var(--green)}
.s-icon.red{background:rgba(239,68,68,.15);color:var(--red)}
.s-icon.yellow{background:rgba(245,158,11,.15);color:var(--yellow)}
.s-icon.purple{background:rgba(139,92,246,.15);color:var(--purple)}
.pause-option-card{display:flex;align-items:center;gap:14px;background:var(--surface);border-radius:var(--radius-sm);padding:14px 16px;cursor:pointer;box-shadow:var(--clay-sm);transition:box-shadow .15s}
.pause-option-card:hover{box-shadow:var(--clay-in-sm)}
.pause-option-card .chevron{margin-left:auto;flex-shrink:0;color:var(--text-dim);width:18px;height:18px}
/* ── Modal Software (lista de programas instalados) ── */
.sw-search-wrap{position:relative;flex:1}
.sw-search-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-dim);pointer-events:none}
.sw-search-wrap input{padding-left:38px}
.sw-sort-wrap{position:relative;flex-shrink:0}
.sw-sort-btn{display:flex;align-items:center;gap:8px;white-space:nowrap;color:var(--text-mid)}
.sw-sort-menu{position:absolute;right:0;top:calc(100% + 6px);background:var(--surface);border-radius:var(--radius-sm);min-width:210px;z-index:60;display:none;box-shadow:var(--clay);padding:4px}
.sw-sort-menu.open{display:block}
.sw-sort-item{padding:9px 12px;font-size:13px;border-radius:8px;cursor:pointer;color:var(--text-mid)}
.sw-sort-item:hover{background:var(--surface2);color:var(--text)}
.sw-sort-item.active{color:var(--accent);font-weight:600}
.sw-table-head{display:flex;gap:12px;padding:0 14px 8px;font-size:11px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.4px}
.sw-row{display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:12px;transition:background .12s}
.sw-row:hover{background:var(--surface2)}
.sw-row-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;font-weight:700;color:#fff}
.sw-row-name{font-size:13px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sw-row-version{font-size:12px;color:var(--text-dim);font-family:var(--mono);width:160px;flex-shrink:0}
.sw-row-chevron{color:var(--text-dim);width:16px;height:16px;flex-shrink:0}
.sw-pagination{display:flex;align-items:center;justify-content:space-between;margin-top:14px;font-size:12px;color:var(--text-dim);flex-wrap:wrap;gap:10px}
.sw-page-btns{display:flex;gap:6px;align-items:center}
.sw-page-btn{min-width:32px;height:32px;padding:0 8px;border-radius:9px;background:var(--surface);color:var(--text-dim);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:12px;font-weight:600;border:none;box-shadow:var(--clay-sm)}
.sw-page-btn:hover:not(:disabled){background:var(--surface2);color:var(--text)}
.sw-page-btn.active{background:var(--accent);color:#fff;box-shadow:none}
.sw-page-btn:disabled{opacity:.4;cursor:not-allowed}
.sw-page-ellipsis{padding:0 4px;color:var(--text-dim)}
.hist-pill{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px}
.hist-pill-green{background:rgba(16,185,129,.15);color:var(--green)}
.hist-pill-red{background:rgba(239,68,68,.15);color:var(--red)}
.pause-option-title{font-size:13px;font-weight:700}
.pause-option-sub{font-size:11px;color:var(--text-dim);margin-top:2px}
.s-val{font-size:28px;font-weight:700;letter-spacing:-1px;line-height:1}
.s-label{font-size:12px;color:var(--text-dim);margin-top:4px}
/* ── Alert banner (panel de notificaciones) ── */
.alert-banner{position:fixed;width:380px;max-width:calc(100vw - 32px);background:var(--surface);border:none;border-radius:var(--radius);padding:0;display:none;box-shadow:var(--clay);max-height:min(440px,calc(100vh - 32px));overflow:hidden;z-index:150;flex-direction:column}
.alert-banner.visible{display:flex}
.alert-banner-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.alert-banner-title{font-size:15px;font-weight:700;color:var(--text-mid)}
.alert-banner-close{cursor:pointer;color:var(--text-dim);width:20px;height:20px;flex-shrink:0}
.alert-banner-close:hover{color:var(--text-mid)}
#alert-list{overflow-y:auto;padding:6px}
.alert-item{display:flex;align-items:flex-start;gap:10px;padding:10px 10px;border-radius:var(--radius-sm)}
.alert-item:hover{background:var(--surface2)}
.alert-icon{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:16px;background:var(--surface2)}
.alert-body{min-width:0;flex:1}
.alert-body-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.alert-body-host{font-size:13px;font-weight:600;color:var(--text-mid);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.alert-body-time{font-size:11px;color:var(--text-dim);white-space:nowrap;flex-shrink:0}
.alert-body-detail{font-size:12px;color:var(--text-dim);margin-top:1px}
.alert-empty{padding:32px 16px;text-align:center;color:var(--text-dim);font-size:13px}
#toast-container{position:fixed;top:16px;right:16px;z-index:300;display:flex;flex-direction:column;gap:10px;width:340px;max-width:calc(100vw - 32px);pointer-events:none}
.toast-item{background:var(--surface);border-radius:var(--radius);box-shadow:var(--clay);padding:10px 12px;display:flex;align-items:flex-start;gap:10px;opacity:0;transform:translateX(20px);transition:opacity .25s,transform .25s;pointer-events:auto}
.toast-item.show{opacity:1;transform:translateX(0)}
.tunnel-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}
.tunnel-dot.on{background:var(--green);box-shadow:0 0 4px var(--green)}
.tunnel-dot.off{background:var(--red)}
/* ── Section ── */
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.section-title{font-size:13px;font-weight:600;color:var(--text-mid);text-transform:uppercase;letter-spacing:.5px}
.search-input{background:var(--surface);border:none;border-radius:var(--radius-sm);padding:8px 14px;color:var(--text);font-size:13px;font-family:var(--sans);outline:none;width:200px;transition:box-shadow .15s;box-shadow:var(--clay-in-sm)}
.search-input:focus{box-shadow:var(--clay-in-sm),0 0 0 2px var(--accent)}
/* ── Agent cards ── */
.agents-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.agent-card{background:var(--surface);border:none;border-radius:var(--radius);padding:20px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden;box-shadow:var(--clay)}
.agent-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--green)}
.agent-card.offline::before{background:var(--red)}
.agent-card.warning::before{background:var(--yellow)}
.agent-card:hover{transform:translateY(-3px);box-shadow:-9px -9px 20px var(--clay-hi),12px 12px 26px var(--clay-lo)}
.agent-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px}
.agent-name{font-size:15px;font-weight:600}
.agent-meta{font-size:11px;color:var(--text-dim);margin-top:2px;font-family:var(--mono)}
.badge{font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;box-shadow:var(--clay-in-sm)}
.badge.online{background:rgba(16,185,129,.15);color:var(--green)}
.badge.offline{background:rgba(239,68,68,.15);color:var(--red)}
.badge.admin{background:rgba(139,92,246,.15);color:var(--purple)}
.badge.technician{background:rgba(59,130,246,.15);color:var(--accent)}
.badge.active{background:rgba(16,185,129,.15);color:var(--green)}
.badge.inactive{background:rgba(239,68,68,.15);color:var(--red)}
.badge.disponible{background:rgba(16,185,129,.15);color:var(--green)}
.badge.asignado{background:rgba(59,130,246,.15);color:var(--accent)}
.badge.observacion{background:rgba(245,158,11,.15);color:var(--yellow)}
.badge.baja{background:rgba(148,163,184,.18);color:var(--text-dim)}
.badge.clickable{cursor:pointer}
/* ── Metric bars ── */
.metrics{display:flex;flex-direction:column;gap:10px}
.metric-row{display:flex;flex-direction:column;gap:5px}
.metric-label-row{display:flex;justify-content:space-between;align-items:center}
.metric-label{font-size:11.5px;color:var(--text-dim);font-weight:500}
.metric-val{font-size:12px;font-family:var(--mono);font-weight:500}
.metric-val.ok{color:var(--green)}.metric-val.warn{color:var(--yellow)}.metric-val.crit{color:var(--red)}
.bar-track{height:6px;background:var(--surface);border-radius:4px;overflow:hidden;box-shadow:var(--clay-in-sm)}
.bar-fill{height:100%;border-radius:3px;transition:width .6s}
.bar-fill.ok{background:var(--green)}.bar-fill.warn{background:var(--yellow)}.bar-fill.crit{background:var(--red)}
/* ── Inventario: menú de acciones por fila, celdas de la tabla ── */
.inv-equipo-cell{display:flex;align-items:center;gap:10px}
.inv-equipo-cell .s-icon{width:36px;height:36px;border-radius:10px}
.inv-equipo-cell .s-icon svg{width:18px;height:18px}
.inv-user-avatar{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-weight:700;font-size:12px}
.inv-user-cell{display:flex;align-items:center;gap:10px}
.inv-os-cell{display:flex;align-items:center;gap:9px}
.inv-os-cell .s-icon{width:30px;height:30px;border-radius:9px;font-size:12px}
.inv-status-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.inv-spec-line{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-mid)}
.inv-spec-line svg{flex-shrink:0;color:var(--text-dim);width:13px;height:13px}
.inv-spec-line + .inv-spec-line{margin-top:4px}
.inv-perf-row{display:flex;align-items:center;gap:6px;font-size:11px;margin-bottom:4px}
.inv-perf-row:last-child{margin-bottom:0}
.inv-perf-label{width:30px;color:var(--text-dim);flex-shrink:0}
.inv-perf-row .bar-track{flex:1;min-width:36px}
.inv-perf-pct{width:30px;text-align:right;font-family:var(--mono);font-weight:600;flex-shrink:0}
.inv-perf-temp{font-size:10.5px;color:var(--text-dim);margin-left:4px;white-space:nowrap}
.inv-row-menu-btn{background:none;border:none;color:var(--text-dim);cursor:pointer;padding:4px 8px;border-radius:6px;font-size:16px;line-height:1}
.inv-row-menu-btn:hover{background:var(--surface2);color:var(--text)}
.agent-footer{margin-top:14px;padding-top:12px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.agent-foot-txt{font-size:11px;color:var(--text-dim);font-family:var(--mono)}
/* ── Detail ── */
.page-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.page-title{font-size:22px;font-weight:700;letter-spacing:-.5px}
.page-sub{font-size:13px;color:var(--text-dim);margin-top:2px}
.back-btn{display:flex;align-items:center;gap:8px;background:var(--surface);border:none;border-radius:var(--radius-sm);color:var(--text-mid);font-size:13px;font-weight:500;padding:8px 14px;cursor:pointer;font-family:var(--sans);transition:all .15s;box-shadow:var(--clay-sm)}
.back-btn:hover{color:var(--accent)}
.back-btn:active{box-shadow:var(--clay-in-sm)}
.back-btn svg{width:14px;height:14px}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.card{background:var(--surface);border:none;border-radius:var(--radius);padding:20px;box-shadow:var(--clay)}
.card-title{font-size:12px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px;margin-bottom:16px}
.card-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.card-title-row .card-title{margin-bottom:0}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-grid .form-group{margin-bottom:16px}
.form-actions{display:flex;align-items:center;gap:10px;margin-top:4px}
.em-pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:5px 12px;border-radius:20px}
.em-pill::before{content:'';width:7px;height:7px;border-radius:50%}
.em-pill-ok{background:rgba(16,185,129,.15);color:var(--green)}
.em-pill-ok::before{background:var(--green)}
.em-pill-err{background:rgba(239,68,68,.15);color:var(--red)}
.em-pill-err::before{background:var(--red)}
.em-pill-busy{background:rgba(245,158,11,.15);color:var(--yellow)}
.em-pill-busy::before{background:var(--yellow);animation:pulse 1s infinite}
.big-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.big-metrics-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.big-metric{background:var(--surface);border-radius:var(--radius-sm);padding:16px;text-align:center;box-shadow:var(--clay-in-sm)}
.big-metric-val{font-size:30px;font-weight:700;letter-spacing:-1px;font-family:var(--mono)}
.big-metric-label{font-size:11px;color:var(--text-dim);margin-top:4px}
.big-metric-sub{font-size:11px;color:var(--text-dim);margin-top:2px;font-family:var(--mono)}
/* ── RAM slots ── */
.ram-slot-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:8px}
.ram-slot{border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:6px}
.ram-slot.installed{background:linear-gradient(135deg,rgba(59,130,246,.18) 0%,rgba(59,130,246,.07) 100%);border:none;box-shadow:var(--clay-sm)}
.ram-slot.empty{opacity:.35;border:1px dashed var(--border);background:transparent}
.ram-slot-size{font-size:20px;font-weight:700;font-family:var(--mono);color:#93c5fd;letter-spacing:-.5px}
.ram-slot-empty-size{font-size:14px;font-weight:500;color:var(--text-dim)}
.ram-slot-info{display:flex;flex-direction:column;gap:2px}
.ram-slot-name{font-size:10px;color:var(--text-mid);font-family:var(--mono);word-break:break-all;line-height:1.4}
.ram-slot-detail{font-size:10px;color:rgba(147,197,253,.7);margin-top:2px}
/* ── Info table ── */
.info-table{width:100%;border-collapse:collapse}
.info-table tr{border-bottom:1px solid var(--border)}
.info-table tr:last-child{border-bottom:none}
.info-table td{padding:8px 0;font-size:13px;vertical-align:top}
.info-table td:first-child{color:var(--text-dim);width:45%;font-size:12px}
.info-table td:last-child{font-family:var(--mono);font-size:12px;color:var(--text)}
/* ── Process table ── */
.process-table{width:100%;border-collapse:collapse}
.process-table th{font-size:11px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.4px;padding:6px 0;text-align:left;border-bottom:1px solid var(--border)}
.process-table td{padding:8px 0;font-size:13px;border-bottom:1px solid rgba(30,45,69,.5);font-family:var(--mono)}
.process-table tr:last-child td{border-bottom:none}
.proc-bar-track{flex:1;height:4px;background:var(--surface);border-radius:2px;overflow:hidden;box-shadow:var(--clay-in-sm)}
.proc-bar-fill{height:100%;background:var(--accent);border-radius:2px}
/* ── Chart ── */
.chart-wrap{height:80px;position:relative}
canvas.spark{width:100%;height:80px}
.chart-legend{display:flex;gap:16px;margin-top:8px}
.legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-dim)}
.legend-dot{width:8px;height:8px;border-radius:50%}
/* ── Events ── */
.event-list{display:flex;flex-direction:column;gap:6px}
.event-item{display:flex;align-items:flex-start;gap:12px;padding:10px 12px;background:var(--surface);border-radius:var(--radius-sm);font-size:12px;box-shadow:var(--clay-in-sm)}
.event-icon{width:24px;height:24px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px}
.event-icon.offline{background:rgba(239,68,68,.15);color:var(--red)}
.event-icon.online{background:rgba(16,185,129,.15);color:var(--green)}
.event-icon.cpu_high,.event-icon.ram_high,.event-icon.disk_high,.event-icon.temp_high{background:rgba(245,158,11,.15);color:var(--yellow)}
.event-detail{flex:1}
.event-msg{color:var(--text);margin-bottom:2px}
.event-time{color:var(--text-dim);font-family:var(--mono);font-size:11px}
/* ── Events table ── */
.ev-type-pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 8px;border-radius:12px;white-space:normal;max-width:100%;line-height:1.3}
.ev-type-pill.offline{background:rgba(239,68,68,.12);color:var(--red)}
.ev-type-pill.online{background:rgba(16,185,129,.12);color:var(--green)}
.ev-type-pill.cpu_high,.ev-type-pill.ram_high,.ev-type-pill.disk_high,.ev-type-pill.temp_high{background:rgba(245,158,11,.12);color:var(--yellow)}
/* ── Export dropdown ── */
.export-dropdown{position:relative;display:inline-block}
.export-menu{position:absolute;right:0;top:calc(100% + 8px);background:var(--surface);border:none;border-radius:var(--radius-sm);min-width:200px;z-index:50;display:none;box-shadow:var(--clay)}
.export-menu.open{display:block}
.export-menu-item{display:flex;align-items:center;gap:8px;padding:10px 14px;font-size:13px;color:var(--text-mid);cursor:pointer;transition:background .1s}
.export-menu-item:hover{background:var(--surface2);color:var(--text)}
.export-menu-item svg{flex-shrink:0;opacity:.7}
/* ── Data table (users, areas) ── */
.data-table{width:100%;border-collapse:collapse}
.data-table th{font-size:12px;color:var(--text-dim);font-weight:600;text-transform:uppercase;letter-spacing:.4px;padding:10px 12px;text-align:left;border-bottom:1px solid var(--border);background:var(--surface2);position:sticky;top:0;z-index:5}
.data-table td{padding:12px;font-size:13px;border-bottom:1px solid var(--border);overflow-wrap:break-word}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--surface2)}
.inv-col-actions{position:sticky;right:0;background:var(--surface);box-shadow:-6px 0 6px -6px rgba(0,0,0,.3)}
th.inv-col-actions{z-index:6;background:var(--surface2)}
/* ── Modal ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:none;align-items:center;justify-content:center;padding:24px;overflow-y:auto}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:none;border-radius:28px;padding:28px;width:100%;max-width:420px;max-height:calc(100vh - 48px);overflow-y:auto;box-shadow:var(--clay)}
.modal-title{font-size:16px;font-weight:600;margin-bottom:20px}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
.modal-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.modal-title-row .modal-title{margin-bottom:0}
.modal-close{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:16px;line-height:1;padding:6px 10px;border-radius:10px;transition:all .15s}
.modal-close:hover{color:var(--text);background:var(--surface2)}
/* ── Panel lateral: Historial del equipo ── */
#modal-agent-history{justify-content:flex-end;padding:0}
.side-panel{width:440px;max-width:92vw;height:100%;background:var(--surface);display:flex;flex-direction:column;box-shadow:var(--clay);animation:ahpSlideIn .2s ease}
@keyframes ahpSlideIn{from{transform:translateX(100%)}to{transform:translateX(0)}}
.side-panel-header{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border);flex-shrink:0}
.side-panel-summary{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;flex-shrink:0}
.side-panel-label{font-size:10.5px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
.side-panel-tabs{display:flex;border-bottom:1px solid var(--border);padding:0 14px;flex-shrink:0;overflow-x:auto}
.side-panel-tab{background:none;border:none;padding:12px 10px;font-size:12.5px;color:var(--text-dim);cursor:pointer;border-bottom:2px solid transparent;font-weight:600;white-space:nowrap}
.side-panel-tab.active{color:var(--text);border-bottom-color:var(--accent)}
.side-panel-tab:hover:not(.active){color:var(--text-mid)}
.side-panel-body{flex:1;overflow-y:auto;padding:18px 20px}
.side-panel-footer{padding:14px 20px;border-top:1px solid var(--border);text-align:right;flex-shrink:0}
.ahp-item{display:flex;gap:12px;margin-bottom:18px}
.ahp-item:last-child{margin-bottom:0}
.ahp-item-icon{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ahp-item-icon svg{width:16px;height:16px}
.ahp-item-body{flex:1;min-width:0}
.ahp-item-title{font-size:13px;font-weight:600}
.ahp-item-sub{font-size:12px;color:var(--text-dim);margin-top:2px}
.ahp-item-date{font-size:11px;color:var(--text-dim);white-space:nowrap;text-align:right}
.notif-subtitle{font-size:12px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px;margin:18px 0 6px}
.notif-accordion{display:flex;flex-direction:column;gap:10px}
.notif-acc-item{background:var(--surface2);border-radius:var(--radius-sm);overflow:hidden}
.notif-acc-body{display:none;padding:16px}
.notif-acc-body.open{display:block}
.notif-howto{font-size:12px;line-height:1.5;color:var(--text-mid);background:var(--surface);border-radius:var(--radius-sm);padding:12px 14px;margin-bottom:16px;box-shadow:var(--clay-in-sm)}
.notif-howto code{background:var(--surface2);padding:1px 5px;border-radius:4px;font-family:var(--mono);font-size:11px}
/* ── Empty state ── */
.empty{text-align:center;padding:60px 20px;color:var(--text-dim)}
.empty svg{width:40px;height:40px;margin-bottom:12px;opacity:.3}
.empty h3{font-size:15px;font-weight:600;color:var(--text-mid);margin-bottom:6px}
.empty p{font-size:13px}
/* ── Temp badge ── */
.temp-badge{font-size:11px;font-family:var(--mono);padding:2px 8px;border-radius:4px}
.temp-badge.ok{background:rgba(16,185,129,.15);color:var(--green)}
.temp-badge.warn{background:rgba(245,158,11,.15);color:var(--yellow)}
.temp-badge.crit{background:rgba(239,68,68,.15);color:var(--red)}
/* ── Views ── */
.view{display:none}.view.active{display:block}</style>
</head>
<body>

<!-- ── LOGIN ────────────────────────────────────────────────────────────── -->
<div id="login-view" class="login-wrap">
  <svg class="login-bg-circuit tl" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 40 L60 40 L90 70 L90 130" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <circle cx="60" cy="40" r="4" fill="currentColor"/>
    <circle cx="90" cy="130" r="4" fill="currentColor"/>
    <path d="M15 95 L15 150 L48 183" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".55"/>
    <circle cx="15" cy="95" r="3" fill="currentColor" opacity=".55"/>
  </svg>
  <svg class="login-bg-circuit br" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 40 L60 40 L90 70 L90 130" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <circle cx="60" cy="40" r="4" fill="currentColor"/>
    <circle cx="90" cy="130" r="4" fill="currentColor"/>
    <path d="M15 95 L15 150 L48 183" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".55"/>
    <circle cx="15" cy="95" r="3" fill="currentColor" opacity=".55"/>
  </svg>
  <div class="login-bg-dots"></div>
  <div class="login-card">
    <div class="login-logo">
      <div class="login-logo-icon">
        <img src="/static/apple-touch-icon.png" alt="SmartMonitor">
      </div>
      <div class="login-title">SmartMonitor</div>
      <div class="login-sub">Sistema de Gestión de Equipos</div>
      <div class="login-divider"></div>
    </div>
    <div class="login-error" id="login-error">Credenciales incorrectas</div>
    <div class="form-group">
      <label class="form-label">Email</label>
      <div class="login-field-wrap">
        <svg class="login-field-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        <input class="form-input" type="email" id="login-email" placeholder="admin@smartmonitor.local" autocomplete="username">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Contraseña</label>
      <div class="login-field-wrap">
        <svg class="login-field-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/></svg>
        <input class="form-input" type="password" id="login-pass" placeholder="••••••••" autocomplete="current-password" style="padding-right:38px">
        <button type="button" class="login-pass-toggle" onclick="toggleLoginPassVisibility()" title="Mostrar/ocultar contraseña" id="login-pass-toggle-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
        </button>
      </div>
    </div>
    <div class="login-row">
      <label class="login-remember"><input type="checkbox" id="login-remember" checked> Recordarme</label>
      <button type="button" class="login-forgot" onclick="openForgotPasswordModal()">¿Olvidaste tu contraseña?</button>
    </div>
    <button class="btn btn-primary login-submit" onclick="doLogin()">
      <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg>
      Iniciar sesión
    </button>
    <div class="login-footer">
      <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
      SmartMonitor © 2026
    </div>
  </div>
</div>

<!-- ── RESTABLECER CONTRASEÑA (llegando desde el link del email) ──────────── -->
<div id="reset-view" class="login-wrap" style="display:none">
  <div class="login-card">
    <div class="login-logo">
      <div class="login-logo-icon">
        <img src="/static/apple-touch-icon.png" alt="SmartMonitor">
      </div>
      <div class="login-title">Restablecer contraseña</div>
      <div class="login-sub">Elegí una contraseña nueva para tu cuenta</div>
      <div class="login-divider"></div>
    </div>
    <div class="login-error" id="reset-error"></div>
    <div id="reset-success" style="display:none;text-align:center;padding:8px 0">
      <div style="color:var(--green);font-size:14px;margin-bottom:16px">✓ Contraseña actualizada. Ya podés iniciar sesión.</div>
      <button class="btn btn-primary login-submit" onclick="backToLoginFromReset()">Ir a iniciar sesión</button>
    </div>
    <div id="reset-form-fields">
      <div class="form-group">
        <label class="form-label">Nueva contraseña</label>
        <div class="login-field-wrap">
          <svg class="login-field-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/></svg>
          <input class="form-input" type="password" id="reset-pass1" placeholder="••••••••" autocomplete="new-password">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Confirmar contraseña</label>
        <div class="login-field-wrap">
          <svg class="login-field-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/></svg>
          <input class="form-input" type="password" id="reset-pass2" placeholder="••••••••" autocomplete="new-password">
        </div>
      </div>
      <button class="btn btn-primary login-submit" onclick="submitResetPassword()">
        <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 14l-4-4 1.41-1.41L10 12.17l6.59-6.59L18 7l-8 8z"/></svg>
        Guardar contraseña
      </button>
    </div>
    <div class="login-footer">
      <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
      SmartMonitor © 2026
    </div>
  </div>
</div>

<!-- ── Modal: Olvidé mi contraseña ─────────────────────────────────────────── -->
<div class="modal-overlay" id="modal-forgot-password" onclick="if(event.target===this)closeModal('modal-forgot-password')">
  <div class="modal" style="max-width:380px">
    <div class="modal-title-row">
      <div class="modal-title">¿Olvidaste tu contraseña?</div>
      <button class="modal-close" onclick="closeModal('modal-forgot-password')" aria-label="Cerrar">✕</button>
    </div>
    <div id="forgot-form-fields">
      <p style="font-size:13px;color:var(--text-dim);margin-bottom:16px">Ingresá tu email y, si tenés una cuenta, te mandamos un enlace para restablecer tu contraseña.</p>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input class="form-input" type="email" id="forgot-email" placeholder="admin@smartmonitor.local" autocomplete="username">
      </div>
      <div class="form-actions" style="margin-top:8px">
        <button class="btn btn-ghost" onclick="closeModal('modal-forgot-password')">Cancelar</button>
        <button class="btn btn-primary" onclick="submitForgotPassword()" id="forgot-submit-btn">Enviar enlace</button>
      </div>
    </div>
    <div id="forgot-success-msg" style="display:none;font-size:13px;color:var(--green);text-align:center;padding:8px 0">
      Si el correo existe, te enviamos un enlace para restablecer tu contraseña. Revisá tu bandeja de entrada (y spam).
    </div>
  </div>
</div>

<!-- ── APP ──────────────────────────────────────────────────────────────── -->
<div id="app">
  <!-- Panel de alertas: flotante, fuera de cualquier vista especifica -
  se abre desde el icono de campana en la tarjeta "Alertas activas" del
  Dashboard, anclado justo debajo (estilo Outlook, ver toggleAlertPanel). -->
  <div class="alert-banner" id="alert-banner">
    <div class="alert-banner-header">
      <div class="alert-banner-title">Notificaciones</div>
      <svg class="alert-banner-close" onclick="toggleAlertPanel()" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </div>
    <div id="alert-list"></div>
  </div>
  <!-- Notificaciones tipo toast: aparecen al surgir una alerta nueva (sin
  importar la vista activa) y se desvanecen solas a los pocos segundos -->
  <div id="toast-container"></div>
  <button class="sidenav-reopen" id="sidenav-reopen-btn" onclick="toggleSidenav()" title="Mostrar menú">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
  </button>
  <nav class="sidenav" id="sidenav">
    <div class="nav-logo">
      <div class="nav-logo-icon">
        <img src="/static/apple-touch-icon.png" alt="SmartMonitor">
      </div>
      <span class="nav-logo-name">SmartMonitor</span>
      <button class="sidenav-toggle" onclick="toggleSidenav()" title="Ocultar menú" style="margin-left:auto">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
    </div>

    <div class="sidenav-section">
      <span class="sidenav-section-label">Monitoreo</span>
      <button class="nav-item active" id="nav-dashboard" onclick="showView('dashboard')">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
        Dashboard
        <span class="nav-badge danger" id="nav-badge-offline" style="display:none">0</span>
      </button>
      <button class="nav-item" id="nav-events" onclick="showView('events')">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
        Eventos
      </button>
    </div>

    <div class="sidenav-section">
      <span class="sidenav-section-label">Gestión</span>
      <button class="nav-item" id="nav-inventory" onclick="showView('inventory')">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6H4v14h16V6z" opacity=".3"/><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12z"/></svg>
        Inventario
      </button>
      <button class="nav-item" id="nav-discovery" onclick="showView('discovery')">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        Descubrimiento
      </button>
      <button class="nav-item admin-only" id="nav-areas" onclick="showView('areas')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Áreas
      </button>
    </div>

    <div class="sidenav-section">
      <span class="sidenav-section-label">Control parental</span>
      <button class="nav-item admin-only" id="nav-parental-categories" onclick="showView('parental-categories')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
        Categorías
      </button>
      <button class="nav-item admin-only" id="nav-parental-blocked" onclick="showView('parental-blocked')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"/></svg>
        Bloqueo de sitios
      </button>
      <button class="nav-item admin-only" id="nav-parental-schedule" onclick="showView('parental-schedule')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/><path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
        Horario
      </button>
      <button class="nav-item admin-only" id="nav-parental-attempts" onclick="showView('parental-attempts')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5.99L19.53 19H4.47L12 5.99M12 2L1 21h22L12 2zm1 14h-2v2h2v-2zm0-6h-2v4h2v-4z"/></svg>
        Intentos bloqueados
      </button>
      <button class="nav-item admin-only" id="nav-parental-tunnel" onclick="showView('parental-tunnel')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        Túnel WireGuard
      </button>
    </div>

    <div class="sidenav-section">
      <span class="sidenav-section-label">Administración</span>
      <button class="nav-item admin-only" id="nav-users" onclick="showView('users')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        Usuarios
        <span class="nav-badge" id="nav-badge-users" style="display:none">0</span>
      </button>
      <button class="nav-item admin-only" id="nav-roles" onclick="showView('roles')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1.53 14.4l-3.87-3.87 1.41-1.41 2.46 2.46 5.66-5.66 1.41 1.41-7.07 7.07z"/></svg>
        Roles
      </button>
      <button class="nav-item admin-only" id="nav-settings" onclick="showView('settings')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
        Configuración
      </button>
      <button class="nav-item admin-only" id="nav-login-history" onclick="showView('login-history')" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14.5-3.5-3.5 1.41-1.41L11 12.67l4.09-4.09L16.5 10 11 15.5z" opacity="0"/><path d="M12 1a1 1 0 0 0-1 1v2H8a1 1 0 0 0 0 2h3v3a1 1 0 0 0 2 0V6h3a1 1 0 0 0 0-2h-3V2a1 1 0 0 0-1-1zM5 10c-1.66 0-3 1.34-3 3v7c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2v-7c0-1.66-1.34-3-3-3H5zm0 2h14c.55 0 1 .45 1 1v7H4v-7c0-.55.45-1 1-1zm2 2v2h2v-2H7zm4 0v2h6v-2h-6z"/></svg>
        Historial de accesos
      </button>
    </div>

    <div class="nav-spacer"></div>

    <div class="nav-bottom">
      <div class="nav-interval">
        <div class="nav-interval-label">Reporte cada</div>
        <select id="push-interval-select" class="form-input" style="padding:5px 10px;font-size:12px;cursor:pointer;flex:1" onchange="setPushInterval(this.value)">
          <option value="60" selected>1 min</option>
          <option value="180">3 min</option>
          <option value="300">5 min</option>
          <option value="420">7 min</option>
          <option value="600">10 min</option>
          <option value="900">15 min</option>
          <option value="1200">20 min</option>
          <option value="1500">25 min</option>
          <option value="1800">30 min</option>
        </select>
      </div>
      <div class="nav-profile">
        <div class="nav-avatar" id="nav-avatar">--</div>
        <div class="nav-profile-info">
          <div class="nav-profile-name" id="nav-username">--</div>
          <div class="nav-profile-role" id="nav-userrole">Usuario</div>
        </div>
        <button class="nav-logout-btn" onclick="doLogout()" title="Cerrar sesión">
          <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="main">

    <!-- ── DASHBOARD ── -->
    <div id="view-dashboard" class="view active">
      <!-- Summary -->
      <div class="summary-grid">
        <div class="summary-card filter-card" id="filter-card-all" onclick="setDashboardFilter('all')" title="Ver todos los equipos">
          <div class="s-icon blue"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6H4v14h16V6z" opacity=".3"/><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12z"/></svg></div>
          <div><div class="s-val" id="s-total">--</div><div class="s-label">Total equipos</div></div>
        </div>
        <div class="summary-card filter-card" id="filter-card-online" onclick="setDashboardFilter('online')" title="Ver solo equipos en línea">
          <div class="s-icon green"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
          <div><div class="s-val" id="s-online" style="color:var(--green)">--</div><div class="s-label">En línea</div></div>
        </div>
        <div class="summary-card filter-card" id="filter-card-offline" onclick="setDashboardFilter('offline')" title="Ver solo equipos sin conexión">
          <div class="s-icon red"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg></div>
          <div><div class="s-val" id="s-offline" style="color:var(--red)">--</div><div class="s-label">Sin conexión</div></div>
        </div>
        <div class="summary-card alert-trigger" id="alert-trigger" onclick="toggleAlertPanel()" title="Ver alertas activas">
          <div class="s-icon yellow alert-bell-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
            <span class="nav-badge danger" id="nav-alert-count" style="display:none">0</span>
          </div>
          <div><div class="s-val" id="s-alerts" style="color:var(--yellow)">--</div><div class="s-label">Alertas activas</div></div>
        </div>
      </div>
      <!-- Agents -->
      <div class="section-header">
        <div style="display:flex;align-items:center;gap:14px">
          <span class="section-title">Equipos</span>
          <label class="assigned-toggle" title="Si está activado, el Dashboard (tarjetas, alertas y notificaciones que TÚ ves) solo considera equipos asignados a un usuario. No afecta los correos/Telegram configurados en Configuración, esos se siguen enviando para todos los equipos.">
            Asignados
            <span class="switch">
              <input type="checkbox" id="dash-assigned-toggle" onchange="toggleAssignedOnlyFilter()">
              <span class="switch-slider"></span>
            </span>
          </label>
        </div>
        <div class="section-actions">
          <span class="last-update" id="last-update"></span>
          <input class="search-input" type="text" placeholder="Buscar equipo..." id="search-input" oninput="filterAgents()">
          <button class="btn btn-sm btn-ghost refresh-btn" onclick="manualRefresh()">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
            Actualizar
          </button>
        </div>
      </div>
      <div class="agents-grid" id="agents-grid"></div>
    </div>

    <!-- ── DETAIL (overlay dentro del dashboard) ── -->
    <div id="view-detail" class="view">
      <div class="page-header">
        <div style="display:flex;align-items:center;gap:16px">
          <button class="back-btn" onclick="showView('dashboard')">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Volver
          </button>
          <div>
            <div class="page-title" id="d-title">--</div>
            <div class="page-sub" id="d-sub">--</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <span class="badge" id="d-status-badge">--</span>
          <button class="btn btn-sm btn-ghost" onclick="openSoftware()">Software</button>
          <button class="btn btn-sm btn-ghost" onclick="openHistory()">Historial</button>
          <button class="btn btn-sm btn-ghost" onclick="openEditAgent()">Editar</button>
          <button class="btn btn-sm btn-ghost" onclick="openPauseModal()">⏸ Pausar bloqueo</button>
        </div>
      </div>

      <!-- Big metrics -->
      <div class="big-metrics-4">
        <div class="big-metric">
          <div class="big-metric-val" id="d-cpu">--%</div>
          <div class="big-metric-label">CPU</div>
        </div>
        <div class="big-metric">
          <div class="big-metric-val" id="d-ram">--%</div>
          <div class="big-metric-label">RAM</div>
          <div class="big-metric-sub" id="d-ram-sub">-- / -- GB</div>
        </div>
        <div class="big-metric">
          <div class="big-metric-val" id="d-temp">--°C</div>
          <div class="big-metric-label">Temperatura CPU</div>
        </div>
        <div class="big-metric">
          <div class="big-metric-val" id="d-latency">-- ms</div>
          <div class="big-metric-label">Latencia</div>
        </div>
      </div>

      <div class="detail-grid">
        <!-- Hardware info -->
        <div class="card">
          <div class="card-title">Información del equipo</div>
          <table class="info-table" id="d-hw-table">
            <tr><td>Fabricante</td><td id="d-manufacturer">--</td></tr>
            <tr><td>Modelo</td><td id="d-model">--</td></tr>
            <tr id="d-screen-size-row" style="display:none"><td>Tamaño de pantalla</td><td id="d-screen-size">--</td></tr>
            <tr><td>Número de serie</td><td id="d-serial">--</td></tr>
            <tr><td>Sistema operativo</td><td id="d-os">--</td></tr>
            <tr><td>Procesador</td><td id="d-cpu-model">--</td></tr>
            <tr><td>Núcleos CPU</td><td id="d-cpu-cores">--</td></tr>
            <tr><td>RAM Total</td><td id="d-ram-total">-- GB</td></tr>
            <tr><td>Almacenamiento</td><td id="d-disk-total" style="padding:6px 0">--</td></tr>
            <tr><td>Ranuras RAM</td><td id="d-ram-slots">-- / --</td></tr>
            <tr id="d-ram-slots-detail-row" style="display:none"><td colspan="2" id="d-ram-slots-detail" style="padding-top:6px"></td></tr>
            <tr><td>Área</td><td id="d-sede">--</td></tr>
            <tr><td>Notas</td><td id="d-notes" style="white-space:pre-wrap">--</td></tr>
          </table>
        </div>

        <!-- Historial gráfico -->
        <div class="card">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <div class="card-title" style="margin-bottom:0">Historial</div>
            <div style="display:flex;gap:4px">
              <button class="btn btn-sm btn-ghost range-btn active" onclick="setChartRange('1h',this)">1h</button>
              <button class="btn btn-sm btn-ghost range-btn" onclick="setChartRange('6h',this)">6h</button>
              <button class="btn btn-sm btn-ghost range-btn" onclick="setChartRange('12h',this)">12h</button>
              <button class="btn btn-sm btn-ghost range-btn" onclick="setChartRange('24h',this)">24h</button>
            </div>
          </div>
          <div style="position:relative;height:180px"><canvas id="detail-chart"></canvas></div>
          <div class="chart-legend" style="margin-top:10px">
            <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div>CPU %</div>
            <div class="legend-item"><div class="legend-dot" style="background:#10b981"></div>RAM %</div>
            <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div>Disco %</div>
            <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div>Temp °C</div>
          </div>
          <div style="margin-top:14px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
            <div class="big-metric">
              <div class="big-metric-val" id="d-rx" style="font-size:16px;color:var(--accent)">-- MB</div>
              <div class="big-metric-label">↓ Recibido</div>
            </div>
            <div class="big-metric">
              <div class="big-metric-val" id="d-tx" style="font-size:16px;color:var(--green)">-- MB</div>
              <div class="big-metric-label">↑ Enviado</div>
            </div>
            <div class="big-metric">
              <div class="big-metric-val" id="d-uptime" style="font-size:16px;color:var(--purple)">--%</div>
              <div class="big-metric-label">Uptime 7d</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Procesos (ancho completo) -->
      <div class="card" style="margin-bottom:16px">
        <div class="card-title-row">
          <span class="card-title-inline">Procesos activos</span>
          <select id="proc-limit-select" class="form-input" style="width:auto;padding:3px 10px;font-size:11px;cursor:pointer" onchange="setProcLimit(this.value)">
            <option value="10" selected>10 proc</option>
            <option value="15">15 proc</option>
            <option value="20">20 proc</option>
            <option value="25">25 proc</option>
            <option value="30">30 proc</option>
            <option value="50">50 proc</option>
            <option value="75">75 proc</option>
            <option value="100">100 proc</option>
          </select>
        </div>
        <table class="process-table" style="width:100%">
          <thead><tr>
            <th style="min-width:160px">Proceso</th>
            <th>CPU</th>
            <th>RAM</th>
            <th style="width:72px;text-align:right">CPU %</th>
            <th style="width:72px;text-align:right">RAM %</th>
          </tr></thead>
          <tbody id="d-processes"></tbody>
        </table>
      </div>

    </div>

    <!-- ── INVENTARIO ── -->
    <div id="view-inventory" class="view">
      <div class="page-header">
        <div><div class="page-title">Inventario de equipos</div><div class="page-sub">Hardware de todos los equipos</div></div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-sm btn-ghost" onclick="openDeviceTypesModal()">⚙️ Configurar tipos y categorías</button>
          <button class="btn btn-sm btn-primary" onclick="exportCSV()">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" style="margin-right:4px"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
            Exportar CSV
          </button>
        </div>
      </div>

      <!-- Filtros: buscador + Área/Tipo/Estado/Usuario + Limpiar, todo en una sola fila -->
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <div style="flex:1.3;min-width:180px">
            <div style="position:relative">
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-dim)"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
              <input class="form-input" id="inv-filter-search" type="text" placeholder="Buscar equipo..." style="font-size:13px;padding-left:34px" oninput="applyInventoryFilter()">
            </div>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Área</label>
            <select class="form-input" id="inv-filter-sede" style="font-size:13px" onchange="applyInventoryFilter()">
              <option value="">Todas las áreas</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Tipo</label>
            <select class="form-input" id="inv-filter-type" style="font-size:13px" onchange="applyInventoryFilter()">
              <option value="">Todos</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Estado</label>
            <select class="form-input" id="inv-filter-status" style="font-size:13px" onchange="applyInventoryFilter()">
              <option value="">Todos</option>
              <option value="online">Online</option>
              <option value="offline">Offline</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Usuario</label>
            <select class="form-input" id="inv-filter-user" style="font-size:13px" onchange="onInventoryUserFilterChange()">
              <option value="">Todos</option>
            </select>
          </div>
          <div>
            <button class="btn btn-ghost btn-sm" style="height:38px;white-space:nowrap" onclick="clearInventoryFilter()">
              <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" style="margin-right:4px"><path d="M19.79 5.61C20.3 4.95 19.83 4 19 4H3.01c-.83 0-1.3.95-.79 1.61L9 14v6c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-6l6.79-8.39z"/></svg>
              Limpiar filtros
            </button>
          </div>
        </div>
        <button class="btn btn-ghost btn-sm" id="inv-filter-user-history" style="display:none;margin-top:10px" onclick="toggleUserFilterShowAll()"></button>
      </div>

      <!-- Tarjetas de resumen: ocupan todo el ancho, en partes iguales -->
      <div class="summary-grid">
        <div class="summary-card">
          <div class="s-icon purple"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6H4v14h16V6z" opacity=".3"/><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12z"/></svg></div>
          <div><div class="s-val" id="inv-s-total">--</div><div class="s-label">Equipos totales</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon green"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
          <div><div class="s-val" id="inv-s-online" style="color:var(--green)">--</div><div class="s-label">Online</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon yellow"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg></div>
          <div><div class="s-val" id="inv-s-offline" style="color:var(--yellow)">--</div><div class="s-label">Offline</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon blue"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg></div>
          <div><div class="s-val" id="inv-s-maint" style="color:var(--accent)">--</div><div class="s-label">Mantenimiento</div></div>
        </div>
      </div>
      <div class="card" id="inv-table-wrap" style="overflow-x:auto">
        <table class="data-table" id="inventory-table" style="table-layout:fixed">
        <thead><tr>
            <th style="width:17%">Equipo</th>
            <th style="width:14%">Usuario</th>
            <th style="width:9%">Estado</th>
            <th style="width:11%">Sistema operativo</th>
            <th style="width:15%">Especificaciones</th>
            <th style="width:18%">Rendimiento</th>
            <th style="width:9%">Área</th>
            <th style="width:6%">Tipo</th>
            <th class="inv-col-actions" style="width:64px">Acciones</th>
          </tr></thead>
          <tbody id="inventory-body"></tbody>
        </table>
        <datalist id="dtypes"></datalist>
        <div class="sw-pagination" id="inv-pagination" style="padding:0 18px 16px"></div>
      </div>

    </div>

    <!-- ── EVENTOS ── -->
    <div id="view-events" class="view">
      <div class="page-header">
        <div><div class="page-title">Historial de Eventos</div><div class="page-sub">Alertas y cambios de estado</div></div>
        <div style="display:flex;gap:8px;align-items:center">
          <button class="btn btn-sm btn-ghost" onclick="fetchGlobalEvents()">Actualizar</button>
          <div class="export-dropdown">
            <button class="btn btn-sm btn-ghost" onclick="toggleExportMenu()" id="ev-export-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" style="margin-right:4px"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
              Exportar
            </button>
            <div class="export-menu" id="ev-export-menu">
              <div class="export-menu-item" onclick="exportEventsCSV('general')">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                Reporte general (todos)
              </div>
              <div class="export-menu-item" onclick="exportEventsCSV('equipo')">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M20 6H4v14h16V6z" opacity=".3"/><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12z"/></svg>
                Por equipo (filtro actual)
              </div>
              <div class="export-menu-item" onclick="exportEventsCSV('area')">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                Por área (filtro actual)
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Filtros -->
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto auto auto auto;gap:10px;align-items:flex-end">
          <div>
            <label class="form-label" style="margin-bottom:4px">Equipo</label>
            <select class="form-input" id="ev-filter-agent" style="font-size:13px" onchange="fetchGlobalEvents()">
              <option value="">Todos los equipos</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Área</label>
            <select class="form-input" id="ev-filter-sede" style="font-size:13px" onchange="fetchGlobalEvents()">
              <option value="">Todas las áreas</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Tipo de evento</label>
            <select class="form-input" id="ev-filter-type" style="font-size:13px" onchange="fetchGlobalEvents()">
              <option value="">Todos</option>
              <option value="offline">Alerta de desconexión</option>
              <option value="online">Alerta de reconexión</option>
              <option value="cpu_high">Alerta de CPU</option>
              <option value="ram_high">Alerta de RAM</option>
              <option value="disk_high">Alerta de disco</option>
              <option value="temp_high">Alerta de temperatura</option>
              <option value="exception_created">Excepción creada</option>
              <option value="asset_created">Activo creado</option>
              <option value="asset_status_changed">Cambio de estado (activo)</option>
              <option value="asset_assigned">Activo asignado</option>
              <option value="asset_returned">Activo devuelto</option>
              <option value="asset_stock_added">Stock agregado</option>
              <option value="asset_linked">Vínculo actualizado</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Desde</label>
            <div style="position:relative">
              <input class="form-input" id="ev-filter-from" type="date" style="font-size:13px;padding-right:36px;cursor:pointer" onclick="this.showPicker&&this.showPicker()" onchange="fetchGlobalEvents()">
              <span onclick="document.getElementById('ev-filter-from').showPicker&&document.getElementById('ev-filter-from').showPicker()" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);cursor:pointer;color:var(--text-dim);pointer-events:all">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
              </span>
            </div>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Hasta</label>
            <div style="position:relative">
              <input class="form-input" id="ev-filter-to" type="date" style="font-size:13px;padding-right:36px;cursor:pointer" onclick="this.showPicker&&this.showPicker()" onchange="fetchGlobalEvents()">
              <span onclick="document.getElementById('ev-filter-to').showPicker&&document.getElementById('ev-filter-to').showPicker()" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);cursor:pointer;color:var(--text-dim);pointer-events:all">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
              </span>
            </div>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Mostrar</label>
            <select class="form-input" id="ev-filter-limit" style="font-size:13px" onchange="fetchGlobalEvents()">
              <option value="100">100</option>
              <option value="250">250</option>
              <option value="500" selected>500</option>
              <option value="1000">1000</option>
              <option value="2000">2000</option>
            </select>
          </div>
          <div style="display:flex;gap:6px;align-items:flex-end">
            <button class="btn btn-ghost btn-sm" style="height:38px" onclick="clearEventsFilter()">Limpiar</button>
          </div>
        </div>
        <div id="ev-results-info" style="font-size:12px;color:var(--text-dim);margin-top:8px"></div>
      </div>
      <div class="card" style="overflow:auto;max-height:calc(100vh - 320px);height:fit-content">
        <table class="data-table" id="events-table">
          <thead><tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Equipo</th>
            <th>Área</th>
            <th>Tipo</th>
            <th>Motivo</th>
            <th>Detalle</th>
          </tr></thead>
          <tbody id="global-events"></tbody>
        </table>
      </div>
    </div>

    <!-- ── USUARIOS (admin) ── -->
    <div id="view-users" class="view">
      <div class="page-header">
        <div><div class="page-title">Usuarios</div><div class="page-sub">Gestión de acceso al sistema</div></div>
        <button class="btn btn-primary btn-sm" onclick="openNewUser()">+ Nuevo usuario</button>
      </div>
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr auto;gap:10px;align-items:flex-end">
          <div>
            <label class="form-label" style="margin-bottom:4px">Buscar</label>
            <input class="form-input" id="usr-filter-search" type="text" placeholder="Nombre o email" style="font-size:13px" oninput="applyUsersFilter()">
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Rol</label>
            <select class="form-input" id="usr-filter-role" style="font-size:13px" onchange="applyUsersFilter()">
              <option value="">Todos</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Estado</label>
            <select class="form-input" id="usr-filter-status" style="font-size:13px" onchange="applyUsersFilter()">
              <option value="">Todos</option>
              <option value="activo">Activo</option>
              <option value="desactivado">Desactivado</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Acceso</label>
            <select class="form-input" id="usr-filter-access" style="font-size:13px" onchange="applyUsersFilter()">
              <option value="">Todos</option>
              <option value="con">Con acceso</option>
              <option value="sin">Sin acceso</option>
            </select>
          </div>
          <div>
            <button class="btn btn-ghost btn-sm" style="height:38px" onclick="clearUsersFilter()">Limpiar</button>
          </div>
        </div>
        <div id="usr-results-info" style="font-size:12px;color:var(--text-dim);margin-top:8px"></div>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
          <tbody id="users-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── HISTORIAL DE ACCESOS (admin) ── -->
    <div id="view-login-history" class="view">
      <div class="page-header">
        <div><div class="page-title">Historial de accesos</div><div class="page-sub">Inicios de sesión exitosos e intentos fallidos</div></div>
        <button class="btn btn-sm btn-ghost" onclick="fetchLoginHistory()">Actualizar</button>
      </div>
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:grid;grid-template-columns:1fr auto 1fr 1fr auto auto;gap:10px;align-items:flex-end">
          <div>
            <label class="form-label" style="margin-bottom:4px">Email</label>
            <input class="form-input" id="lh-filter-email" type="text" placeholder="Buscar por email" style="font-size:13px" oninput="fetchLoginHistory()">
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Resultado</label>
            <select class="form-input" id="lh-filter-success" style="font-size:13px" onchange="fetchLoginHistory()">
              <option value="">Todos</option>
              <option value="true">Éxito</option>
              <option value="false">Fallido</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Desde</label>
            <input class="form-input" id="lh-filter-from" type="date" style="font-size:13px;cursor:pointer" onclick="this.showPicker&&this.showPicker()" onchange="fetchLoginHistory()">
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Hasta</label>
            <input class="form-input" id="lh-filter-to" type="date" style="font-size:13px;cursor:pointer" onclick="this.showPicker&&this.showPicker()" onchange="fetchLoginHistory()">
          </div>
          <div>
            <label class="form-label" style="margin-bottom:4px">Mostrar</label>
            <select class="form-input" id="lh-filter-limit" style="font-size:13px" onchange="fetchLoginHistory()">
              <option value="100">100</option>
              <option value="200" selected>200</option>
              <option value="500">500</option>
              <option value="1000">1000</option>
            </select>
          </div>
          <div style="display:flex;gap:6px;align-items:flex-end">
            <button class="btn btn-ghost btn-sm" style="height:38px" onclick="clearLoginHistoryFilter()">Limpiar</button>
          </div>
        </div>
        <div id="lh-results-info" style="font-size:12px;color:var(--text-dim);margin-top:8px"></div>
      </div>
      <div class="card" style="overflow:auto;max-height:calc(100vh - 320px);height:fit-content">
        <table class="data-table" id="login-history-table">
          <thead><tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Email</th>
            <th>Usuario</th>
            <th>Resultado</th>
            <th>Motivo</th>
            <th>IP</th>
          </tr></thead>
          <tbody id="login-history-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── ROLES (admin) ── -->
    <div id="view-roles" class="view">
      <div class="page-header">
        <div><div class="page-title">Roles</div><div class="page-sub">Define qué puede ver y hacer cada rol, y a qué secciones tiene acceso</div></div>
        <button class="btn btn-primary btn-sm" onclick="openNewRole()">+ Nuevo rol</button>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Nombre</th><th>Usuarios</th><th>Acciones</th></tr></thead>
          <tbody id="roles-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── AREAS (admin) ── -->
    <div id="view-areas" class="view">
      <div class="page-header">
        <div><div class="page-title">Áreas</div><div class="page-sub">Ubicaciones y agrupación de equipos</div></div>
        <button class="btn btn-primary btn-sm" onclick="openModal('modal-area')">+ Nueva área</button>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Nombre</th><th>Ubicación</th><th>Equipos</th><th>Acciones</th></tr></thead>
          <tbody id="areas-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── CONTROL PARENTAL / Categorías (admin) ── -->
    <div id="view-parental-categories" class="view">
      <div class="page-header">
        <div><div class="page-title">Control parental — Categorías</div><div class="page-sub">Grupos de dominios listos para bloquear con un clic</div></div>
        <button class="btn btn-primary btn-sm" onclick="openCustomCategory()">+ Crear categoría personalizada</button>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Categoría</th><th>Sitios</th><th>Aplicada en</th><th>Acciones</th></tr></thead>
          <tbody id="parental-categories-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── CONTROL PARENTAL / Bloqueo de sitios (admin) ── -->
    <div id="view-parental-blocked" class="view">
      <div class="page-header">
        <div><div class="page-title">Control parental — Bloqueo de sitios</div><div class="page-sub">Todos los sitios bloqueados: por categoría o individuales</div></div>
        <div style="display:flex;gap:8px;align-items:center">
          <button class="btn btn-ghost btn-sm" onclick="openReportFilters()">Reporte Excel</button>
          <button class="btn btn-primary btn-sm" onclick="openNewBlockedSite()">+ Bloquear sitio</button>
          <button class="btn btn-ghost" id="network-gate-toggle-btn" onclick="openNetworkGateModal()" title="Configurar restricción por red WiFi" style="width:38px;height:38px;padding:0;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:0">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
          </button>
        </div>
      </div>
      <!-- Tarjetas de resumen: ocupan todo el ancho, en partes iguales -->
      <div class="summary-grid">
        <div class="summary-card">
          <div class="s-icon purple"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.9 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/></svg></div>
          <div><div class="s-val" id="pb-s-total">--</div><div class="s-label">Sitios bloqueados</div><div class="s-label" style="margin-top:-2px">Total en la lista</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon green"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1.06 14.94L7 12l1.41-1.41 2.53 2.53 5.66-5.66L18 9l-7.06 6.94z"/></svg></div>
          <div><div class="s-val" id="pb-s-active" style="color:var(--green)">--</div><div class="s-label">Activos</div><div class="s-label" style="margin-top:-2px">En funcionamiento</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon yellow"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg></div>
          <div><div class="s-val" id="pb-s-scheduled" style="color:var(--yellow)">--</div><div class="s-label">Programados</div><div class="s-label" style="margin-top:-2px">Por activar</div></div>
        </div>
        <div class="summary-card">
          <div class="s-icon red"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg></div>
          <div><div class="s-val" id="pb-s-inactive" style="color:var(--red)">--</div><div class="s-label">Inactivos</div><div class="s-label" style="margin-top:-2px">Desactivados</div></div>
        </div>
      </div>

      <!-- Filtros: buscador + Tipo/Categoría/Alcance/Estado + Limpiar, en una fila -->
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <div style="flex:1.3;min-width:180px">
            <div style="position:relative">
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-dim)"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
              <input class="form-input" id="pb-filter-search" type="text" placeholder="Buscar dominio o motivo..." style="font-size:13px;padding-left:34px" oninput="applyBlockedSitesFilter()">
            </div>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Tipo</label>
            <select class="form-input" id="pb-filter-tipo" style="font-size:13px" onchange="applyBlockedSitesFilter()">
              <option value="">Todos</option>
              <option value="bloqueo">Bloqueo</option>
              <option value="excepcion">Excepción</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Categoría</label>
            <select class="form-input" id="pb-filter-categoria" style="font-size:13px" onchange="applyBlockedSitesFilter()">
              <option value="">Todas</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Alcance</label>
            <select class="form-input" id="pb-filter-alcance" style="font-size:13px" onchange="applyBlockedSitesFilter()">
              <option value="">Todos</option>
              <option value="equipo">Equipo</option>
              <option value="area">Área</option>
              <option value="global">Global</option>
            </select>
          </div>
          <div style="flex:1;min-width:130px">
            <label class="form-label" style="margin-bottom:4px">Estado</label>
            <select class="form-input" id="pb-filter-estado" style="font-size:13px" onchange="applyBlockedSitesFilter()">
              <option value="">Todos</option>
              <option value="activo">Activo</option>
              <option value="inactivo">Inactivo</option>
            </select>
          </div>
          <div>
            <button class="btn btn-ghost btn-sm" style="height:38px;white-space:nowrap" onclick="clearBlockedSitesFilter()">
              <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" style="margin-right:4px"><path d="M19.79 5.61C20.3 4.95 19.83 4 19 4H3.01c-.83 0-1.3.95-.79 1.61L9 14v6c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-6l6.79-8.39z"/></svg>
              Limpiar filtros
            </button>
          </div>
        </div>
      </div>
      <div class="card" id="pb-table-wrap" style="overflow-x:auto">
        <table class="data-table" id="pb-table" style="table-layout:fixed">
          <thead><tr>
            <th style="width:16%">Dominio</th>
            <th style="width:10%">Tipo</th>
            <th style="width:14%">Categoría</th>
            <th style="width:16%">Alcance</th>
            <th style="width:20%">Motivo</th>
            <th style="width:10%">Estado</th>
            <th class="inv-col-actions" style="width:auto">Acciones</th>
          </tr></thead>
          <tbody id="parental-body"></tbody>
        </table>
        <div class="sw-pagination" id="pb-pagination" style="padding:0 18px 16px"></div>
      </div>
    </div>

    <!-- ── CONTROL PARENTAL / Horario (admin) ── -->
    <div id="view-parental-schedule" class="view">
      <div class="page-header">
        <div><div class="page-title">Control parental — Horario</div><div class="page-sub">El bloqueo solo aplica en el horario configurado (ej. horario de oficina)</div></div>
      </div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-title">Horario por defecto</div>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
          <div>
            <span class="badge" id="default-schedule-status-badge">--</span>
            <span style="font-size:13px;color:var(--text-mid);margin-left:8px" id="default-schedule-summary">Cargando…</span>
          </div>
          <button class="btn btn-primary btn-sm" style="width:auto" onclick="editDefaultSchedule()">Personalizar</button>
        </div>
      </div>

      <div class="page-header">
        <div><div class="card-title" style="margin-bottom:0">Horario por área</div><div class="page-sub">Por defecto cada área usa el horario global; personalízalo si esa área tiene un horario distinto</div></div>
      </div>
      <div class="card" style="margin-bottom:16px">
        <table class="data-table">
          <thead><tr><th>Área</th><th>Tipo</th><th>Horario</th><th>Acciones</th></tr></thead>
          <tbody id="area-schedules-body"></tbody>
        </table>
      </div>

      <div class="page-header">
        <div><div class="card-title" style="margin-bottom:0">Excepciones por equipo</div><div class="page-sub">Para casos puntuales de un equipo específico (anula el horario de su área y el global)</div></div>
        <button class="btn btn-primary btn-sm" onclick="openNewScheduleOverride()">+ Agregar excepción</button>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Equipo</th><th>Horario</th><th>Expira</th><th>Acciones</th></tr></thead>
          <tbody id="schedule-overrides-body"></tbody>
        </table>
      </div>
    </div>


    <div id="view-parental-attempts" class="view">
      <div class="page-header">
        <div><div class="page-title">Control parental — Intentos bloqueados</div><div class="page-sub">Resumen por día de los sitios bloqueados que cada equipo intentó visitar</div></div>
      </div>

      <div class="card" style="margin-bottom:16px">
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
          <div class="form-group" style="margin-bottom:0;min-width:180px">
            <label class="form-label">Área</label>
            <select class="form-input" id="attempts-sede-filter" onchange="fetchBlockAttempts()"><option value="">Todas</option></select>
          </div>
          <div class="form-group" style="margin-bottom:0;min-width:180px">
            <label class="form-label">Equipo</label>
            <select class="form-input" id="attempts-agent-filter" onchange="fetchBlockAttempts()"><option value="">Todos</option></select>
          </div>
          <div class="form-group" style="margin-bottom:0;min-width:160px">
            <label class="form-label">Rango</label>
            <select class="form-input" id="attempts-days-filter" onchange="fetchBlockAttempts()">
              <option value="1">Hoy</option>
              <option value="7" selected>Últimos 7 días</option>
              <option value="30">Últimos 30 días</option>
              <option value="90">Últimos 90 días</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom:0;min-width:160px">
            <label class="form-label">Estado</label>
            <select class="form-input" id="attempts-status-filter" onchange="fetchBlockAttempts()">
              <option value="">Todos</option>
              <option value="blocked">Bloqueados</option>
              <option value="allowed">Exitosos</option>
            </select>
          </div>
          <button class="btn btn-ghost" title="Configurar borrado automático del historial" onclick="openAttemptsRetentionModal()" style="width:38px;height:38px;padding:0;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-left:auto;margin-top:0">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/></svg>
          </button>
        </div>
        <div id="attempts-results-info" style="font-size:12px;color:var(--text-dim);margin-top:8px"></div>
      </div>

      <div class="card">
        <table class="data-table">
          <thead><tr><th>Fecha</th><th>Equipo</th><th>IP túnel</th><th>Área</th><th>Dominio</th><th>Estado</th><th style="text-align:right">Intentos</th><th>Última vez</th></tr></thead>
          <tbody id="attempts-body"></tbody>
        </table>
      </div>
    </div>

    <div id="view-parental-tunnel" class="view">
      <div class="page-header">
        <div><div class="page-title">Control parental — Túnel WireGuard</div><div class="page-sub">Equipos conectados al túnel (Headscale): las excepciones individuales solo son 100% confiables para los que aparecen aquí</div></div>
      </div>
      <div class="card" style="margin-bottom:16px;padding:14px 18px">
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <div style="width:220px">
            <label class="form-label" style="margin-bottom:4px">Buscar</label>
            <input class="form-input" id="tun-filter-search" type="text" placeholder="Equipo o serie" style="font-size:13px" oninput="applyTunnelFilter()">
          </div>
          <div style="width:220px">
            <label class="form-label" style="margin-bottom:4px">Estado</label>
            <select class="form-input" id="tun-filter-status" style="font-size:13px" onchange="applyTunnelFilter()">
              <option value="">Todos</option>
              <option value="conectado">Conectado</option>
              <option value="desconectado">Desconectado (equipo sin reportar)</option>
              <option value="no_conectado">No conectado</option>
            </select>
          </div>
          <div>
            <button class="btn btn-ghost btn-sm" style="height:38px" onclick="clearTunnelFilter()">Limpiar</button>
          </div>
        </div>
        <div id="tun-results-info" style="font-size:12px;color:var(--text-dim);margin-top:8px"></div>
      </div>
      <div class="card">
        <table class="data-table">
          <thead><tr><th>Equipo</th><th>Serie</th><th>IP del túnel</th><th>Estado</th></tr></thead>
          <tbody id="tunnel-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ── DESCUBRIMIENTO ── -->
    <div id="view-discovery" class="view">
      <div class="page-header">
        <div><div class="page-title">Descubrimiento de red</div><div class="page-sub">Escanear hosts activos en la red local</div></div>
      </div>
      <div class="card" style="margin-bottom:16px">
        <label class="form-label">Rango de red</label>
        <div style="display:flex;gap:10px;align-items:center;margin-top:6px">
          <input class="form-input" id="discovery-subnet" style="flex:1;min-width:0" placeholder="192.168.1.0/24  o  192.168.1.1-192.168.1.254">
          <button class="btn btn-primary" onclick="runDiscovery()" id="discovery-btn" style="width:auto;white-space:nowrap;margin-top:0;flex-shrink:0;padding:10px 24px">Escanear</button>
        </div>
        <div style="font-size:11px;color:var(--text-dim);margin-top:8px">Máximo 254 hosts. Puede tardar hasta 30 segundos.</div>
      </div>

      <!-- Estado: escaneando -->
      <div id="discovery-scanning" style="display:none">
        <div class="card" style="text-align:center;padding:40px 20px">
          <div style="display:flex;justify-content:center;margin-bottom:16px">
            <div style="width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.8s linear infinite"></div>
          </div>
          <div style="font-size:14px;color:var(--text);font-weight:500;margin-bottom:4px">Escaneando red...</div>
          <div style="font-size:12px;color:var(--text-dim)" id="discovery-scanning-label">Enviando ping a los hosts</div>
        </div>
      </div>

      <!-- Estado: sin resultados -->
      <div id="discovery-empty" style="display:none">
        <div class="card" style="text-align:center;padding:40px 20px">
          <div style="font-size:32px;margin-bottom:12px">🔍</div>
          <div style="font-size:14px;color:var(--text);font-weight:500;margin-bottom:4px">No se encontró ningún equipo</div>
          <div style="font-size:12px;color:var(--text-dim)">Verifica el rango de red o que los equipos respondan a ping</div>
        </div>
      </div>

      <!-- Estado: resultados -->
      <div id="discovery-results" style="display:none">
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div class="card-title" style="margin-bottom:0" id="discovery-count">0 hosts encontrados</div>
          </div>
          <table class="data-table">
            <thead><tr><th>IP</th><th>Equipo</th><th>OS</th><th style="text-align:right">CPU</th><th style="text-align:right">RAM</th><th style="text-align:right">Disco</th><th style="text-align:right">Ping</th><th>Estado</th></tr></thead>
            <tbody id="discovery-body"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── CONFIGURACIÓN ── -->
    <div id="view-settings" class="view">
      <div class="page-header">
        <div><div class="page-title">Configuración</div><div class="page-sub">Notificaciones y umbrales globales</div></div>
        <div style="display:flex;gap:10px">
          <button class="btn btn-primary btn-sm" style="width:auto" onclick="openNotificationsModal()">⚙️ Notificaciones</button>
          <button class="btn btn-ghost btn-sm" style="width:auto" onclick="openPasswordPolicyModal()">🔐 Política</button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <!-- Umbrales globales -->
        <div class="card">
          <div class="card-title">Umbrales de alerta globales</div>
          <div class="form-group">
            <label class="form-label">CPU % (alerta si supera)</label>
            <input class="form-input" id="thr-cpu" type="number" min="1" max="100">
          </div>
          <div class="form-group">
            <label class="form-label">RAM % (alerta si supera)</label>
            <input class="form-input" id="thr-ram" type="number" min="1" max="100">
          </div>
          <div class="form-group">
            <label class="form-label">Disco % (alerta si supera)</label>
            <input class="form-input" id="thr-disk" type="number" min="1" max="100">
          </div>
          <div class="form-group">
          <label class="form-label">Temperatura °C (alerta si supera)</label>
          <input class="form-input" id="thr-temp" type="number" min="1" max="200">
          </div>
          <button class="btn btn-primary btn-sm" onclick="saveGlobalThresholds()">Guardar umbrales</button>
          <div id="thr-status" style="font-size:12px;margin-top:8px;display:none"></div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── MODALES ────────────────────────────────────────────────────────────── -->
<!-- Modal usuario (crear / editar info básica) -->
<div class="modal-overlay" id="modal-user">
  <div class="modal">
    <div class="modal-title" id="modal-user-title">Nuevo Usuario</div>
    <input type="hidden" id="user-id">
    <div class="form-group"><label class="form-label">Nombre</label><input class="form-input" id="user-name" type="text"></div>
    <div class="form-group"><label class="form-label">Email</label><input class="form-input" id="user-email" type="email"></div>
    <div class="form-group"><label class="form-label">Rol</label>
      <select class="form-input" id="user-role-id"></select>
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer">
        <input type="checkbox" id="user-has-access" style="width:15px;height:15px" checked>
        Acceso a la consola
      </label>
      <div style="font-size:11px;color:var(--text-dim);margin-top:4px">
        Desactívalo para personas que solo necesitas tener registradas para asignarles equipos (ej. empleados sin rol de TI) — nunca podrán iniciar sesión en el panel, tengan la contraseña que tengan.
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-user')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveUser()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal resultado: contraseña temporal generada -->
<div class="modal-overlay" id="modal-temp-pass">
  <div class="modal" style="max-width:420px">
    <div class="modal-title">Contraseña temporal generada</div>
    <p style="font-size:13px;color:var(--text-mid);margin-bottom:16px">Comparte esta contraseña con el usuario. Se le pedirá cambiarla al iniciar sesión.</p>
    <div style="background:var(--surface);border-radius:14px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:var(--clay-in-sm)">
      <span id="temp-pass-value" style="font-family:var(--mono);font-size:18px;font-weight:700;color:var(--accent);letter-spacing:2px"></span>
      <button class="btn btn-sm btn-ghost" onclick="copyTempPass()">Copiar</button>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="closeModal('modal-temp-pass')">Entendido</button>
    </div>
  </div>
</div>

<!-- Modal: pausar/reanudar el bloqueo de sitios de este equipo (directo, o generando
     un codigo de un solo uso para que el usuario lo pause el mismo desde el tray) -->
<div class="modal-overlay" id="modal-pause-agent">
  <div class="modal" style="max-width:520px">
    <div style="display:flex;gap:14px;align-items:flex-start;margin-bottom:16px">
      <div class="s-icon blue" style="width:52px;height:52px;border-radius:16px"><svg viewBox="0 0 24 24" fill="currentColor" style="width:26px;height:26px"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14h-1.5v-4H11v4zm3.5 0H13v-4h1.5v4z"/></svg></div>
      <div style="flex:1">
        <div class="modal-title" style="margin-bottom:2px">Pausar bloqueo de sitios</div>
        <p style="font-size:13px;color:var(--text-mid)">Solo pausa el filtrado de contenido de este equipo — el monitoreo (CPU, RAM, software) sigue normal.</p>
      </div>
    </div>
    <p id="pause-current-status" style="font-size:13px;font-weight:600;color:var(--accent);display:none;margin-bottom:10px"></p>
    <button class="btn btn-primary" id="pause-resume-top-btn" style="display:none;margin-bottom:16px;width:100%" onclick="resumeAgentNow()">⏵ Reanudar bloqueo</button>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
      <div class="pause-option-card" onclick="pauseAgentMinutes(5)">
        <div class="s-icon blue"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg></div>
        <div>
          <div class="pause-option-title">Pausar 5 minutos</div>
          <div class="pause-option-sub">Reanuda automáticamente al finalizar.</div>
        </div>
        <svg class="chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </div>
      <div class="pause-option-card" onclick="pauseAgentToday()">
        <div class="s-icon purple"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg></div>
        <div>
          <div class="pause-option-title">Pausar todo el día</div>
          <div class="pause-option-sub" id="pause-today-sub">Hasta las 00:00 de esta noche.</div>
        </div>
        <svg class="chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </div>
    </div>

    <div class="card" style="padding:14px 16px;margin-bottom:12px;box-shadow:var(--clay-sm)">
      <div class="form-label" style="margin-bottom:8px">Pausar hasta una fecha y hora</div>
      <input type="datetime-local" id="pause-until-input" class="form-input" style="width:100%"
             onclick="this.showPicker && this.showPicker()" oninput="pauseAgentUntilDate()">
    </div>

    <div class="pause-option-card" style="margin-bottom:14px" onclick="deactivateAgentBlocking()">
      <div class="s-icon blue"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg></div>
      <div>
        <div class="pause-option-title">Desactivar bloqueo (hasta que lo reactives)</div>
        <div class="pause-option-sub">El filtrado de sitios se mantendrá desactivado hasta que lo reactives manualmente.</div>
      </div>
      <svg class="chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
    </div>

    <div class="card" style="padding:16px;box-shadow:var(--clay-sm)">
      <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:12px">
        <div class="s-icon green"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg></div>
        <div>
          <div style="font-size:13px;font-weight:700">O dejá que el usuario se pause él mismo</div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:2px">Compartí este código con el usuario — lo canjea desde el ícono de SmartMonitor en su bandeja.</div>
        </div>
      </div>

      <button class="btn btn-ghost" id="pause-code-generate-btn" style="width:100%" onclick="generatePauseCode()">🔑 Generar código</button>

      <div id="pause-code-active" style="display:none">
        <div style="background:var(--surface2);border-radius:14px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:var(--clay-in-sm)">
          <div style="display:flex;align-items:center;gap:10px">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;color:var(--text-dim);flex-shrink:0"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <span id="pause-code-value" style="font-family:var(--mono);font-size:20px;font-weight:700;color:var(--accent);letter-spacing:2px"></span>
          </div>
          <button class="btn btn-sm btn-ghost" style="display:flex;align-items:center;gap:5px" onclick="copyPauseCode()">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:14px;height:14px"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
            Copiar
          </button>
        </div>
        <p style="font-size:12px;color:var(--text-dim);margin-top:10px;display:flex;align-items:center;gap:6px">
          <svg viewBox="0 0 24 24" fill="currentColor" style="width:14px;height:14px;flex-shrink:0"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
          Válido por <span id="pause-code-countdown" style="color:var(--green);font-weight:700"></span> o hasta el primer uso.
        </p>
      </div>

      <div id="pause-code-expired" style="display:none">
        <p style="font-size:13px;color:var(--red);margin-bottom:8px">El código anterior expiró.</p>
        <button class="btn btn-ghost" style="width:100%" onclick="generatePauseCode()">Generar uno nuevo</button>
      </div>
    </div>

    <div class="card" style="padding:16px;margin-top:14px;box-shadow:var(--clay-sm);border:1px solid rgba(239,68,68,.25)">
      <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:12px">
        <div class="s-icon red"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2V9h2v3z"/></svg></div>
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--red)">Desinstalación</div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:2px">Requiere un código de un solo uso — permite desinstalar SmartMonitor de este equipo una única vez.</div>
        </div>
      </div>

      <button class="btn btn-ghost" id="uninstall-code-generate-btn" style="width:100%" onclick="generateUninstallCode()">🔑 Generar código de desinstalación</button>

      <div id="uninstall-code-active" style="display:none">
        <div style="background:var(--surface2);border-radius:14px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:var(--clay-in-sm)">
          <span id="uninstall-code-value" style="font-family:var(--mono);font-size:20px;font-weight:700;color:var(--red);letter-spacing:2px"></span>
          <button class="btn btn-sm btn-ghost" onclick="copyUninstallCode()">Copiar</button>
        </div>
        <p style="font-size:12px;color:var(--text-dim);margin-top:10px" id="uninstall-code-expiry"></p>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn btn-primary" style="display:flex;align-items:center;justify-content:center;gap:8px" onclick="closeModal('modal-pause-agent')">
        <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
        Cerrar
      </button>
    </div>
  </div>
</div>

<!-- Modal gestionar acceso (desactivar / restablecer contraseña) -->
<div class="modal-overlay" id="modal-user-access">
  <div class="modal" style="max-width:460px">
    <div class="modal-title">Restablecer contraseña</div>
    <input type="hidden" id="access-user-id">
    <p id="access-user-name" style="font-size:13px;color:var(--text-mid);margin-bottom:14px"></p>
    <div id="access-disabled-note" style="display:none;font-size:12px;color:var(--yellow);background:rgba(245,158,11,.12);border-radius:10px;padding:10px 14px;margin-bottom:14px">Este usuario tiene el acceso desactivado. Al guardar, se reactivará.</div>

    <div id="access-reset-section">
      <div class="form-label" style="margin-bottom:8px">Contraseña</div>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px">
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
          <input type="radio" name="access-pwmode" value="auto" checked onchange="switchAccessPwMode()"> Contraseña autogenerada
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
          <input type="radio" name="access-pwmode" value="custom" onchange="switchAccessPwMode()"> Contraseña personalizada
        </label>
      </div>
      <div id="access-custom-pw-wrap" style="display:none">
        <div id="access-pw-hint" style="font-size:11px;color:var(--text-dim);margin-bottom:8px"></div>
        <div class="form-group"><label class="form-label">Nueva contraseña</label><input class="form-input" id="access-pw-value" type="password" placeholder="Contraseña nueva"></div>
        <div class="form-group"><label class="form-label">Confirmar contraseña</label><input class="form-input" id="access-pw-confirm" type="password" placeholder="Repite la contraseña"></div>
        <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-mid);cursor:pointer;margin-top:-6px">
          <input type="checkbox" id="access-pw-show" style="width:14px;height:14px" onchange="toggleAccessPwVisibility()"> Mostrar contraseña
        </label>
      </div>
      <label style="display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer;margin-top:10px">
        <input type="checkbox" id="access-force-change" style="width:15px;height:15px">
        El usuario deberá crear una nueva contraseña en su próximo inicio de sesión
      </label>
      <label style="display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer;margin-top:8px">
        <input type="checkbox" id="access-revoke-sessions" style="width:15px;height:15px">
        Revocar sesiones activas
      </label>
      <div style="font-size:11px;color:var(--text-dim);margin-top:6px">Cualquier sesión ya iniciada con este usuario deja de funcionar de inmediato y debe volver a iniciar sesión.</div>
    </div>

    <div id="access-error" style="color:var(--red);font-size:13px;margin-top:10px;display:none"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-user-access')">Cancelar</button>
      <button class="btn btn-primary" id="access-save-btn" onclick="saveUserAccess()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal crear/editar rol -->
<div class="modal-overlay" id="modal-role">
  <div class="modal" style="max-width:640px">
    <div class="modal-title" id="modal-role-title">Nuevo rol</div>
    <input type="hidden" id="role-id">
    <div class="form-group">
      <label class="form-label">Nombre del rol</label>
      <input class="form-input" id="role-name" type="text" placeholder="Ej. Supervisor">
    </div>
    <div id="role-admin-note" style="display:none;font-size:12px;color:var(--yellow);background:rgba(245,158,11,.12);border-radius:10px;padding:10px 14px;margin-bottom:14px">Este es el rol Admin: siempre conserva "Control total" sobre "Usuarios y roles" para que el sistema nunca se quede sin nadie que pueda gestionarlo.</div>
    <label class="form-label" style="margin-bottom:8px">Permisos por sección</label>
    <div style="max-height:340px;overflow-y:auto;border-radius:var(--radius-sm);box-shadow:var(--clay-in-sm);padding:2px 14px">
      <div id="role-permissions-rows"></div>
    </div>
    <div id="role-error" style="color:var(--red);font-size:13px;margin-top:10px;display:none"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-role')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveRole()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal forzar cambio de contraseña (aparece al iniciar sesión con pass temporal) -->
<div class="modal-overlay" id="modal-force-change" style="z-index:9999">
  <div class="modal" style="max-width:400px">
    <div class="modal-title">Cambiar contraseña</div>
    <p style="font-size:13px;color:var(--text-mid);margin-bottom:16px">Debes establecer una contraseña propia antes de continuar.</p>
    <div id="fc-pw-hint" style="font-size:11px;color:var(--text-dim);margin-bottom:10px"></div>
    <div class="form-group">
      <label class="form-label">Nueva contraseña</label>
      <input class="form-input" id="fc-new-pass" type="password" placeholder="Contraseña nueva">
    </div>
    <div class="form-group">
      <label class="form-label">Confirmar contraseña</label>
      <input class="form-input" id="fc-confirm-pass" type="password" placeholder="Repite la contraseña">
    </div>
    <div id="fc-error" style="color:var(--red);font-size:13px;margin-bottom:10px;display:none"></div>
    <div class="modal-footer">
      <button class="btn btn-primary" style="width:100%" onclick="forceChangePassword()">Establecer contraseña</button>
    </div>
  </div>
</div>

<!-- Modal area -->
<div class="modal-overlay" id="modal-area">
  <div class="modal">
    <div class="modal-title" id="modal-area-title">Nueva Área</div>
    <input type="hidden" id="area-id">
    <div class="form-group"><label class="form-label">Nombre</label><input class="form-input" id="area-name" type="text" placeholder="Ej: Área Lima"></div>
    <div class="form-group"><label class="form-label">Ubicación</label><input class="form-input" id="area-location" type="text" placeholder="Ej: Av. Larco 123, Miraflores"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-area');document.getElementById('area-id').value=''">Cancelar</button>
      <button class="btn btn-primary" onclick="saveArea()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal bloqueo de sitio (por categoría o personalizado) -->
<div class="modal-overlay" id="modal-blocked">
  <div class="modal">
    <div class="modal-title">Bloquear sitio</div>
    <div style="display:flex;gap:8px;margin-bottom:16px">
      <button type="button" class="btn btn-sm btn-primary" id="tab-btn-category" onclick="switchBlockTab('category')" style="flex:1">Por categoría</button>
      <button type="button" class="btn btn-sm btn-ghost" id="tab-btn-custom" onclick="switchBlockTab('custom')" style="flex:1">Personalizado</button>
    </div>

    <div id="tab-category">
      <div class="form-group">
        <label class="form-label">Categoría</label>
        <div id="category-list-clean" style="display:flex;flex-direction:column;gap:6px;max-height:260px;overflow-y:auto"></div>
      </div>
    </div>

    <div id="tab-custom" style="display:none">
      <div class="form-group"><label class="form-label">Dominio</label><input class="form-input" id="blocked-domain" type="text" placeholder="Ej: facebook.com"></div>
    </div>

    <div class="form-group"><label class="form-label">Alcance</label>
      <select class="form-input" id="blocked-agent-select"><option value="">Global (todos los equipos)</option></select>
    </div>
    <div class="form-group"><label class="form-label">Motivo (opcional)</label><input class="form-input" id="blocked-reason" type="text" placeholder="Ej: Política de la empresa"></div>
    <div id="blocked-error" style="display:none;color:var(--red);font-size:12px;margin-top:-6px;margin-bottom:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-blocked')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveBlockFromModal()">Bloquear</button>
    </div>
  </div>
</div>

<!-- Modal excepción de bloqueo -->
<div class="modal-overlay" id="modal-exception">
  <div class="modal">
    <div class="modal-title">Agregar excepción</div>
    <div class="form-group">
      <label class="form-label">Dominio</label>
      <input class="form-input" id="exception-domain" type="text" readonly style="opacity:.7">
    </div>
    <div class="form-group">
      <label class="form-label">Alcance</label>
      <div style="display:flex;gap:16px;margin-bottom:8px">
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="exception-scope" value="agent" checked onchange="switchExceptionScope('agent')"> Equipo
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="exception-scope" value="sede" onchange="switchExceptionScope('sede')"> Área
        </label>
      </div>
      <select class="form-input" id="exception-agent-select"></select>
      <select class="form-input" id="exception-sede-select" style="display:none"></select>
    </div>
    <div class="form-group"><label class="form-label">Motivo (opcional)</label><input class="form-input" id="exception-reason" type="text" placeholder="Ej: Cuenta de marketing necesita acceso"></div>
    <div class="form-group">
      <label class="form-label">Expira el (opcional)</label>
      <input type="date" class="form-input" id="exception-expires" style="width:220px">
      <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Pasada esta fecha, el sitio vuelve a bloquearse solo. Déjalo vacío para que sea permanente.</div>
    </div>
    <div id="exception-error" style="display:none;color:var(--red);font-size:12px;margin-top:-6px;margin-bottom:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-exception')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveException()">Guardar excepción</button>
    </div>
  </div>
</div>

<!-- Modal aplicar una categoría puntual (usado desde la página Categorías) -->
<div class="modal-overlay" id="modal-apply-category">
  <div class="modal">
    <div class="modal-title">Bloquear categoría</div>
    <input type="hidden" id="apply-category-key">
    <div class="form-group"><label class="form-label">Categoría</label>
      <input class="form-input" id="apply-category-label" type="text" readonly style="opacity:.7">
    </div>
    <div class="form-group">
      <label class="form-label">Alcance</label>
      <div style="display:flex;gap:16px;margin-bottom:8px">
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="apply-category-scope" value="global" checked onchange="switchApplyCategoryScope('global')"> Global
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="apply-category-scope" value="agent" onchange="switchApplyCategoryScope('agent')"> Equipo
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="apply-category-scope" value="sede" onchange="switchApplyCategoryScope('sede')"> Área
        </label>
      </div>
      <select class="form-input" id="apply-category-agent-select" style="display:none"></select>
      <select class="form-input" id="apply-category-sede-select" style="display:none"></select>
    </div>
    <div class="form-group"><label class="form-label">Motivo (opcional)</label><input class="form-input" id="apply-category-reason" type="text" placeholder="Ej: Política de la empresa"></div>
    <div id="apply-category-error" style="display:none;color:var(--red);font-size:12px;margin-top:-6px;margin-bottom:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-apply-category')">Cancelar</button>
      <button class="btn btn-primary" onclick="confirmApplyCategory()">Bloquear</button>
    </div>
  </div>
</div>

<!-- Modal exceptuar categoría (por equipo o área) -->
<div class="modal-overlay" id="modal-except-category">
  <div class="modal">
    <div class="modal-title">Exceptuar categoría</div>
    <input type="hidden" id="except-category-key">
    <div class="form-group"><label class="form-label">Categoría</label>
      <input class="form-input" id="except-category-label" type="text" readonly style="opacity:.7">
    </div>
    <div class="form-group">
      <label class="form-label">Alcance</label>
      <div style="display:flex;gap:16px;margin-bottom:8px">
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="except-category-scope" value="sede" checked onchange="switchExceptCategoryScope('sede')"> Área
        </label>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
          <input type="radio" name="except-category-scope" value="agent" onchange="switchExceptCategoryScope('agent')"> Equipo
        </label>
      </div>
      <select class="form-input" id="except-category-sede-select"></select>
      <select class="form-input" id="except-category-agent-select" style="display:none"></select>
    </div>
    <div class="form-group"><label class="form-label">Motivo (opcional)</label><input class="form-input" id="except-category-reason" type="text" placeholder="Ej: Solicitado por una semana"></div>
    <div class="form-group">
      <label class="form-label">Expira el (opcional)</label>
      <input type="date" class="form-input" id="except-category-expires" style="width:220px">
      <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Pasada esta fecha, vuelve a aplicar la categoría solo. Déjalo vacío para que sea permanente.</div>
    </div>
    <div id="except-category-error" style="display:none;color:var(--red);font-size:12px;margin-top:-6px;margin-bottom:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-except-category')">Cancelar</button>
      <button class="btn btn-primary" onclick="confirmExceptCategory()">Guardar excepción</button>
    </div>
  </div>
</div>

<!-- Modal reporte de bloqueos con filtros -->
<div class="modal-overlay" id="modal-report-filters">
  <div class="modal">
    <div class="modal-title">Reporte Excel</div>
    <div style="font-size:12px;color:var(--text-dim);margin-top:-12px;margin-bottom:16px">Deja los filtros vacíos para el reporte general (todos los equipos), o elige para acotarlo.</div>
    <div class="form-group"><label class="form-label">Área (opcional)</label>
      <select class="form-input" id="report-sede-select"><option value="">Todas las áreas</option></select>
    </div>
    <div class="form-group"><label class="form-label">Equipo (opcional)</label>
      <select class="form-input" id="report-agent-select"><option value="">Todos los equipos</option></select>
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
        <input type="checkbox" id="report-only-blocked"> Solo equipos con al menos un sitio bloqueado
      </label>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-report-filters')">Cancelar</button>
      <button class="btn btn-primary" onclick="downloadBlockReport()">Descargar Excel</button>
    </div>
  </div>
</div>

<!-- Modal configuración de borrado automático de intentos bloqueados -->
<div class="modal-overlay" id="modal-attempts-retention">
  <div class="modal" style="max-width:420px">
    <div class="modal-title">Borrado automático del historial</div>
    <div style="font-size:12px;color:var(--text-dim);margin-top:-12px;margin-bottom:16px">Los registros más antiguos que este plazo se eliminan solos. Con "Nunca" se conservan indefinidamente.</div>
    <div class="form-group">
      <label class="form-label">Conservar historial</label>
      <select class="form-input" id="attempts-retention-select">
        <option value="">Nunca (conservar todo)</option>
        <option value="30">Después de 30 días</option>
        <option value="60">Después de 60 días</option>
        <option value="90">Después de 90 días</option>
      </select>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-attempts-retention')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveAttemptsRetention()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal restricción por red WiFi -->
<div class="modal-overlay" id="modal-network-gate">
  <div class="modal" style="max-width:480px">
    <div class="modal-title">Restricción por red WiFi</div>
    <div style="display:flex;align-items:center;gap:12px;margin-top:-8px">
      <label class="toggle-switch">
        <input type="checkbox" id="network-gate-enabled" onchange="renderNetworkGate()">
        <span class="slider"></span>
      </label>
      <span style="font-size:14px;font-weight:600">Activar restricción por red WiFi</span>
      <b id="network-gate-onoff-modal" style="font-size:11px;color:var(--text-dim);margin-left:auto">OFF</b>
    </div>
    <div style="font-size:12px;color:var(--text-dim);margin-top:6px">
      Cuando está activado, las reglas de bloqueo (categorías, sitios y horario) solo se aplican mientras el equipo esté conectado a una de las redes WiFi que definas abajo. Fuera de esas redes — otra red WiFi, cable, etc. — el bloqueo se desactiva automáticamente. Con el toggle desactivado, el sistema funciona como hasta ahora (sin importar la red).
    </div>

    <div id="network-gate-list-wrap" style="margin-top:16px">
      <label class="form-label">Redes WiFi permitidas (nombre exacto del SSID)</label>
      <div style="display:flex;gap:10px;margin-top:6px">
        <input class="form-input" id="network-gate-input" placeholder="Ej. Oficina-WiFi" style="flex:1" onkeydown="if(event.key==='Enter'){event.preventDefault();addNetworkGateEntry();}">
        <button class="btn btn-primary btn-sm" style="width:auto" onclick="addNetworkGateEntry()">+ Agregar</button>
      </div>
      <div id="network-gate-chips" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px"></div>
    </div>

    <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">
      <label class="form-label">Revisar si debe bloquear cada</label>
      <select id="modal-blocklist-interval-select" class="form-input" style="margin-top:6px" onchange="setBlocklistInterval(this.value)">
        <option value="60" selected>1 min</option>
        <option value="180">3 min</option>
        <option value="300">5 min</option>
        <option value="420">7 min</option>
        <option value="600">10 min</option>
      </select>
      <div style="font-size:12px;color:var(--text-dim);margin-top:6px">Cada cuánto cada equipo pregunta si debe bloquear o no. Más bajo reacciona más rápido a una excepción o cambio de red; más alto genera menos tráfico contra el servidor (recomendado con muchos equipos).</div>
    </div>

    <div style="font-size:12px;color:var(--text-dim);margin-top:12px" id="network-gate-hint"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-network-gate')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveNetworkGate()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal política de contraseñas -->
<div class="modal-overlay" id="modal-password-policy">
  <div class="modal" style="max-width:560px">
    <div class="modal-title-row">
      <div class="modal-title">Política de contraseñas</div>
      <button class="modal-close" onclick="closeModal('modal-password-policy')" aria-label="Cerrar">✕</button>
    </div>
    <div class="page-sub" style="margin-top:-12px;margin-bottom:18px">Se aplica cada vez que un usuario define o le restablecen una contraseña.</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div>
        <div class="form-group">
          <label class="form-label">Longitud mínima</label>
          <input class="form-input" id="pp-min-length" type="number" min="6" max="128" style="max-width:140px">
          <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Entre 6 y 128 caracteres.</div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-top:12px">
          <input type="checkbox" id="pp-uppercase" style="width:15px;height:15px"> Requiere al menos una mayúscula
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-top:8px">
          <input type="checkbox" id="pp-lowercase" style="width:15px;height:15px"> Requiere al menos una minúscula
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-top:8px">
          <input type="checkbox" id="pp-number" style="width:15px;height:15px"> Requiere al menos un número
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-top:8px">
          <input type="checkbox" id="pp-special" style="width:15px;height:15px"> Requiere al menos un carácter especial (! @ # $ % ^ &amp;)
        </label>
      </div>
      <div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer">
          <input type="checkbox" id="pp-expiration" style="width:15px;height:15px" onchange="_ppToggleExpiration()"> Activar expiración de contraseña
        </label>
        <div id="pp-expiration-wrap" style="margin-top:8px;margin-left:23px">
          <label class="form-label">Expira cada</label>
          <div style="display:flex;align-items:center;gap:8px">
            <input class="form-input" id="pp-expire-days" type="number" min="1" max="1095" style="max-width:100px"> <span style="font-size:13px;color:var(--text-mid)">día(s)</span>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Al vencer, se le pide crear una nueva contraseña en su próximo inicio de sesión. Entre 1 y 1095 días.</div>
        </div>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-top:18px">
          <input type="checkbox" id="pp-prevent-reuse" style="width:15px;height:15px" onchange="_ppToggleReuse()"> Evitar reutilizar contraseñas anteriores
        </label>
        <div id="pp-reuse-wrap" style="margin-top:8px;margin-left:23px">
          <label class="form-label">Recordar las últimas</label>
          <div style="display:flex;align-items:center;gap:8px">
            <input class="form-input" id="pp-reuse-count" type="number" min="1" max="24" style="max-width:100px"> <span style="font-size:13px;color:var(--text-mid)">contraseña(s)</span>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Entre 1 y 24.</div>
        </div>
      </div>
    </div>
    <div class="form-actions" style="margin-top:20px">
      <button class="btn btn-primary btn-sm" onclick="savePasswordPolicy()">Guardar política</button>
      <div id="pp-status" style="font-size:12px;display:none"></div>
    </div>
  </div>
</div>

<!-- Modal configurar notificaciones (Correo) -->
<div class="modal-overlay" id="modal-notifications">
  <div class="modal" style="max-width:720px">
    <div class="modal-title-row">
      <div class="modal-title">Configurar notificaciones</div>
      <button class="modal-close" onclick="closeModal('modal-notifications')" aria-label="Cerrar">✕</button>
    </div>
    <div class="page-sub" style="margin-top:-12px;margin-bottom:16px">Avisa cuando un equipo tenga CPU/RAM/disco/temperatura altos o se desconecte. Puedes activar varios canales a la vez — el selector solo cambia cuál estás viendo/configurando.</div>

    <div class="form-group">
      <label class="form-label">Canal a configurar</label>
      <select class="form-input" id="notif-channel-select" onchange="switchNotifChannel(this.value)">
        <option value="smtp">📧 Correo (SMTP)</option>
        <option value="telegram">✈️ Telegram</option>
        <option value="whatsapp">💬 WhatsApp (CallMeBot)</option>
      </select>
    </div>

    <div class="notif-accordion">
      <!-- ── Correo / SMTP ── -->
      <div class="notif-acc-item">
        <div class="notif-acc-body" id="notif-section-smtp">
          <div class="notif-howto">
            <strong>Cómo conectarlo:</strong> usa el servidor SMTP de tu proveedor de correo.
            Gmail: <code>smtp.gmail.com</code> puerto <code>587</code> — Outlook/Office365: <code>smtp.office365.com</code> puerto <code>587</code>.
            Si tu cuenta tiene verificación en 2 pasos (lo normal hoy en Gmail/Outlook), la "Contraseña" NO es la de tu cuenta — tienes que generar una
            <strong>contraseña de aplicación</strong> específica desde la configuración de seguridad de tu proveedor y pegar esa acá.
          </div>
          <div class="form-group" style="display:flex;align-items:center;justify-content:space-between">
            <label class="form-label" style="margin-bottom:0">Activar notificaciones por correo</label>
            <label class="toggle-switch"><input type="checkbox" id="em-enabled"><span class="slider"></span></label>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Servidor SMTP</label>
              <input class="form-input" id="em-host" type="text" placeholder="smtp.gmail.com">
            </div>
            <div class="form-group">
              <label class="form-label">Puerto</label>
              <input class="form-input" id="em-port" type="number" placeholder="587">
            </div>
            <div class="form-group">
              <label class="form-label">Usuario</label>
              <input class="form-input" id="em-user" type="text" placeholder="alertas@empresa.com">
            </div>
            <div class="form-group">
              <label class="form-label">Contraseña</label>
              <input class="form-input" id="em-pass" type="password" placeholder="••••••••">
            </div>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Remitente</label>
              <input class="form-input" id="em-from" type="text" placeholder="alertas@empresa.com">
            </div>
            <div class="form-group">
              <label class="form-label">Asunto</label>
              <input class="form-input" id="em-subject" type="text" placeholder="SmartMonitor — {{tipo}}: {{equipo}}">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Destinatarios (Para)</label>
            <input class="form-input" id="em-to" type="text" placeholder="soporte@empresa.com, ti@empresa.com">
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Copia (CC)</label>
              <input class="form-input" id="em-cc" type="text" placeholder="jefe@empresa.com">
            </div>
            <div class="form-group">
              <label class="form-label">Copia oculta (CCO)</label>
              <input class="form-input" id="em-bcc" type="text" placeholder="auditoria@empresa.com">
            </div>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin:-4px 0 16px">Los campos de destinatarios aceptan varias direcciones separadas por coma.</div>

          <div class="notif-subtitle">Plantilla del correo</div>
          <div class="page-sub" style="margin-top:-6px;margin-bottom:12px">Variables: <code>{{titulo}}</code>, <code>{{equipo}}</code>, <code>{{detalle}}</code>, <code>{{fecha}}</code>.</div>
          <div class="form-grid" style="grid-template-columns:1fr 1fr">
            <div>
              <textarea class="form-input" id="em-template" rows="10" style="font-family:var(--mono);font-size:12px;resize:vertical" oninput="_renderEmailPreview()"></textarea>
            </div>
            <div>
              <div class="form-label" style="margin-bottom:6px">Vista previa</div>
              <div id="em-preview" style="background:#fff;border-radius:var(--radius-sm);padding:16px;min-height:200px;box-shadow:var(--clay-in-sm)"></div>
            </div>
          </div>

          <div class="form-actions" style="margin-top:18px">
            <button class="btn btn-primary btn-sm" onclick="saveEmail()">Guardar</button>
            <button class="btn btn-ghost btn-sm" onclick="testEmail()">Enviar prueba</button>
            <button class="btn btn-ghost btn-sm" onclick="_restoreDefaultTemplate()">Restaurar plantilla</button>
            <span id="em-test-pill" class="em-pill" style="display:none"></span>
          </div>
          <div id="em-status" style="font-size:12px;margin-top:10px;display:none"></div>
        </div>
      </div>

      <!-- ── Telegram ── -->
      <div class="notif-acc-item">
        <div class="notif-acc-body" id="notif-section-telegram">
          <div class="notif-howto">
            <strong>Cómo conectarlo:</strong>
            <ol style="margin:6px 0 0 18px;padding:0">
              <li>En Telegram, busca el contacto <strong>@BotFather</strong> y ábrele un chat.</li>
              <li>Mándale <code>/newbot</code> y sigue las instrucciones (nombre y usuario del bot).</li>
              <li>Te va a dar un <strong>Token</strong> (algo como <code>123456789:ABCdefGhIJKl...</code>) — pégalo abajo.</li>
              <li>Abre un chat con el bot que acabas de crear y mándale cualquier mensaje (ej. "hola").</li>
              <li>Para obtener tu <strong>Chat ID</strong>: busca el contacto <strong>@userinfobot</strong>, ábrele un chat y te va a mostrar tu ID numérico. Pégalo abajo.</li>
            </ol>
          </div>
          <div class="form-group" style="display:flex;align-items:center;justify-content:space-between">
            <label class="form-label" style="margin-bottom:0">Activar notificaciones por Telegram</label>
            <label class="toggle-switch"><input type="checkbox" id="tg-enabled"><span class="slider"></span></label>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Token del bot</label>
              <input class="form-input" id="tg-token" type="text" placeholder="123456789:ABCdefGhIJKlmNoPQRsTuVwxYZ">
            </div>
            <div class="form-group">
              <label class="form-label">Chat ID</label>
              <input class="form-input" id="tg-chat" type="text" placeholder="123456789">
            </div>
          </div>
          <div class="form-actions" style="margin-top:10px">
            <button class="btn btn-primary btn-sm" onclick="saveTelegram()">Guardar</button>
            <button class="btn btn-ghost btn-sm" onclick="testTelegram()">Enviar prueba</button>
          </div>
          <div id="tg-status" style="font-size:12px;margin-top:10px;display:none"></div>
        </div>
      </div>

      <!-- ── WhatsApp (CallMeBot) ── -->
      <div class="notif-acc-item">
        <div class="notif-acc-body" id="notif-section-whatsapp">
          <div class="notif-howto">
            <strong>Cómo conectarlo:</strong> servicio comunitario gratuito (no oficial de WhatsApp) — solo manda al número que tú mismo autorizaste.
            <ol style="margin:6px 0 0 18px;padding:0">
              <li>Agrega este número a tus contactos (es el número de activación de CallMeBot):
                <input id="wa-activation-number" type="text" style="font-family:var(--mono);font-size:12px;background:var(--surface2);border:none;border-radius:4px;padding:1px 6px;width:130px;color:inherit;outline:none" placeholder="+34 644 59 71 36">
                <a href="#" onclick="saveWhatsappActivationNumber();return false" style="font-size:11px;color:var(--accent);cursor:pointer">actualizar</a>
              </li>
            </ol>
            <ol start="2" style="margin:0 0 0 18px;padding:0">
              <li>Desde tu WhatsApp, mándale a ese contacto exactamente este mensaje (tal cual, en inglés):<br><code>I allow callmebot to send me messages</code></li>
              <li>Te responde en segundos con tu <strong>API key</strong> (un número) — cópiala abajo, junto con tu teléfono (con código de país, sin +).</li>
            </ol>
            <div style="margin-top:8px;color:var(--text-dim)">Si ese número no responde (a veces cambia), verifica el actual en <code>callmebot.com</code> buscando "WhatsApp API" y actualízalo arriba — queda guardado para todos los que usen este panel.</div>
          </div>
          <div class="form-group" style="display:flex;align-items:center;justify-content:space-between">
            <label class="form-label" style="margin-bottom:0">Activar notificaciones por WhatsApp</label>
            <label class="toggle-switch"><input type="checkbox" id="wa-enabled"><span class="slider"></span></label>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin:-4px 0 10px">Cada número necesita su propia API key (cada persona se activa por su lado con CallMeBot, ver arriba) — agrega uno por cada destinatario.</div>
          <div id="wa-recipients-list"></div>
          <button class="btn btn-ghost btn-sm" type="button" style="width:auto;margin-bottom:10px" onclick="addWhatsappRecipientRow('','')">+ Agregar número</button>
          <div class="form-actions" style="margin-top:10px">
            <button class="btn btn-primary btn-sm" onclick="saveWhatsapp()">Guardar</button>
            <button class="btn btn-ghost btn-sm" onclick="testWhatsapp()">Enviar prueba</button>
          </div>
          <div id="wa-status" style="font-size:12px;margin-top:10px;display:none"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal excepción de horario (por equipo o área) -->
<div class="modal-overlay" id="modal-schedule-override">
  <div class="modal" style="max-width:480px">
    <div class="modal-title" id="schedule-override-title">Agregar excepción de horario</div>
    <input type="hidden" id="schedule-override-id">
    <div class="form-group" id="schedule-override-scope-group">
      <label class="form-label">Equipo</label>
      <select class="form-input" id="schedule-override-agent-select" onchange="onScheduleAgentChange()"></select>
    </div>
    <div id="override-schedule-days-wrap">
      <div style="font-size:11px;color:var(--text-dim);margin-bottom:8px">Desmarca un día para no bloquear ese día en este alcance.</div>
      <div id="override-schedule-days"></div>
      <div style="display:flex;align-items:center;gap:10px;margin-top:12px">
        <label class="form-label" style="margin-bottom:0">Zona horaria</label>
        <input class="form-input" id="override-schedule-tz" style="width:220px" value="America/Lima">
      </div>
    </div>
    <div class="form-group" id="schedule-override-expires-group" style="margin-top:14px">
      <label class="form-label">Expira el (opcional)</label>
      <input type="date" class="form-input" id="schedule-override-expires" style="width:220px">
      <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Pasada esta fecha, el equipo vuelve solo al horario de su área (o al global). Déjalo vacío para que sea permanente.</div>
    </div>
    <div id="schedule-override-error" style="display:none;color:var(--red);font-size:12px;margin-top:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-schedule-override')">Cancelar</button>
      <button class="btn btn-primary" id="schedule-override-save-btn" onclick="saveScheduleOverride()">Guardar</button>
    </div>
  </div>
</div>

<!-- Modal crear categoría personalizada -->
<div class="modal-overlay" id="modal-custom-category">
  <div class="modal">
    <div class="modal-title" id="custom-category-title">Crear categoría personalizada</div>
    <input type="hidden" id="custom-category-id">
    <div class="form-group"><label class="form-label">Nombre</label><input class="form-input" id="custom-category-label" type="text" placeholder="Ej: Sitios de la competencia"></div>
    <div class="form-group">
      <label class="form-label">Dominios (uno por línea)</label>
      <textarea class="form-input" id="custom-category-domains" rows="6" style="resize:vertical" placeholder="dominio1.com&#10;dominio2.com&#10;dominio3.com"></textarea>
      <div style="font-size:11px;color:var(--text-dim);margin-top:4px">Si esta categoría ya está bloqueada en algún equipo, los cambios se aplican ahí automáticamente.</div>
    </div>
    <div id="custom-category-error" style="display:none;color:var(--red);font-size:12px;margin-top:-6px;margin-bottom:10px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-custom-category');returnFromCategoryModal()">Cancelar</button>
      <button class="btn btn-primary" id="custom-category-save-btn" onclick="saveCustomCategory()">Crear</button>
    </div>
  </div>
</div>

<!-- Modal editar agente -->
<!-- Modal historial de cambios de inventario -->
<div class="modal-overlay" id="modal-change-history">
  <div class="modal" style="max-width:480px">
    <div class="modal-title-row">
      <div class="modal-title" id="modal-change-history-title">Registrar cambio / mantenimiento</div>
      <button class="modal-close" onclick="closeModal('modal-change-history')" aria-label="Cerrar">✕</button>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Tipo</label>
        <div style="display:flex;align-items:center;gap:8px">
          <div class="s-icon" id="ch-field-icon" style="width:34px;height:34px;border-radius:10px;flex-shrink:0"></div>
          <select class="form-input" id="ch-field" style="flex:1" onchange="updateChangeFieldIcon()">
            <option value="RAM">RAM</option>
            <option value="Batería">Batería</option>
            <option value="Fuente">Fuente de poder</option>
            <option value="Disco">Disco</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Fecha del cambio</label>
        <input class="form-input" id="ch-date" type="date">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Detalle</label>
      <textarea class="form-input" id="ch-note" rows="2" style="resize:vertical" placeholder="Ej: se cambió RAM por falla, se reemplazó batería de la laptop, se cambió fuente de la PC..."></textarea>
    </div>
    <div class="form-actions" style="margin-top:8px">
      <button class="btn btn-primary btn-sm" onclick="saveAgentChange()">Registrar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-agent">
  <div class="modal">
    <div class="modal-title">Editar equipo</div>
    <div class="form-group"><label class="form-label">Nombre para mostrar</label><input class="form-input" id="agent-display-name" type="text"></div>
    <div class="form-group"><label class="form-label">Área</label>
      <select class="form-input" id="agent-sede-select"><option value="">Sin área</option></select>
    </div>
    <div class="form-group"><label class="form-label">Notas</label><textarea class="form-input" id="agent-notes" rows="3" style="resize:vertical"></textarea></div>
    <div class="form-group"><label class="form-label">Tipo de dispositivo</label>
      <div style="display:flex;gap:8px;align-items:center">
        <select class="form-input" id="agent-device-type" style="flex:1"></select>
        <button class="btn btn-primary btn-sm" type="button" onclick="openDeviceTypesModal()" title="Agregar más tipos de dispositivo" style="font-size:20px;font-weight:900;line-height:1;padding:4px 10px">+</button>
      </div>
    </div>
    <div class="form-grid">
      <div class="form-group"><label class="form-label">Fecha de compra</label><input class="form-input" id="agent-purchase-date" type="date"></div>
      <div class="form-group"><label class="form-label">N° Factura</label><input class="form-input" id="agent-invoice-number" type="text" placeholder="Ej: F-001-00012345"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-agent')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveAgent()">Guardar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-assignment">
  <div class="modal" style="max-width:520px">
    <div class="modal-title" id="modal-assignment-title">Asignar equipo</div>
    <div id="asg-section-assign">
      <div class="form-group"><label class="form-label">Asignado a</label>
        <select class="form-input" id="asg-user"><option value="">Sin asignar</option></select>
      </div>
      <div class="form-group"><label class="form-label">Fecha de asignación</label><input class="form-input" id="asg-assigned-at" type="date"></div>
      <div class="form-group"><label class="form-label">Observaciones de entrega</label><textarea class="form-input" id="asg-assignment-notes" rows="2" style="resize:vertical" placeholder="Ej: entregado a Juan Pérez, estado físico, accesorios…"></textarea></div>
    </div>
    <div id="asg-section-return">
      <div class="form-group"><label class="form-label">Fecha de devolución</label><input class="form-input" id="asg-returned-at" type="date"></div>
      <div class="form-group"><label class="form-label">Observaciones de devolución</label><textarea class="form-input" id="asg-return-notes" rows="2" style="resize:vertical" placeholder="Ej: devuelto por falla de batería, faltante de cargador…"></textarea></div>
    </div>
    <div id="asg-section-edit">
      <div class="form-group"><label class="form-label">Asignado a</label>
        <select class="form-input" id="asg-edit-user"><option value="">Sin asignar</option></select>
      </div>
      <div class="form-group"><label class="form-label">Fecha de asignación</label><input class="form-input" id="asg-edit-assigned-at" type="date"></div>
      <div class="form-group"><label class="form-label">Observaciones de entrega</label><textarea class="form-input" id="asg-edit-delivery-notes" rows="2" style="resize:vertical"></textarea></div>
      <div class="form-group"><label class="form-label">Fecha de devolución</label><input class="form-input" id="asg-edit-returned-at" type="date"></div>
      <div class="form-group"><label class="form-label">Observaciones de devolución</label><textarea class="form-input" id="asg-edit-return-notes" rows="2" style="resize:vertical"></textarea></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-assignment')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveAssignment()">Guardar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-review-status">
  <div class="modal" style="max-width:420px">
    <div class="modal-title">Estado del equipo</div>
    <div class="form-group"><label class="form-label">Estado</label>
      <select class="form-input" id="rs-select">
        <option value="">Normal (Asignado/Disponible automático)</option>
        <option value="en_observacion">En observación</option>
        <option value="baja">Baja</option>
      </select>
    </div>
    <div id="rs-hint" style="font-size:12px;color:var(--text-dim);margin-top:-6px;margin-bottom:10px"></div>
    <div class="form-group" id="rs-note-group">
      <label class="form-label" id="rs-note-label">Motivo</label>
      <textarea class="form-input" id="rs-note" rows="2" style="resize:vertical" placeholder="Ej: falla irreparable de placa, reemplazado por equipo nuevo…"></textarea>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-review-status')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveReviewStatus()">Guardar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-device-types">
  <div class="modal" style="max-width:640px">
    <div class="modal-title-row">
      <div class="modal-title">Tipos y categorías</div>
      <button class="modal-close" onclick="closeModal('modal-device-types')" aria-label="Cerrar">✕</button>
    </div>
    <div class="page-sub" style="margin:4px 0 12px">Una sola lista para todo: equipos monitoreados (Laptop, PC, etc.) y el resto del inventario (monitores, cables, celulares...). "Serializado" = una fila por unidad. "Por cantidad" = un conteo de stock (cables, etc.) — no se puede cambiar una vez que la categoría ya tiene activos.</div>
    <div id="ast-types-list" style="display:flex;flex-direction:column;gap:10px;max-height:340px;overflow-y:auto"></div>
    <button class="btn btn-ghost btn-sm" style="margin:10px 0 4px" onclick="openNewAssetTypeForm()">+ Nueva categoría</button>
    <div id="ast-type-form" style="display:none;background:var(--surface2);border-radius:var(--radius-sm);padding:14px;margin-top:8px">
      <input type="hidden" id="ast-type-id">
      <input type="hidden" id="ast-type-icon" value="other">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
        <span id="ast-type-icon-preview" style="width:28px;display:inline-flex;justify-content:center"></span>
        <label class="btn btn-ghost btn-sm" style="cursor:pointer;white-space:nowrap;margin:0">
          Subir icono<input type="file" accept="image/*" style="display:none" onchange="assetTypeIconUpload(this)">
        </label>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Nombre</label>
          <input class="form-input" id="ast-type-name" type="text" placeholder="Ej. Cable de red">
        </div>
        <div class="form-group">
          <label class="form-label">Comportamiento</label>
          <select class="form-input" id="ast-type-kind">
            <option value="serialized">Serializado (uno por uno)</option>
            <option value="stock">Por cantidad (stock)</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">¿Se puede vincular con otra categoría? (opcional)</label>
        <select class="form-input" id="ast-type-linkable"><option value="">No vincula</option></select>
      </div>
      <div class="form-group">
        <label class="form-label">Campos extra (opcional, uno por línea)</label>
        <div style="font-size:11px;color:var(--text-dim);margin-bottom:4px">Texto libre: <code>clave=Etiqueta</code> — Lista desplegable: <code>clave=Etiqueta=opción1,opción2,opción3</code></div>
        <textarea class="form-input" id="ast-type-extra" rows="2" placeholder="imei=IMEI&#10;operador=Operador=Claro,Movistar,Entel,Bitel"></textarea>
      </div>
      <div class="form-actions">
        <button class="btn btn-ghost btn-sm" type="button" onclick="closeAssetTypeForm()">Cancelar</button>
        <button class="btn btn-primary btn-sm" type="button" onclick="saveAssetType()">Guardar categoría</button>
      </div>
      <div id="ast-type-error" style="display:none;color:var(--red);font-size:12px;margin-top:8px"></div>
    </div>
  </div>
</div>

<!-- Modal activo: crear/editar/asignar/devolver/stock/historial, todo en un lugar -->
<div class="modal-overlay" id="modal-asset">
  <div class="modal" style="max-width:640px">
    <div class="modal-title-row">
      <div class="modal-title" id="modal-asset-title">Nuevo activo</div>
      <button class="modal-close" onclick="closeModal('modal-asset')" aria-label="Cerrar">✕</button>
    </div>
    <input type="hidden" id="asset-id">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Tipo</label>
        <select class="form-input" id="asset-type-select" onchange="onAssetTypeChange()"></select>
      </div>
      <div class="form-group">
        <label class="form-label">Nombre / Modelo</label>
        <input class="form-input" id="asset-name" type="text" placeholder="Ej. Monitor LG 24'' o Cable VGA 1.5m">
      </div>
    </div>
    <div class="form-grid" id="asset-serialized-fields">
      <div class="form-group">
        <label class="form-label">Código / Serie</label>
        <input class="form-input" id="asset-code" type="text">
      </div>
      <div class="form-group">
        <label class="form-label">Estado</label>
        <select class="form-input" id="asset-status">
          <option value="nuevo">Nuevo</option>
          <option value="almacen">En almacén</option>
          <option value="asignado">Asignado</option>
          <option value="dañado">Dañado</option>
          <option value="baja">Dado de baja</option>
        </select>
      </div>
    </div>
    <div class="form-group" id="asset-stock-initial-group" style="display:none">
      <label class="form-label">Cantidad inicial en almacén</label>
      <input class="form-input" id="asset-stock-initial" type="number" min="0" placeholder="0">
    </div>
    <div id="asset-extra-fields"></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Área</label>
        <select class="form-input" id="asset-sede"><option value="">Sin área</option></select>
      </div>
      <div class="form-group">
        <label class="form-label">Vincular con (opcional)</label>
        <select class="form-input" id="asset-linked"><option value="">Sin vincular</option></select>
      </div>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Fecha de compra</label>
        <input class="form-input" id="asset-purchase-date" type="date">
      </div>
      <div class="form-group">
        <label class="form-label">N° de factura</label>
        <input class="form-input" id="asset-invoice" type="text">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Notas</label>
      <textarea class="form-input" id="asset-notes" rows="2"></textarea>
    </div>
    <div id="asset-error" style="display:none;color:var(--red);font-size:12px;margin-top:6px"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-asset')">Cancelar</button>
      <button class="btn btn-primary" onclick="saveAsset()">Guardar</button>
    </div>

    <div id="asset-manage-section" style="display:none;margin-top:18px;padding-top:16px;border-top:1px solid var(--border)">
      <div id="asset-current-status" style="font-size:13px;margin-bottom:10px"></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
        <button class="btn btn-sm btn-ghost" id="asset-btn-assign" onclick="toggleAssetSubform('assign')">➕ Asignar</button>
        <button class="btn btn-sm btn-ghost" id="asset-btn-return" onclick="toggleAssetSubform('return')">↩️ Devolver</button>
        <button class="btn btn-sm btn-ghost" id="asset-btn-stock" onclick="toggleAssetSubform('stock')" style="display:none">📦 Agregar stock</button>
        <button class="btn btn-sm btn-danger" onclick="deleteAssetFromModal()">🗑️ Eliminar</button>
      </div>

      <div id="asset-subform-assign" style="display:none;background:var(--surface2);border-radius:var(--radius-sm);padding:14px;margin-bottom:14px">
        <div class="form-grid">
          <div class="form-group"><label class="form-label">Usuario</label><select class="form-input" id="asset-assign-user"></select></div>
          <div class="form-group" id="asset-assign-qty-group" style="display:none"><label class="form-label">Cantidad</label><input class="form-input" id="asset-assign-qty" type="number" min="1" value="1"></div>
        </div>
        <div class="form-group"><label class="form-label">Notas de entrega</label><input class="form-input" id="asset-assign-notes" type="text"></div>
        <button class="btn btn-primary btn-sm" type="button" onclick="confirmAssetAssign()">Confirmar asignación</button>
      </div>

      <div id="asset-subform-return" style="display:none;background:var(--surface2);border-radius:var(--radius-sm);padding:14px;margin-bottom:14px">
        <div id="asset-return-allocations"></div>
        <div class="form-group"><label class="form-label">Notas de devolución</label><input class="form-input" id="asset-return-notes" type="text"></div>
        <button class="btn btn-primary btn-sm" type="button" onclick="confirmAssetReturn()">Confirmar devolución</button>
      </div>

      <div id="asset-subform-stock" style="display:none;background:var(--surface2);border-radius:var(--radius-sm);padding:14px;margin-bottom:14px">
        <div class="form-group"><label class="form-label">Cantidad a agregar</label><input class="form-input" id="asset-stock-add-qty" type="number" min="1" value="1"></div>
        <div class="form-group"><label class="form-label">Notas (opcional)</label><input class="form-input" id="asset-stock-add-notes" type="text"></div>
        <button class="btn btn-primary btn-sm" type="button" onclick="confirmAssetStockAdd()">Confirmar ingreso</button>
      </div>

      <div class="notif-subtitle">Historial</div>
      <div id="asset-history-list" style="max-height:220px;overflow-y:auto"></div>
    </div>
  </div>
</div>


<div class="modal-overlay" id="modal-software" onclick="if(event.target===this)closeModal('modal-software')">
  <div class="modal" style="max-width:680px;max-height:88vh;display:flex;flex-direction:column">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px">
      <div style="display:flex;gap:14px;align-items:flex-start">
        <div class="s-icon blue" style="width:48px;height:48px;border-radius:14px"><svg viewBox="0 0 24 24" fill="currentColor" style="width:24px;height:24px"><path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
        <div>
          <div class="modal-title" style="margin-bottom:2px" id="modal-sw-title">Programas instalados</div>
          <div style="font-size:12px;color:var(--text-dim)" id="modal-sw-meta"></div>
        </div>
      </div>
      <button class="btn btn-sm btn-ghost" onclick="closeModal('modal-software')" style="width:34px;height:34px;padding:0;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">✕</button>
    </div>

    <div style="display:flex;gap:10px;margin-bottom:14px">
      <div class="sw-search-wrap">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <input id="sw-search" class="form-input" placeholder="Buscar programa..." style="font-size:13px" oninput="onSwSearchInput(this.value)">
      </div>
      <div class="sw-sort-wrap">
        <button class="btn btn-ghost sw-sort-btn" onclick="toggleSwSortMenu()" id="sw-sort-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/></svg>
          Ordenar por: <span id="sw-sort-label">Nombre (A → Z)</span>
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M7 10l5 5 5-5z"/></svg>
        </button>
        <div class="sw-sort-menu" id="sw-sort-menu">
          <div class="sw-sort-item" onclick="setSwSort('name_asc')">Nombre (A → Z)</div>
          <div class="sw-sort-item" onclick="setSwSort('name_desc')">Nombre (Z → A)</div>
          <div class="sw-sort-item" onclick="setSwSort('version')">Versión</div>
        </div>
      </div>
    </div>

    <div class="sw-table-head">
      <div style="flex:1">Programa</div>
      <div style="width:160px">Versión</div>
      <div style="width:16px"></div>
    </div>
    <div style="overflow-y:auto;flex:1" id="modal-sw-body"></div>
    <div class="sw-pagination" id="sw-pagination"></div>
  </div>
</div>

<div class="modal-overlay" id="modal-setup">
  <div class="modal" style="max-width:440px">
    <div class="modal-title">Configuración inicial</div>
    <p style="font-size:13px;color:var(--text-dim);margin-bottom:16px">El sistema está usando las credenciales por defecto. Cámbialas antes de usar en producción.</p>
    <div style="background:var(--surface);border-radius:14px;padding:14px;margin-bottom:20px;font-family:var(--mono);font-size:13px;display:flex;flex-direction:column;gap:6px;box-shadow:var(--clay-in-sm)">
      <div><span style="color:var(--text-dim)">Email:</span> admin@smartmonitor.local</div>
      <div><span style="color:var(--text-dim)">Contraseña:</span> Admin2024!</div>
    </div>
    <div id="setup-pw-hint" style="font-size:11px;color:var(--text-dim);margin-bottom:2px"></div>
    <div style="display:flex;flex-direction:column;gap:10px">
      <input class="form-input" id="setup-current" type="password" placeholder="Contraseña actual" value="Admin2024!" />
      <input class="form-input" id="setup-new" type="password" placeholder="Nueva contraseña" />
      <input class="form-input" id="setup-confirm" type="password" placeholder="Confirmar nueva contraseña" />
      <p id="setup-error" style="color:var(--red);font-size:12px;display:none"></p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modal-setup')">Ahora no</button>
      <button class="btn btn-primary" onclick="doChangePassword()">Cambiar contraseña</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-history" onclick="if(event.target===this)closeModal('modal-history')">
  <div class="modal" style="max-width:860px;max-height:88vh;display:flex;flex-direction:column">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px">
      <div style="display:flex;gap:14px;align-items:flex-start">
        <div class="s-icon blue" style="width:48px;height:48px;border-radius:14px"><svg viewBox="0 0 24 24" fill="currentColor" style="width:24px;height:24px"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg></div>
        <div>
          <div class="modal-title" style="margin-bottom:2px" id="modal-history-title">Registro de actividad</div>
          <div style="font-size:12px;color:var(--text-dim)">Eventos registrados en este equipo</div>
        </div>
      </div>
      <button class="btn btn-sm btn-ghost" onclick="closeModal('modal-history')" style="width:34px;height:34px;padding:0;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">✕</button>
    </div>

    <div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap">
      <div class="sw-sort-wrap">
        <button class="btn btn-ghost sw-sort-btn" onclick="toggleHistMenu('hist-range-menu')" id="hist-range-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
          <span id="hist-range-label">Últimos 7 días</span>
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M7 10l5 5 5-5z"/></svg>
        </button>
        <div class="sw-sort-menu" id="hist-range-menu">
          <div class="sw-sort-item" onclick="setHistRange(1)">Últimas 24 horas</div>
          <div class="sw-sort-item" onclick="setHistRange(7)">Últimos 7 días</div>
          <div class="sw-sort-item" onclick="setHistRange(30)">Últimos 30 días</div>
          <div class="sw-sort-item" onclick="setHistRange(0)">Todo</div>
        </div>
      </div>
      <div class="sw-search-wrap" style="min-width:220px">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <input id="hist-search" class="form-input" placeholder="Buscar en el historial..." style="font-size:13px" oninput="onHistSearchInput(this.value)">
      </div>
      <div class="sw-sort-wrap">
        <button class="btn btn-ghost sw-sort-btn" onclick="toggleHistMenu('hist-filter-menu')" id="hist-filter-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>
          Filtros
        </button>
        <div class="sw-sort-menu" id="hist-filter-menu" style="min-width:220px;padding:8px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="offline" checked onchange="onHistFilterChange()"> Desconexiones</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="online" checked onchange="onHistFilterChange()"> Reconexiones</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="cpu_high" checked onchange="onHistFilterChange()"> CPU elevada</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="ram_high" checked onchange="onHistFilterChange()"> RAM elevada</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="disk_high" checked onchange="onHistFilterChange()"> Disco elevado</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="temp_high" checked onchange="onHistFilterChange()"> Temperatura elevada</label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--text-mid);padding:6px 8px"><input type="checkbox" class="hist-type-cb" value="os_change" checked onchange="onHistFilterChange()"> Cambio de sistema operativo</label>
        </div>
      </div>
    </div>

    <div class="sw-table-head">
      <div style="flex:1.6">Evento</div>
      <div style="width:140px">Motivo</div>
      <div style="width:100px">Fecha y hora</div>
      <div style="width:110px">Estado</div>
      <div style="width:16px"></div>
    </div>
    <div style="overflow-y:auto;flex:1" id="modal-history-list"></div>
    <div class="sw-pagination" id="hist-pagination"></div>
  </div>
</div>

<!-- Panel lateral: Historial del equipo (Asignaciones / Cambios de hardware / Eventos / Notas) -->
<div class="modal-overlay" id="modal-agent-history" onclick="if(event.target===this)closeModal('modal-agent-history')">
  <div class="side-panel">
    <div class="side-panel-header">
      <div style="display:flex;gap:12px;align-items:center">
        <div class="s-icon blue" style="width:40px;height:40px;border-radius:12px"><svg viewBox="0 0 24 24" fill="currentColor" style="width:20px;height:20px"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 1 1 7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg></div>
        <div class="modal-title" style="margin-bottom:0">Historial del equipo</div>
