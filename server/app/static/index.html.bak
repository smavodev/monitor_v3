      <button class="side-panel-tab" data-tab="hardware" onclick="setHistoryPanelTab('hardware')">Cambios de hardware</button>
      <button class="side-panel-tab" data-tab="events" onclick="setHistoryPanelTab('events')">Eventos</button>
