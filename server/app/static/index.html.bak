<script>
// ── State ──────────────────────────────────────────────────────────────────
// "Recordarme" desmarcado guarda el token en sessionStorage (se pierde al
// cerrar el navegador/pestaña) en vez de localStorage (persiste) - por eso
// hay que revisar los dos al arrancar, no solo localStorage.
let token = localStorage.getItem('sm_token') || sessionStorage.getItem('sm_token');
const _resetToken = new URLSearchParams(location.search).get('reset');
let currentUser = null;
let allAgents = [];
let currentAgentId = null;
let _lastInventorySig = null;
let _invFilterUserAssignments = null; // Map agent_id -> registro de asignación, del usuario filtrado en Inventario (null = sin filtro de usuario)
let _invFilterUserShowAll = false; // false = solo el equipo vigente de ese usuario; true = incluye los anteriores también
let areas = [];
let allUsers = [];
let evtSource = null;
let procLimit = parseInt(localStorage.getItem('sm_proc_limit') || '10');
let detailChart = null;
let currentChartRange = '1h';

// ── Auth ───────────────────────────────────────────────────────────────────
async function doLogin() {
  const email = document.getElementById('login-email').value;
  const pass  = document.getElementById('login-pass').value;
  const err   = document.getElementById('login-error');
  err.style.display = 'none';
  try {
    const r = await fetch('/api/auth/login', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({email, password: pass})
    });
    if (!r.ok) { err.textContent = 'Credenciales incorrectas'; err.style.display = 'block'; return; }
    const d = await r.json();
    token = d.token;
    // "Recordarme" desmarcado -> sessionStorage (se pierde al cerrar el
    // navegador); marcado (default) -> localStorage (persiste). Limpia el
    // otro almacen para no dejar un token viejo dando vueltas.
    if (document.getElementById('login-remember')?.checked !== false) {
      localStorage.setItem('sm_token', token);
      sessionStorage.removeItem('sm_token');
    } else {
      sessionStorage.setItem('sm_token', token);
      localStorage.removeItem('sm_token');
    }
    currentUser = {id: d.id, name: d.name, role_name: d.role_name, permissions: d.permissions || {}, must_change_password: d.must_change_password};
    await startApp();
    if (d.must_change_password) {
      openForceChangeModal();
    }
  } catch(e) { err.style.display = 'block'; }
}

function toggleLoginPassVisibility() {
  const input = document.getElementById('login-pass');
  input.type = input.type === 'password' ? 'text' : 'password';
}

function openForgotPasswordModal() {
  document.getElementById('forgot-email').value = document.getElementById('login-email').value || '';
  document.getElementById('forgot-form-fields').style.display = '';
  document.getElementById('forgot-success-msg').style.display = 'none';
  openModal('modal-forgot-password');
}

async function submitForgotPassword() {
  const email = document.getElementById('forgot-email').value.trim();
  if (!email) return;
  const btn = document.getElementById('forgot-submit-btn');
  btn.disabled = true;
  try {
    await fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({email}),
    });
  } catch (e) {}
  // La respuesta del server es siempre la misma exista o no la cuenta (no
  // revela si un email está registrado) - por eso acá mostramos el mismo
  // mensaje incluso si el fetch en sí falló de red, para no filtrar nada.
  btn.disabled = false;
  document.getElementById('forgot-form-fields').style.display = 'none';
  document.getElementById('forgot-success-msg').style.display = '';
}

async function submitResetPassword() {
  const pass1 = document.getElementById('reset-pass1').value;
  const pass2 = document.getElementById('reset-pass2').value;
  const err = document.getElementById('reset-error');
  err.style.display = 'none';
  if (!pass1 || pass1 !== pass2) {
    err.textContent = 'Las contraseñas no coinciden.';
    err.style.display = 'block';
    return;
  }
  try {
    const r = await fetch('/api/auth/reset-password', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({token: _resetToken, new_password: pass1}),
    });
    if (!r.ok) {
      const d = await r.json().catch(() => ({}));
      err.textContent = d.detail || 'No se pudo restablecer la contraseña.';
      err.style.display = 'block';
      return;
    }
    document.getElementById('reset-form-fields').style.display = 'none';
    document.getElementById('reset-success').style.display = '';
  } catch (e) {
    err.textContent = 'No se pudo contactar al servidor.';
    err.style.display = 'block';
  }
}

function backToLoginFromReset() {
  history.replaceState(null, '', location.pathname);
  document.getElementById('reset-view').style.display = 'none';
  document.getElementById('login-view').style.display = 'flex';
}

function doLogout() {
  localStorage.removeItem('sm_token');
  sessionStorage.removeItem('sm_token');
  token = null; currentUser = null;
  document.getElementById('login-view').style.display = 'flex';
  document.getElementById('app').style.display = 'none';
}

async function api(path, opts = {}) {
  const o = {...opts};
  if (o.body && typeof o.body === 'object' && !(o.body instanceof FormData)) {
    o.body = JSON.stringify(o.body);
  }
  const r = await fetch(path, {
    ...o,
    headers: {'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json', ...(opts.headers||{})}
  });
  if (r.status === 401) { doLogout(); return null; }
  if (!r.ok) {
    let detail = r.statusText;
    try { const j = await r.json(); detail = j.detail || JSON.stringify(j); } catch {}
    throw new Error(detail);
  }
  return r.json();
}

// ── App init ───────────────────────────────────────────────────────────────
async function doChangePassword() {
  const current = document.getElementById('setup-current').value;
  const nw      = document.getElementById('setup-new').value;
  const confirm = document.getElementById('setup-confirm').value;
  const err     = document.getElementById('setup-error');
  err.style.display = 'none';
  if (nw !== confirm) { err.textContent = 'Las contraseñas no coinciden.'; err.style.display = 'block'; return; }
  try {
    const r = await api('/api/auth/change-password', {method:'PUT', body: {current_password: current, new_password: nw}});
    if (!r) return;
    closeModal('modal-setup');
  } catch (e) {
    err.textContent = e.message || 'Error al cambiar contraseña.';
    err.style.display = 'block';
  }
}

// ── Permisos (nav gating según el rol del usuario) ──────────────────────────
const LEVEL_ORDER = {none: 0, view: 1, edit: 2, manage: 3};
const NAV_SECTION_MAP = {
  'nav-dashboard': 'dashboard',
  'nav-events': 'events',
  'nav-inventory': 'inventory',
  'nav-discovery': 'discovery',
  'nav-areas': 'areas',
  'nav-parental-categories': 'parental_categories',
  'nav-parental-blocked': 'parental_blocked',
  'nav-parental-schedule': 'parental_schedule',
  'nav-parental-attempts': 'parental_attempts',
  'nav-parental-tunnel': 'parental_attempts',
  'nav-users': 'users',
  'nav-roles': 'users',
  'nav-login-history': 'users',
  'nav-settings': 'settings',
};

// ── Selects buscables (equipos, usuarios: listas largas y tediosas de
// scrollear a mano). Envuelve un <select> ya existente con un input de
// texto que filtra las opciones al escribir - conserva el <select> original
// oculto en el DOM para que el resto del codigo (que lee/escribe .value y
// escucha "onchange") siga funcionando sin cambios. Idempotente: llamar de
// nuevo despues de repoblar las opciones solo refresca la etiqueta visible.
function enhanceSearchableSelect(selectId) {
  const select = document.getElementById(selectId);
  if (!select) return;

  if (select.dataset.searchable) {
    const input = select.parentNode.querySelector(':scope > input.searchable-select-input');
    if (input) {
      const opt = select.options[select.selectedIndex];
      input.value = opt ? opt.textContent : '';
    }
    return;
  }
  select.dataset.searchable = '1';
  // Si el select ya estaba oculto (ej. un modal que alterna equipo/area/global
  // y arranca en "area"), el envoltorio nuevo debe heredar ese estado - si no,
  // el buscador quedaria visible aunque el select que reemplaza no lo estaba.
  const wasHidden = select.style.display === 'none';

  const wrap = document.createElement('div');
  wrap.className = 'searchable-select-wrap';
  if (wasHidden) wrap.style.display = 'none';
  select.parentNode.insertBefore(wrap, select);
  wrap.appendChild(select);
  select.style.display = 'none';

  const input = document.createElement('input');
  input.type = 'text';
  input.className = 'form-input searchable-select-input';
  input.autocomplete = 'off';
  input.placeholder = 'Escribe para buscar...';
  wrap.appendChild(input);

  const list = document.createElement('div');
  list.className = 'searchable-select-list';
  wrap.appendChild(list);

  function renderList(filterText) {
    const q = (filterText || '').toLowerCase();
    const matches = [...select.options].filter(o => o.textContent.toLowerCase().includes(q));
    list.innerHTML = matches.length
      ? matches.map(o => `<div class="searchable-select-item${o.value === select.value ? ' selected' : ''}" data-value="${(o.value||'').replace(/"/g, '&quot;')}">${o.textContent}</div>`).join('')
      : '<div class="searchable-select-empty">Sin resultados</div>';
    list.querySelectorAll('.searchable-select-item').forEach(item => {
      item.addEventListener('mousedown', e => {
        e.preventDefault();
        select.value = item.dataset.value;
        input.value = item.textContent;
        list.classList.remove('open');
        select.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  }

  input.addEventListener('focus', () => { input.value = ''; renderList(''); list.classList.add('open'); });
  input.addEventListener('input', () => { renderList(input.value); list.classList.add('open'); });
  input.addEventListener('blur', () => {
    setTimeout(() => {
      list.classList.remove('open');
      const opt = select.options[select.selectedIndex];
      input.value = opt ? opt.textContent : '';
    }, 150);
  });

  const opt = select.options[select.selectedIndex];
  input.value = opt ? opt.textContent : '';
}

// Muestra/oculta un campo por id - si fue envuelto por enhanceSearchableSelect
// oculta el envoltorio completo (input+lista), no solo el <select> interno
// (que ya esta permanentemente oculto), para que no se quede el buscador
// visible cuando el campo deberia estar escondido (ej. cambia el alcance a
// "area" y el selector de equipo debe desaparecer del todo).
function setFieldVisible(fieldId, visible) {
  const el = document.getElementById(fieldId);
  if (!el) return;
  const wrap = el.closest('.searchable-select-wrap');
  (wrap || el).style.display = visible ? 'block' : 'none';
}

// ── Menú lateral colapsable ──────────────────────────────────────────────
function toggleSidenav() {
  const collapsed = !document.getElementById('sidenav').classList.contains('collapsed');
  setSidenavCollapsed(collapsed);
}
function setSidenavCollapsed(collapsed) {
  document.getElementById('sidenav').classList.toggle('collapsed', collapsed);
  document.getElementById('sidenav-reopen-btn').classList.toggle('visible', collapsed);
  localStorage.setItem('sm_sidenav_collapsed', collapsed ? '1' : '0');
}
if (localStorage.getItem('sm_sidenav_collapsed') === '1') {
  setSidenavCollapsed(true);
}

function hasPerm(section, minLevel = 'view') {
  const level = (currentUser.permissions || {})[section] || 'none';
  return LEVEL_ORDER[level] >= LEVEL_ORDER[minLevel];
}

function applyPermissionGating() {
  for (const [navId, section] of Object.entries(NAV_SECTION_MAP)) {
    const el = document.getElementById(navId);
    if (!el) continue;
    el.style.display = hasPerm(section, 'view') ? 'flex' : 'none';
  }
}

async function startApp() {
  document.getElementById('login-view').style.display = 'none';
  document.getElementById('app').style.display = 'flex';
  document.getElementById('app').style.flexDirection = 'row';
  document.getElementById('nav-username').textContent = currentUser.name;
  const _initials = currentUser.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
  document.getElementById('nav-avatar').textContent = _initials;
  document.getElementById('nav-userrole').textContent = currentUser.role_name || 'Usuario';

  applyPermissionGating();

  const assignedToggle = document.getElementById('dash-assigned-toggle');
  if (assignedToggle) assignedToggle.checked = _dashboardAssignedOnly;

  // fetchAgents() primero y aparte (no en el mismo Promise.all que
  // fetchSummary): applyDashboardSummary lee allAgents para "solo
  // asignados", asi que debe estar poblado antes de que fetchSummary corra.
  await fetchAgents();
  await Promise.all([fetchSummary(), fetchAreas()]);

  if (hasPerm('users', 'manage')) {
    const setup = await api('/api/auth/setup-status');
    if (setup && setup.is_default) {
      document.getElementById('setup-pw-hint').textContent = _passwordPolicyHintText(await _getPasswordPolicyCached());
      openModal('modal-setup');
    }
  }

  // Cargar intervalo de push desde el servidor y actualizar selector
  try {
    const cfg = await api('/api/config/interval');
    const interval = cfg.interval || 60;
    const sel = document.getElementById('push-interval-select');
    if (sel) {
      const opts = Array.from(sel.options).map(o => parseInt(o.value));
      const closest = opts.reduce((a, b) => Math.abs(b - interval) < Math.abs(a - interval) ? b : a);
      sel.value = String(closest);
    }
  } catch {}
  startSSE();

  const savedProc = localStorage.getItem('sm_proc_limit') || '10';
  const procSel = document.getElementById('proc-limit-select');
  if (procSel) procSel.value = savedProc;

  let savedView = localStorage.getItem('sm_view') || 'dashboard';
  if (savedView === 'sedes' || savedView === 'services' || savedView === 'blocked') savedView = 'dashboard';
  showView(savedView);
}

function setProcLimit(val) {
  procLimit = parseInt(val);
  localStorage.setItem('sm_proc_limit', val);
  // Re-renderizar procesos si hay un agente abierto
  if (currentAgentId) {
    const a = allAgents.find(x => x.id === currentAgentId);
    if (a) renderProcesses(a.top_processes, 'd-processes', null);
  }
  // Re-renderizar tarjetas del dashboard
  renderAgents(allAgents);
}

async function manualRefresh() {
  await fetchAgents();
  await fetchSummary();
}

// ── Intervalo de reporte del agente ───────────────────────────────────────
function setPushInterval(val) {
  const secs = Math.max(60, parseInt(val) || 60);
  api('/api/config/interval', {method:'PUT', body:JSON.stringify({interval: secs})}).catch(()=>{});
}

// ── Intervalo de revision de bloqueo (independiente del de metricas) ──────
function setBlocklistInterval(val) {
  const secs = Math.max(60, Math.min(1800, parseInt(val) || 60));
  api('/api/config/blocklist-interval', {method:'PUT', body:JSON.stringify({interval: secs})}).catch(()=>{});
}

function startSSE() {
  if (evtSource) { evtSource.close(); }
  const sseUrl = `/api/agents/stream?token=${encodeURIComponent(token)}&interval=2`;
  evtSource = new EventSource(sseUrl);

  evtSource.onmessage = (e) => {
    try {
      const d = JSON.parse(e.data);
      // Mostrar última hora en que un agente envió datos
      const el = document.getElementById('last-update');
      if (el) {
        const online = d.agents.filter(a => a.status === 'online' && a.last_seen_ago != null);
        if (online.length) {
          const minAgo = Math.min(...online.map(a => a.last_seen_ago));
          const lastSeen = new Date(Date.now() - minAgo * 1000);
          const ts = `${lastSeen.getHours().toString().padStart(2,'0')}:${lastSeen.getMinutes().toString().padStart(2,'0')}:${lastSeen.getSeconds().toString().padStart(2,'0')}`;
          el.textContent = `Última Actualización ${ts}`;
        }
      }

      // Actualizar agentes. El Inventario NO se refresca solo con el vivo del
      // SSE (a diferencia del Dashboard) — ahí tiene sentido ver todo en
      // tiempo real, pero en Inventario es una vista de referencia/gestión y
      // el refresco constante solo causaba parpadeo. Se actualiza al entrar
      // a la vista o tras una acción real (fetchAgents ya lo hace).
      allAgents = d.agents;
      renderAgents(allAgents);
      if (currentAgentId) {
        const fresh = allAgents.find(a => a.id === currentAgentId);
        if (fresh) updateDetailMetrics(fresh);
      }

      // Actualizar summary (allAgents ya se actualizo arriba, con lo cual
      // applyDashboardSummary puede recalcular sobre "solo asignados" si
      // ese interruptor esta prendido)
      applyDashboardSummary(d.summary);
    } catch {}
  };

  evtSource.onerror = () => {
    evtSource.close(); evtSource = null;
    // Reintentar SSE en 5s
    setTimeout(startSSE, 5000);
  };
}

// ── Views ──────────────────────────────────────────────────────────────────
let attemptsAutoRefreshTimer = null;

function showView(name) {
  if (attemptsAutoRefreshTimer) { clearInterval(attemptsAutoRefreshTimer); attemptsAutoRefreshTimer = null; }
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(t => t.classList.remove('active'));
  const viewEl = document.getElementById(`view-${name}`);
  if (viewEl) viewEl.classList.add('active');
  const navEl = document.getElementById(`nav-${name}`);
  if (navEl) navEl.classList.add('active');
   const saveable = ['dashboard','inventory','events','discovery','users','roles','login-history','areas','parental-categories','parental-blocked','parental-schedule','parental-attempts','parental-tunnel','settings'];
  if (saveable.includes(name)) localStorage.setItem('sm_view', name);

  if (name === 'inventory')  { renderInventory(); fetchUsers().then(renderInventory); fetchAssetTypes().then(fetchAssets); }
  if (name === 'events')     fetchGlobalEvents();
  if (name === 'users')      fetchUsers();
  if (name === 'roles')      fetchRoles();
  if (name === 'login-history') fetchLoginHistory();
  if (name === 'areas')      renderAreas();
  if (name === 'parental-blocked') { fetchBlockedSites(); refreshNetworkGateButton(); }
  if (name === 'parental-categories') fetchParentalCategories();
  if (name === 'parental-schedule') { fetchDefaultSchedule(); fetchScheduleOverrides(); fetchAreaSchedules(); }
  if (name === 'parental-attempts') { initBlockAttempts(); attemptsAutoRefreshTimer = setInterval(fetchBlockAttempts, 10000); }
  if (name === 'parental-tunnel') fetchWireguardTunnel();
  if (name === 'settings')   { fetchPasswordPolicy(); loadSettings(); }
  if (name === 'discovery')  _initDiscovery();
}

// ── Helpers ────────────────────────────────────────────────────────────────
function metricClass(v, w=70, c=85) { return v>=c?'crit':v>=w?'warn':'ok'; }
function colorVar(c) { return c==='crit'?'var(--red)':c==='warn'?'var(--yellow)':'var(--green)'; }
function fmtAgo(s) { if(s<60)return`hace ${s}s`;if(s<3600)return`hace ${Math.floor(s/60)}m`;return`hace ${Math.floor(s/3600)}h`; }
function fmtAgoLive(s) { s=Math.max(0,Math.floor(s||0)); if(s<60)return`hace ${s}s`; if(s<3600)return`hace ${Math.floor(s/60)}m ${s%60}s`; if(s<86400){const h=Math.floor(s/3600),m=Math.floor((s%3600)/60);return`hace ${h}h ${m}m`;} const d=Math.floor(s/86400),h=Math.floor((s%86400)/3600);return`hace ${d}d ${h}h`; }
function fmtUptime(s) { if(!s)return'--';const d=Math.floor(s/86400),h=Math.floor((s%86400)/3600);return d>0?`${d}d ${h}h`:`${h}h`; }

// ── Offline live tick: actualiza el tiempo "Sin conexión" cada segundo ───────
let _offlineTick = 0;
let _offlineTimer = null;
function startOfflineLiveTick() {
  if (_offlineTimer) return;
  _offlineTimer = setInterval(() => {
    _offlineTick++;
    const data = allAgents || [];
    const offlineCards = document.querySelectorAll('.agent-card.offline');
    offlineCards.forEach(card => {
      const id = card.getAttribute('onclick')?.match(/'([^']+)'/)?.[1];
      const a = data.find(x => x.id === id);
      if (!a || a.last_seen_ago == null) return;
      const meta = card.querySelector('.agent-meta');
      if (meta) meta.textContent = `Sin conexión · ${fmtAgoLive(a.last_seen_ago + _offlineTick)}`;
    });
    // Alertas offline con tiempo en vivo
    document.querySelectorAll('.alert-item[data-alert-id]').forEach(item => {
      const id = item.getAttribute('data-alert-id');
      const a = data.find(x => x.id === id);
      if (!a || a.last_seen_ago == null) return;
      const host = a.hostname || (a.display_name || '');
      item.innerHTML = alertRowInner('⬛', host, '', `Sin conexión ${fmtAgoLive(a.last_seen_ago + _offlineTick)}`);
    });
  }, 1000);
}
function stopOfflineLiveTick() {
  if (_offlineTimer) { clearInterval(_offlineTimer); _offlineTimer = null; }
  _offlineTick = 0;
}
// Genera el HTML de un item de alerta; para offline muestra tiempo en vivo.
function alertLiveText(al) {
  if (al.type === 'offline') {
    // Solo por id: el hostname puede repetirse entre equipos distintos, así
    // que emparejar por nombre podría mostrar el tiempo "sin conexión" de
    // OTRO equipo con el mismo nombre.
    const ag = (allAgents || []).find(x => x.id === al.id);
    if (ag && ag.last_seen_ago != null) return `Sin conexión ${fmtAgoLive(ag.last_seen_ago + _offlineTick)}`;
  }
  return al.detail;
}
function alertRowInner(icon, hostname, timeLabel, detail) {
  return `<div class="alert-icon">${icon}</div>
    <div class="alert-body">
      <div class="alert-body-top">
        <span class="alert-body-host">${hostname}</span>
        <span class="alert-body-time">${timeLabel}</span>
      </div>
      <div class="alert-body-detail">${detail}</div>
    </div>`;
}
function alertItemHTML(al) {
  const attr = (al.type === 'offline' && al.id != null) ? ` data-alert-id="${al.id}"` : '';
  const icon = eventIcons[al.type] || '⚠️';
  const timeLabel = al.timestamp ? fmtAgo(Math.max(0, Math.floor((Date.now() - new Date(al.timestamp).getTime())/1000))) : '';
  return `<div class="alert-item"${attr}>${alertRowInner(icon, al.hostname, timeLabel, alertLiveText(al))}</div>`;
}
function tempClass(t) { if(!t)return'ok';return t>85?'crit':t>70?'warn':'ok'; }

// Lista de alertas tipo notificaciones: no ocupa espacio permanente - un
// contador (en la campana fija del sidebar, visible desde cualquier vista, y
// tambien en la tarjeta "Alertas activas" del Dashboard) y la lista completa
// se abre al hacer clic en cualquiera de los dos triggers, como panel
// flotante. Pensado tambien para 100-200 equipos: antes esta lista siempre
// visible podia empujar todo el resto del dashboard hacia abajo.
let _lastAlerts = [];
let _alertPanelOpen = false;
let _seenAlertKeys = null; // null = todavia no se cargo nunca (evita toastear todo lo ya activo al abrir la pagina)
function renderAlertList(alerts) {
  _lastAlerts = alerts || [];
  const hasAlerts = _lastAlerts.length > 0;
  const countEl = document.getElementById('nav-alert-count');
  if (countEl) {
    countEl.textContent = _lastAlerts.length;
    countEl.style.display = hasAlerts ? '' : 'none';
  }
  document.getElementById('alert-list').innerHTML = hasAlerts
    ? _lastAlerts.map(alertItemHTML).join('')
    : `<div class="alert-empty">Sin alertas activas</div>`;
  updateAlertPanelVisibility();

  // Toast solo para alertas NUEVAS (id+tipo, no por cada reporte repetido
  // mientras el mismo incidente sigue activo) - se compara contra lo visto
  // en el refresco anterior, nunca contra todo el historial.
  const currentKeys = new Set(_lastAlerts.map(al => `${al.id}-${al.type}`));
  if (_seenAlertKeys) {
    for (const al of _lastAlerts) {
      if (!_seenAlertKeys.has(`${al.id}-${al.type}`)) showAlertToast(al);
    }
  }
  _seenAlertKeys = currentKeys;
}
function updateAlertPanelVisibility() {
  const banner = document.getElementById('alert-banner');
  banner.classList.toggle('visible', _alertPanelOpen);
}
function toggleAlertPanel() {
  _alertPanelOpen = !_alertPanelOpen;
  if (_alertPanelOpen) {
    // Ancla el panel justo debajo del icono que lo abrio (estilo Outlook),
    // en vez de una posicion fija - asi se acomoda solo si el layout cambia.
    const rect = document.getElementById('alert-trigger').getBoundingClientRect();
    const banner = document.getElementById('alert-banner');
    banner.style.top = `${rect.bottom + 8}px`;
    banner.style.right = `${Math.max(8, window.innerWidth - rect.right)}px`;
    banner.style.left = 'auto';
  }
  updateAlertPanelVisibility();
}
// Notificacion tipo toast: aparece unos segundos y se desvanece sola
function showAlertToast(al) {
  const container = document.getElementById('toast-container');
  if (!container) return;
  const el = document.createElement('div');
  el.className = 'toast-item';
  el.innerHTML = alertRowInner(eventIcons[al.type] || '⚠️', al.hostname, '', al.detail);
  container.appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => {
    el.classList.remove('show');
    setTimeout(() => el.remove(), 300);
  }, 6000);
}
// Recordatorio periodico: si siguen existiendo alertas activas, se vuelven a
// mostrar como toast cada 5 minutos sin importar la seccion en la que este
// el usuario - por si no vio la primera vez que aparecieron.
setInterval(() => {
  _lastAlerts.forEach(al => showAlertToast(al));
}, 5 * 60 * 1000);
// Cierra el panel si se hace clic afuera (patron estandar de notificaciones)
document.addEventListener('click', (e) => {
  if (!_alertPanelOpen) return;
  if (e.target.closest('#alert-banner') || e.target.closest('#alert-trigger') || e.target.closest('#nav-alert-bell')) return;
  _alertPanelOpen = false;
  updateAlertPanelVisibility();
});

// ── Summary ────────────────────────────────────────────────────────────────
// Pinta las tarjetas de resumen + panel de alertas. Si "Solo asignados" esta
// prendido, recalcula total/online/offline/alertas SOLO con lo que hay en
// allAgents que este asignado, en vez de confiar en los numeros del backend
// (que siempre son de TODOS los equipos) - por eso quien llame a esto debe
// asegurarse de que allAgents ya este actualizado primero.
function applyDashboardSummary(summary) {
  let total = summary.total, online = summary.online, offline = summary.offline, alerts = summary.alerts;
  if (_dashboardAssignedOnly) {
    const assigned = (allAgents || []).filter(_isAssigned);
    const assignedIds = new Set(assigned.map(a => a.id));
    total   = assigned.length;
    online  = assigned.filter(a => a.status === 'online').length;
    offline = assigned.filter(a => a.status === 'offline').length;
    alerts  = alerts.filter(al => assignedIds.has(al.id));
  }
  document.getElementById('s-total').textContent   = total;
  document.getElementById('s-online').textContent  = online;
  document.getElementById('s-offline').textContent = offline;
  document.getElementById('s-alerts').textContent  = alerts.length;
  const offBadge = document.getElementById('nav-badge-offline');
  if (offBadge) { if (offline > 0) { offBadge.textContent = offline; offBadge.style.display = ''; } else { offBadge.style.display = 'none'; } }
  renderAlertList(alerts);
}

async function fetchSummary() {
  const d = await api('/api/agents/summary/global');
  if (!d) return;
  applyDashboardSummary(d);
}

// ── Agents ─────────────────────────────────────────────────────────────────
async function fetchAgents() {
  const data = await api('/api/agents');
  if (!data) return;
  allAgents = data;
  const now = new Date();
  const ts = `${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}`;
  const el = document.getElementById('last-update');
  if (el && !evtSource) el.textContent = `Actualizado ${ts}`;
  renderAgents(allAgents);
  if (document.getElementById('view-inventory').classList.contains('active')) renderInventory();
  if (currentAgentId) {
    const fresh = allAgents.find(a => a.id === currentAgentId);
    if (fresh) updateDetailMetrics(fresh);
  }
}

// Filtro de estado del Dashboard: las tarjetas "Total equipos"/"En línea"/
// "Sin conexión" funcionan como filtros de la grilla de equipos - clic de
// nuevo en la misma tarjeta activa vuelve a "todos".
let _dashboardStatusFilter = 'all';
function setDashboardFilter(status) {
  _dashboardStatusFilter = (_dashboardStatusFilter === status) ? 'all' : status;
  document.querySelectorAll('.filter-card').forEach(c => c.classList.remove('filter-active'));
  document.getElementById(`filter-card-${_dashboardStatusFilter}`)?.classList.add('filter-active');
  filterAgents();
}

// Interruptor "Solo asignados": preferencia PERSONAL guardada en este
// navegador (no toca nada del servidor) - cuando esta prendido, tanto la
// grilla de equipos como las tarjetas de resumen y el panel de alertas que
// VE este usuario se recalculan solo sobre equipos con assigned_user (y sin
// devolver). Los correos/Telegram de Configuración siguen siendo para TODOS
// los equipos siempre, sin importar este interruptor.
let _dashboardAssignedOnly = localStorage.getItem('sm_dashboard_assigned_only') === '1';
function _isAssigned(a) {
  return !!(a.assigned_user && !a.returned_at);
}
function toggleAssignedOnlyFilter() {
  _dashboardAssignedOnly = document.getElementById('dash-assigned-toggle').checked;
  localStorage.setItem('sm_dashboard_assigned_only', _dashboardAssignedOnly ? '1' : '0');
  filterAgents();
  fetchSummary();
}

function renderAgents(agents) {
  // La busqueda se aplica ACA (no solo en filterAgents) para que sobreviva
  // a los refrescos en vivo del SSE, que llaman renderAgents(allAgents)
  // directo cada ~2s - si el filtro de busqueda solo vivia en filterAgents,
  // cada refresco en vivo lo pisaba y la busqueda parecia "no funcionar".
  const q = (document.getElementById('search-input')?.value || '').toLowerCase().trim();
  if (q) {
    agents = agents.filter(a =>
      (a.display_name||a.hostname||'').toLowerCase().includes(q) ||
      (a.sede||'').toLowerCase().includes(q) ||
      (a.serial_number||'').toLowerCase().includes(q)
    );
  }
  if (_dashboardAssignedOnly) {
    agents = agents.filter(_isAssigned);
  }
  if (_dashboardStatusFilter !== 'all') {
    agents = agents.filter(a => a.status === _dashboardStatusFilter);
  }
  _offlineTick = 0;
  const grid = document.getElementById('agents-grid');
  startOfflineLiveTick();
  if (!agents.length) {
    grid.innerHTML = `<div class="empty" style="grid-column:1/-1">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6H4v14h16V6z"/></svg>
      <h3>Sin equipos registrados</h3>
      <p>Instala el agente en los equipos a monitorear</p></div>`;
    return;
  }
  grid.innerHTML = agents.map(a => {
    const cc = metricClass(a.cpu_percent), rc = metricClass(a.ram_percent), dc = metricClass(a.disk_percent,80,90);
    const warn = cc!=='ok'||rc!=='ok'||dc!=='ok';
    const card = a.status==='offline'?'offline':warn?'warning':'';
    const temp = a.cpu_temp ? ` · 🌡 ${a.cpu_temp.toFixed(0)}°C` : '';
    const lat  = a.latency_ms != null ? ` · ${a.latency_ms.toFixed(0)}ms` : '';
    const meta = a.status==='offline'
      ? `Sin conexión · ${fmtAgoLive(a.last_seen_ago)}`
      : `${a.os||'linux'}${temp}${lat} · ${fmtAgo(a.last_seen_ago)}`;
    // Punto verde/rojo: estado del tunel WireGuard (no de si el equipo esta
    // online/offline en general, esa ya la muestra el badge de al lado) -
    // mismo criterio que la pestana "Tunel WireGuard" de Control Parental.
    const tunnelOk = a.tailnet_ip && a.status === 'online';
    const tunnelTitle = tunnelOk ? 'Túnel WireGuard: conectado'
      : a.tailnet_ip ? 'Túnel WireGuard: desconectado (equipo sin reportar)'
      : 'Túnel WireGuard: no conectado';
    return `<div class="agent-card ${card}" onclick="openDetail('${a.id}')">
      <div class="agent-header">
        <div>
          <div class="agent-name">${a.display_name||a.hostname}</div>
          <div class="agent-meta">${meta}</div>
        </div>
        <div style="display:flex;align-items:center;gap:6px">
          <span class="tunnel-dot ${tunnelOk?'on':'off'}" title="${tunnelTitle}"></span>
          <span class="badge ${a.status}">${a.status==='online'?'Online':'Offline'}</span>
        </div>
      </div>
      <div class="metrics">
        ${metricRow('CPU', a.cpu_percent, cc)}
        ${metricRow('RAM', a.ram_percent, rc, `${(a.ram_used_gb||0).toFixed(1)}/${(a.ram_total_gb||0).toFixed(1)} GB`)}
        ${metricRow('Disco', a.disk_percent, dc)}
      </div>
    </div>`;
  }).join('');
}

function metricRow(label, val, cls, detail='') {
  const pct = Math.min(val||0, 100);
  return `<div class="metric-row">
    <div class="metric-label-row">
      <span class="metric-label">${label}</span>
      <span class="metric-val ${cls}">${pct.toFixed(1)}%${detail?` <span style="color:var(--text-dim);font-size:10px">${detail}</span>`:''}</span>
    </div>
    <div class="bar-track"><div class="bar-fill ${cls}" style="width:${pct}%"></div></div>
  </div>`;
}

function filterAgents() {
  renderAgents(allAgents);
}

// ── Detail ─────────────────────────────────────────────────────────────────
async function openDetail(agentId) {
  currentAgentId = agentId;
  showView('detail');
  const a = allAgents.find(x => x.id === agentId);
  if (a) updateDetailMetrics(a);

  // Cargar detalle completo (hardware, discos)
  const detail = await api(`/api/agents/${agentId}`);
  if (detail) {
    document.getElementById('d-manufacturer').textContent = detail.manufacturer || '--';
    document.getElementById('d-model').textContent        = detail.model || '--';
    const screenRow = document.getElementById('d-screen-size-row');
    if (detail.screen_size_in) {
      screenRow.style.display = '';
      document.getElementById('d-screen-size').textContent = `${detail.screen_size_in}"`;
    } else {
      screenRow.style.display = 'none';
    }
    document.getElementById('d-serial').textContent       = detail.serial_number || '--';
    document.getElementById('d-os').textContent           = `${detail.os||'--'} ${detail.os_version||''}`;
    document.getElementById('d-cpu-model').textContent    = detail.cpu_model || '--';
    document.getElementById('d-cpu-cores').textContent    = detail.cpu_cores ? `${detail.cpu_cores} núcleos` : '--';
    document.getElementById('d-ram-total').textContent    = detail.ram_total_gb ? `${detail.ram_total_gb.toFixed(1)} GB` : '--';
    // Un disco fisico -> una fila: %, usado/total (tamano REAL de hardware,
    // ver PhysicalDisk en el backend) y cuantas particiones tiene. Si el
    // agente instalado todavia no manda physical_disks (no reinstalado),
    // se cae a sumar detail.disks como respaldo aproximado.
    const diskEl = document.getElementById('d-disk-total');
    const physicalDisks = detail.physical_disks || [];
    function physicalDiskRowHTML(pd) {
      const dc = metricClass(pd.percent, 80, 90);
      const partLabel = pd.partitions === 1 ? '1 partición' : `${pd.partitions} particiones`;
      return `<div style="margin-bottom:8px">
        <span style="color:${colorVar(dc)};font-weight:700">${pd.percent.toFixed(0)}%</span>
        <span style="color:var(--text-dim);font-size:11px;margin-left:8px">${pd.used_gb.toFixed(0)} / ${pd.total_gb.toFixed(0)} GB</span>
        <span style="color:var(--text-dim);font-size:11px;margin-left:8px">· ${partLabel}</span>
        <div class="bar-track" style="margin-top:5px;max-width:160px"><div class="bar-fill ${dc}" style="width:${pd.percent}%"></div></div>
      </div>`;
    }
    if (physicalDisks.length) {
      diskEl.innerHTML = physicalDisks.map(physicalDiskRowHTML).join('');
    } else {
      // Respaldo para agentes viejos (sin physical_disks todavia): suma
      // detail.disks, con un filtro de sanidad para no dejar que una unidad
      // de red mapeada con capacidad absurda (>5 TB, visto en produccion:
      // 100,000 GB) arruine el total.
      const disksList = detail.disks || [];
      if (disksList.length) {
        const SANE_MAX_GB = 5000;
        const saneDisks = disksList.filter(d => (d.total_gb || 0) <= SANE_MAX_GB);
        const source = saneDisks.length ? saneDisks : disksList;
        const totalGb = source.reduce((s, d) => s + (d.total_gb || 0), 0);
        const usedGb  = source.reduce((s, d) => s + (d.used_gb || 0), 0);
        const pct = totalGb > 0 ? (usedGb / totalGb * 100) : 0;
        diskEl.innerHTML = physicalDiskRowHTML({ percent: pct, used_gb: usedGb, total_gb: totalGb, partitions: disksList.length });
      } else {
        diskEl.textContent = '--';
      }
    }
    document.getElementById('d-ram-slots').textContent = detail.ram_slots_total
      ? `${detail.ram_slots_used||'?'} usada${detail.ram_slots_used!==1?'s':''} / ${detail.ram_slots_total} total`
      : '--';
    // Detalle por ranura
    const slotsData = detail.ram_slots_detail || [];
    const detailRow = document.getElementById('d-ram-slots-detail-row');
    const detailEl  = document.getElementById('d-ram-slots-detail');
    if (slotsData.length) {
      detailRow.style.display = '';
      detailEl.innerHTML = `<div class="ram-slot-grid">${slotsData.map(s => {
        if (s.installed) {
          const sub = [s.type, s.speed, s.manufacturer].filter(Boolean).join(' · ');
          return `<div class="ram-slot installed">
            <div class="ram-slot-size">${s.size_gb} GB</div>
            <div class="ram-slot-info">
              <div class="ram-slot-name">${s.slot}</div>
              ${sub ? `<div class="ram-slot-detail">${sub}</div>` : ''}
            </div>
          </div>`;
        } else {
          return `<div class="ram-slot empty">
            <div class="ram-slot-empty-size">Vacía</div>
            <div class="ram-slot-name">${s.slot}</div>
          </div>`;
        }
      }).join('')}</div>`;
    } else {
      detailRow.style.display = 'none';
    }
    document.getElementById('d-sede').textContent         = a?.sede || '--';
    document.getElementById('d-notes').textContent        = detail.notes || '--';

  }

  // Historial
  currentChartRange = '1h';
  document.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('.range-btn')?.classList.add('active');
  const hist = await api(`/api/agents/${agentId}/history?range=1h`);
  if (hist) renderChart(hist);

  // Uptime 7 días
  const uptime = await api(`/api/agents/${agentId}/uptime?days=7`);
  if (uptime) {
    const el = document.getElementById('d-uptime');
    if (el) el.textContent = `${(uptime.uptime_pct||0).toFixed(1)}%`;
  }
}

function renderProcesses(procs, tbodyId, countId) {
  const tbody = document.getElementById(tbodyId);
  const countEl = countId ? document.getElementById(countId) : null;
  if (!procs || !procs.length) {
    tbody.innerHTML = '<tr><td colspan="5" style="color:var(--text-dim);font-size:12px;padding:20px 0;text-align:center">Sin datos de procesos</td></tr>';
    if (countEl) countEl.textContent = 'Sin datos';
    return;
  }
  if (countEl) countEl.textContent = `${procs.length} proceso${procs.length!==1?'s':''}`;
  tbody.innerHTML = procs.slice(0, procLimit).map(p => {
    const cpu = Math.min(p.cpu||0, 100);
    const mem = (p.mem != null) ? Math.min(p.mem, 100) : null;
    const cpuCls = cpu>=50?'crit':cpu>=20?'warn':'ok';
    const col = colorVar(cpuCls);
    const badge = cpu>=50
      ? '<span class="proc-badge high">Alto</span>'
      : cpu>=20 ? '<span class="proc-badge med">Medio</span>' : '';
    const memBar = mem!=null
      ? `<div class="proc-bar-track"><div class="proc-bar-fill" style="width:${mem}%;background:var(--purple)"></div></div>`
      : '<span style="color:var(--text-dim);font-size:11px;font-family:var(--mono)">N/D</span>';
    const memVal = mem!=null
      ? `<span style="color:var(--purple);font-family:var(--mono);font-weight:600">${mem.toFixed(1)}%</span>`
      : '<span style="color:var(--text-dim)">--</span>';
    return `<tr>
      <td><span class="proc-name-cell">${p.name||'--'}</span>${badge}</td>
      <td><div class="proc-bar-track"><div class="proc-bar-fill" style="width:${cpu}%;background:${col}"></div></div></td>
      <td>${memBar}</td>
      <td style="text-align:right;color:${col};font-weight:600;font-family:var(--mono)">${cpu.toFixed(1)}%</td>
      <td style="text-align:right">${memVal}</td>
    </tr>`;
  }).join('');
}

function updateDetailMetrics(a) {
  document.getElementById('d-title').textContent = a.display_name || a.hostname;
  document.getElementById('d-sub').textContent   = `${a.hostname} · ${a.os||'linux'} · ${fmtAgo(a.last_seen_ago)}`;
  document.getElementById('d-status-badge').textContent = a.status==='online'?'Online':'Offline';
  document.getElementById('d-status-badge').className   = `badge ${a.status}`;

  const cc = metricClass(a.cpu_percent), rc = metricClass(a.ram_percent), tc = tempClass(a.cpu_temp);
  document.getElementById('d-cpu').textContent  = `${(a.cpu_percent||0).toFixed(1)}%`;
  document.getElementById('d-cpu').style.color  = colorVar(cc);
  document.getElementById('d-ram').textContent  = `${(a.ram_percent||0).toFixed(1)}%`;
  document.getElementById('d-ram').style.color  = colorVar(rc);
  document.getElementById('d-ram-sub').textContent = `${(a.ram_used_gb||0).toFixed(1)} / ${(a.ram_total_gb||0).toFixed(1)} GB`;
  document.getElementById('d-temp').textContent = a.cpu_temp ? `${a.cpu_temp.toFixed(0)}°C` : 'N/D';
  document.getElementById('d-temp').style.color = colorVar(tc);
  document.getElementById('d-rx').textContent   = `${(a.net_rx_mb||0).toFixed(1)} MB`;
  document.getElementById('d-tx').textContent   = `${(a.net_tx_mb||0).toFixed(1)} MB`;

  // Latencia
  const latEl = document.getElementById('d-latency');
  if (a.latency_ms != null) {
    const latCls = a.latency_ms > 100 ? 'latency-crit' : a.latency_ms > 50 ? 'latency-warn' : 'latency-ok';
    latEl.textContent = `${a.latency_ms.toFixed(0)} ms`;
    latEl.className = `big-metric-val ${latCls}`;
  } else {
    latEl.textContent = 'N/D';
    latEl.className = 'big-metric-val';
    latEl.style.color = '';
  }

  renderProcesses(a.top_processes, 'd-processes', null);
}

function renderChart(hist) {
  const canvas = document.getElementById('detail-chart');
  if (!canvas) return;
  if (detailChart) { detailChart.destroy(); detailChart = null; }
  if (!hist || !hist.length) return;

  const labels = hist.map(h => {
    const d = new Date(h.t);
    return `${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
  });

  detailChart = new Chart(canvas, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label:'CPU %',   data: hist.map(h=>h.cpu),  borderColor:'#3b82f6', backgroundColor:'rgba(59,130,246,0.07)', borderWidth:1.5, pointRadius:0, tension:0.3, yAxisID:'y' },
        { label:'RAM %',   data: hist.map(h=>h.ram),  borderColor:'#10b981', backgroundColor:'rgba(16,185,129,0.07)', borderWidth:1.5, pointRadius:0, tension:0.3, yAxisID:'y' },
        { label:'Disco %', data: hist.map(h=>h.disk), borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,0.07)',  borderWidth:1.5, pointRadius:0, tension:0.3, yAxisID:'y' },
        { label:'Temp °C', data: hist.map(h=>h.temp), borderColor:'#ef4444', backgroundColor:'rgba(239,68,68,0.07)',  borderWidth:1.5, pointRadius:0, tension:0.3, yAxisID:'y2', hidden: hist.every(h=>!h.temp) },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false, animation: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: { display:false },
        tooltip: { backgroundColor:'#1a2235', titleColor:'#94a3b8', bodyColor:'#e2e8f0', borderColor:'#1e2d45', borderWidth:1, padding:10 }
      },
      scales: {
        x: { ticks:{ color:'#64748b', maxTicksLimit:8, font:{size:10} }, grid:{ color:'rgba(30,45,69,0.8)' } },
        y:  { min:0, max:100, ticks:{ color:'#64748b', font:{size:10}, callback:v=>`${v}%` }, grid:{ color:'rgba(30,45,69,0.8)' } },
        y2: { min:0, position:'right', ticks:{ color:'#ef4444', font:{size:10}, callback:v=>`${v}°` }, grid:{ display:false } },
      }
    }
  });
}

async function setChartRange(range, btn) {
  currentChartRange = range;
  document.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  if (!currentAgentId) return;
  const hist = await api(`/api/agents/${currentAgentId}/history?range=${range}`);
  if (hist) renderChart(hist);
}

const eventIcons = {offline:'⬛',online:'✅',cpu_high:'🔥',ram_high:'💾',disk_high:'💿',temp_high:'🌡',exception_created:'🔓',
  asset_created:'📦',asset_status_changed:'🔄',asset_assigned:'➕',asset_returned:'↩️',asset_stock_added:'📈',asset_linked:'🔗'};
function fmtDatetime(ts) {
  const d = new Date(ts + 'Z');
  const pad = n => String(n).padStart(2,'0');
  return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

// ── Iconos SVG por tipo de evento, solo para el modal de Registro de
// actividad (el resto del panel - alertas, tabla global - sigue usando el
// emoji de eventIcons, no se toca) ──────────────────────────────────────────
const HIST_ICON_PATHS = {
  offline: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z',
  online: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z',
  cpu_high: 'M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z',
  ram_high: 'M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z',
  disk_high: 'M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z',
  temp_high: 'M15 13V5c0-1.66-1.34-3-3-3S9 3.34 9 5v8c-1.21.91-2 2.37-2 4 0 2.76 2.24 5 5 5s5-2.24 5-5c0-1.63-.79-3.09-2-4z',
  exception_created: 'M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z',
  os_change: 'M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z',
};
const HIST_ICON_COLOR = {offline:'red', online:'green', cpu_high:'yellow', ram_high:'blue', disk_high:'purple', temp_high:'yellow', exception_created:'purple', os_change:'blue'};

function eventMeta(type) {
  return {path: HIST_ICON_PATHS[type] || HIST_ICON_PATHS.exception_created, color: HIST_ICON_COLOR[type] || 'blue'};
}

// Unico punto de verdad para "estado" en el Registro de actividad - deriva de
// los mismos campos que ya existen (type, resolved), no agrega nada nuevo del
// lado del servidor.
function eventStatus(e) {
  if (e.type === 'online') return {label: 'Conectado', color: 'var(--green)'};
  if (e.resolved) return {label: 'Resuelto', color: 'var(--green)'};
  if (e.type === 'offline') return {label: 'Sin reporte', color: 'var(--red)'};
  if (['cpu_high','ram_high','disk_high','temp_high'].includes(e.type)) return {label: 'Alerta', color: 'var(--yellow)'};
  return {label: '--', color: 'var(--text-dim)'};
}

let histCache = [];
let histRangeDays = 7;
let histPage = 1;
const HIST_PAGE_SIZE = 10;

function renderEvents(events, containerId) {
  histCache = events;
  histPage = 1;
  _renderHistPage(containerId);
}

function _renderHistPage(containerId) {
  const el = document.getElementById(containerId || 'modal-history-list');
  const pag = document.getElementById('hist-pagination');
  const q = (document.getElementById('hist-search')?.value || '').toLowerCase();
  const activeTypes = new Set(Array.from(document.querySelectorAll('.hist-type-cb:checked')).map(cb => cb.value));
  const cutoff = histRangeDays > 0 ? Date.now() - histRangeDays * 86400000 : null;

  let filtered = histCache.filter(e => {
    if (!activeTypes.has(e.type)) return false;
    if (cutoff !== null && new Date(e.timestamp + 'Z').getTime() < cutoff) return false;
    if (q && !(`${e.detail} ${e.reason||''}`.toLowerCase().includes(q))) return false;
    return true;
  });

  if (!filtered.length) {
    el.innerHTML = '<div style="color:var(--text-dim);font-size:13px;padding:30px 0;text-align:center">Sin eventos registrados</div>';
    if (pag) pag.innerHTML = '';
    return;
  }

  const totalPages = Math.max(1, Math.ceil(filtered.length / HIST_PAGE_SIZE));
  if (histPage > totalPages) histPage = totalPages;
  const start = (histPage - 1) * HIST_PAGE_SIZE;
  const pageItems = filtered.slice(start, start + HIST_PAGE_SIZE);

  el.innerHTML = pageItems.map(e => {
    const meta = eventMeta(e.type);
    const status = eventStatus(e);
    const [datePart, timePart] = fmtDatetime(e.timestamp).split(' ');
    const [title, sub] = String(e.detail || '').split(' — ');
    const pill = e.resolved
      ? '<span class="hist-pill hist-pill-green">Resuelto</span>'
      : (e.type === 'offline' ? '<span class="hist-pill hist-pill-red">Sin resolver</span>' : '');
    return `<div class="sw-row" style="align-items:flex-start;padding:12px 14px">
      <div class="s-icon ${meta.color}" style="width:36px;height:36px;border-radius:11px;flex-shrink:0;margin-top:1px"><svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px"><path d="${meta.path}"/></svg></div>
      <div style="flex:1.6;min-width:0;padding-top:1px">
        <div style="font-size:13px;font-weight:600">${title}</div>
        ${sub ? `<div style="font-size:11px;color:var(--text-dim);margin-top:2px">${sub}</div>` : ''}
        ${pill ? `<div style="margin-top:5px">${pill}</div>` : ''}
      </div>
      <div style="width:140px;font-size:12px;color:var(--text-mid);padding-top:2px">${e.reason || '--'}</div>
      <div style="width:100px;font-size:12px;color:var(--text-mid);padding-top:2px;line-height:1.5">${datePart}<br>${timePart}</div>
      <div style="width:110px;display:flex;align-items:center;gap:6px;padding-top:2px">
        <span style="width:7px;height:7px;border-radius:50%;background:${status.color};flex-shrink:0"></span>
        <span style="font-size:12px;color:${status.color}">${status.label}</span>
      </div>
      <svg class="sw-row-chevron" viewBox="0 0 24 24" fill="currentColor" style="margin-top:5px"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
    </div>`;
  }).join('');

  if (!pag) return;
  const from = start + 1;
  const to = Math.min(start + HIST_PAGE_SIZE, filtered.length);
  const addBtn = p => `<button class="sw-page-btn ${p === histPage ? 'active' : ''}" onclick="goToHistPage(${p})">${p}</button>`;
  let pageBtns = '';
  if (totalPages <= 7) {
    for (let p = 1; p <= totalPages; p++) pageBtns += addBtn(p);
  } else {
    pageBtns += addBtn(1);
    if (histPage > 3) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    for (let p = Math.max(2, histPage - 1); p <= Math.min(totalPages - 1, histPage + 1); p++) pageBtns += addBtn(p);
    if (histPage < totalPages - 2) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    pageBtns += addBtn(totalPages);
  }
  pag.innerHTML = `
    <div>Mostrando ${from}–${to} de ${filtered.length} eventos</div>
    <div class="sw-page-btns">
      <button class="sw-page-btn" onclick="goToHistPage(${histPage - 1})" ${histPage <= 1 ? 'disabled' : ''}>‹</button>
      ${pageBtns}
      <button class="sw-page-btn" onclick="goToHistPage(${histPage + 1})" ${histPage >= totalPages ? 'disabled' : ''}>›</button>
    </div>`;
}

function goToHistPage(p) {
  histPage = p;
  _renderHistPage('modal-history-list');
}

function onHistSearchInput() {
  histPage = 1;
  _renderHistPage('modal-history-list');
}

function onHistFilterChange() {
  histPage = 1;
  _renderHistPage('modal-history-list');
}

function toggleHistMenu(id) {
  document.getElementById(id).classList.toggle('open');
}

function setHistRange(days) {
  histRangeDays = days;
  const labels = {1: 'Últimas 24 horas', 7: 'Últimos 7 días', 30: 'Últimos 30 días', 0: 'Todo'};
  document.getElementById('hist-range-label').textContent = labels[days];
  document.getElementById('hist-range-menu').classList.remove('open');
  histPage = 1;
  _renderHistPage('modal-history-list');
}

document.addEventListener('click', e => {
  ['hist-range', 'hist-filter'].forEach(prefix => {
    const btn = document.getElementById(`${prefix}-btn`);
    const menu = document.getElementById(`${prefix}-menu`);
    if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.remove('open');
    }
  });
});

let swCache = [];
let swSort = 'name_asc';
let swPage = 1;
const SW_PAGE_SIZE = 15;
const SW_AVATAR_COLORS = ['#3b82f6','#ef4444','#10b981','#f59e0b','#8b5cf6','#ec4899','#06b6d4','#f97316','#6366f1','#14b8a6'];

function swAvatarColor(name) {
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
  return SW_AVATAR_COLORS[hash % SW_AVATAR_COLORS.length];
}

async function openSoftware() {
  if (!currentAgentId) return;
  document.getElementById('modal-sw-meta').textContent = 'Cargando...';
  document.getElementById('modal-sw-body').innerHTML = '';
  document.getElementById('sw-pagination').innerHTML = '';
  document.getElementById('sw-search').value = '';
  swPage = 1;
  setSwSort('name_asc', true);
  openModal('modal-software');
  const res = await api(`/api/agents/${currentAgentId}/software`);
  if (!res) return;
  swCache = res.software || [];
  const upd = res.updated_at ? fmtDatetime(res.updated_at.replace('Z','')) : '--';
  document.getElementById('modal-sw-meta').textContent = `${res.count} programas · Actualizado ${upd}`;
  filterSoftware('');
}

function onSwSearchInput(v) {
  swPage = 1;
  filterSoftware(v);
}

function toggleSwSortMenu() {
  document.getElementById('sw-sort-menu').classList.toggle('open');
}

document.addEventListener('click', e => {
  const btn = document.getElementById('sw-sort-btn');
  const menu = document.getElementById('sw-sort-menu');
  if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
    menu.classList.remove('open');
  }
});

function setSwSort(mode, silent) {
  swSort = mode;
  const labels = {name_asc: 'Nombre (A → Z)', name_desc: 'Nombre (Z → A)', version: 'Versión'};
  document.getElementById('sw-sort-label').textContent = labels[mode];
  document.getElementById('sw-sort-menu').classList.remove('open');
  swPage = 1;
  if (!silent) filterSoftware(document.getElementById('sw-search').value);
}

function filterSoftware(q) {
  const body = document.getElementById('modal-sw-body');
  const pag = document.getElementById('sw-pagination');
  let filtered = q ? swCache.filter(s => s.name.toLowerCase().includes(q.toLowerCase()) || (s.version||'').toLowerCase().includes(q.toLowerCase())) : swCache.slice();

  filtered.sort((a, b) => {
    if (swSort === 'name_desc') return b.name.localeCompare(a.name);
    if (swSort === 'version') return (a.version||'').localeCompare(b.version||'');
    return a.name.localeCompare(b.name);
  });

  if (!filtered.length) {
    body.innerHTML = `<div style="color:var(--text-dim);text-align:center;padding:30px 0;font-size:13px">Sin resultados</div>`;
    pag.innerHTML = '';
    return;
  }

  const totalPages = Math.max(1, Math.ceil(filtered.length / SW_PAGE_SIZE));
  if (swPage > totalPages) swPage = totalPages;
  const start = (swPage - 1) * SW_PAGE_SIZE;
  const pageItems = filtered.slice(start, start + SW_PAGE_SIZE);

  body.innerHTML = pageItems.map(s => {
    const initial = (s.name || '?').trim().charAt(0).toUpperCase();
    const color = swAvatarColor(s.name || '');
    return `<div class="sw-row">
      <div class="sw-row-icon" style="background:${color}">${initial}</div>
      <div class="sw-row-name" title="${s.name}">${s.name}</div>
      <div class="sw-row-version">${s.version || '--'}</div>
      <svg class="sw-row-chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
    </div>`;
  }).join('');

  const from = start + 1;
  const to = Math.min(start + SW_PAGE_SIZE, filtered.length);
  const addBtn = p => `<button class="sw-page-btn ${p === swPage ? 'active' : ''}" onclick="goToSwPage(${p})">${p}</button>`;
  let pageBtns = '';
  if (totalPages <= 7) {
    for (let p = 1; p <= totalPages; p++) pageBtns += addBtn(p);
  } else {
    pageBtns += addBtn(1);
    if (swPage > 3) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    for (let p = Math.max(2, swPage - 1); p <= Math.min(totalPages - 1, swPage + 1); p++) pageBtns += addBtn(p);
    if (swPage < totalPages - 2) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    pageBtns += addBtn(totalPages);
  }

  pag.innerHTML = `
    <div>Mostrando ${from}–${to} de ${filtered.length}</div>
    <div class="sw-page-btns">
      <button class="sw-page-btn" onclick="goToSwPage(${swPage - 1})" ${swPage <= 1 ? 'disabled' : ''}>‹</button>
      ${pageBtns}
      <button class="sw-page-btn" onclick="goToSwPage(${swPage + 1})" ${swPage >= totalPages ? 'disabled' : ''}>›</button>
    </div>`;
}

function goToSwPage(p) {
  swPage = p;
  filterSoftware(document.getElementById('sw-search').value);
}

async function openHistory() {
  if (!currentAgentId) return;
  document.getElementById('modal-history-list').innerHTML = '<div style="color:var(--text-dim);font-size:13px;padding:20px 0;text-align:center">Cargando...</div>';
  document.getElementById('hist-pagination').innerHTML = '';
  document.getElementById('hist-search').value = '';
  document.querySelectorAll('.hist-type-cb').forEach(cb => cb.checked = true);
  histRangeDays = 7;
  document.getElementById('hist-range-label').textContent = 'Últimos 7 días';
  openModal('modal-history');
  const events = await api(`/api/agents/${currentAgentId}/events`);
  if (events) renderEvents(events, 'modal-history-list');
}

// ── Inventario ─────────────────────────────────────────────────────────────
async function exportCSV() {
  const r = await fetch('/api/reports/agents.csv', {headers:{'Authorization':`Bearer ${token}`}});
  if (!r.ok) return;
  const blob = await r.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `smartmonitor_${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(url);
}

function metricCell(val, warn=70, crit=85, suffix='%') {
  if (val == null) return '<td style="text-align:right;color:var(--text-dim)">--</td>';
  const c = metricClass(val, warn, crit);
  return `<td style="text-align:right;font-family:var(--mono);font-weight:600;color:${colorVar(c)}">${val.toFixed(1)}${suffix}</td>`;
}

let invPage = 1, invPageSize = 10;

function osIconInfo(os) {
  const o = (os || '').toLowerCase();
  if (o.includes('windows')) return {letter: 'W', color: 'blue'};
  if (o.includes('parrot')) return {letter: 'P', color: 'green'};
  if (o.includes('linux') || o.includes('ubuntu') || o.includes('debian')) return {letter: 'L', color: 'green'};
  if (o.includes('mac') || o.includes('darwin')) return {letter: 'M', color: 'purple'};
  return {letter: '?', color: 'purple'};
}

function inventoryUserCellHTML(a) {
  // Filtrando por usuario: mostrar SIEMPRE el nombre de esa persona (con el
  // rango de fechas), aunque ya no sea la asignación vigente del equipo — si
  // no, quedaba en blanco al ser una asignación devuelta.
  if (_invFilterUserAssignments) {
    const rec = _invFilterUserAssignments.get(a.id);
    if (rec) {
      const range = rec.returned_at ? `${rec.assigned_at||'—'} – ${rec.returned_at}` : `desde ${rec.assigned_at||'—'} (vigente)`;
      const name = rec.assigned_to_name || '--';
      const initials = name === '--' ? '?' : name.trim().split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase();
      return `<div class="inv-user-cell">
        <div class="inv-user-avatar" style="background:${swAvatarColor(name)}">${initials}</div>
        <div><div style="font-weight:600;font-size:13px">${name}</div><div style="font-size:11px;color:var(--text-dim)">${range}</div></div>
      </div>`;
    }
  }
  if (!a.assigned_user_name) return `<span style="color:var(--text-dim);font-size:12.5px">Sin usuario asignado</span>`;
  const initials = a.assigned_user_name.trim().split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase();
  return `<div class="inv-user-cell">
    <div class="inv-user-avatar" style="background:${swAvatarColor(a.assigned_user_name)}">${initials}</div>
    <div><div style="font-weight:600;font-size:13px">${a.assigned_user_name}</div>${a.assigned_user_email ? `<div style="font-size:11px;color:var(--text-dim)">${a.assigned_user_email}</div>` : ''}</div>
  </div>`;
}

function inventoryEstadoHTML(a) {
  const online = a.status === 'online';
  const ago = a.last_seen_ago;
  let sub = '--';
  if (ago != null) {
    if (online && ago < 45) sub = 'Conectado ahora';
    else if (ago < 3600) sub = `Hace ${Math.max(1, Math.round(ago/60))} min`;
    else sub = `Hace ${Math.round(ago/3600)} horas`;
  }
  return `<div style="display:flex;align-items:center;gap:7px">
    <span class="inv-status-dot" style="background:${online?'var(--green)':'var(--red)'}"></span>
    <div><div style="font-size:12.5px;font-weight:600;color:${online?'var(--green)':'var(--red)'}">${online?'Online':'Offline'}</div><div style="font-size:11px;color:var(--text-dim)">${sub}</div></div>
  </div>`;
}

function inventoryOsHTML(a) {
  const info = osIconInfo(a.os);
  return `<div class="inv-os-cell">
    <div class="s-icon ${info.color}" style="font-weight:700">${info.letter}</div>
    <div><div style="font-size:12.5px;font-weight:600">${a.os || 'Desconocido'}</div>${a.os_version ? `<div style="font-size:11px;color:var(--text-dim)">${a.os_version}</div>` : ''}</div>
  </div>`;
}

const INV_CPU_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>';
const INV_RAM_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z"/></svg>';
const INV_DISK_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z"/></svg>';

function inventorySpecsHTML(a) {
  const lines = [];
  if (a.cpu_model) lines.push(`<div class="inv-spec-line">${INV_CPU_ICON}<span>${a.cpu_model}${a.cpu_cores?` (${a.cpu_cores} núcleos)`:''}</span></div>`);
  if (a.ram_total_gb) lines.push(`<div class="inv-spec-line">${INV_RAM_ICON}<span>${a.ram_total_gb.toFixed(0)} GB RAM</span></div>`);
  if (a.disk_total_gb) lines.push(`<div class="inv-spec-line">${INV_DISK_ICON}<span>${a.disk_total_gb.toFixed(0)} GB disco</span></div>`);
  return lines.length ? lines.join('') : '<span style="color:var(--text-dim);font-size:12px">--</span>';
}

function inventoryPerfHTML(a) {
  const rows = [['CPU', a.cpu_percent, 70, 85], ['RAM', a.ram_percent, 70, 85], ['Disco', a.disk_percent, 70, 90]];
  const bars = rows.map(([label, val, warn, crit]) => {
    const v = val || 0;
    const c = metricClass(v, warn, crit);
    return `<div class="inv-perf-row">
      <span class="inv-perf-label">${label}</span>
      <div class="bar-track"><div class="bar-fill ${c}" style="width:${v}%"></div></div>
      <span class="inv-perf-pct" style="color:${colorVar(c)}">${v.toFixed(0)}%</span>
    </div>`;
  }).join('');
  const temp = (a.cpu_temp != null) ? `<div class="inv-perf-temp">🌡 ${a.cpu_temp.toFixed(1)}°C</div>` : '';
  return bars + temp;
}

function inventoryPaginationHTML(total) {
  const totalPages = Math.max(1, Math.ceil(total / invPageSize));
  if (invPage > totalPages) invPage = totalPages;
  const start = (invPage - 1) * invPageSize;
  const from = total ? start + 1 : 0;
  const to = Math.min(start + invPageSize, total);
  const addBtn = p => `<button class="sw-page-btn ${p === invPage ? 'active' : ''}" onclick="goToInvPage(${p})">${p}</button>`;
  let pageBtns = '';
  if (totalPages <= 7) {
    for (let p = 1; p <= totalPages; p++) pageBtns += addBtn(p);
  } else {
    pageBtns += addBtn(1);
    if (invPage > 3) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    for (let p = Math.max(2, invPage - 1); p <= Math.min(totalPages - 1, invPage + 1); p++) pageBtns += addBtn(p);
    if (invPage < totalPages - 2) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    pageBtns += addBtn(totalPages);
  }
  return `<div>Mostrando ${from} a ${to} de ${total} equipos</div>
    <div class="sw-page-btns">
      <button class="sw-page-btn" onclick="goToInvPage(${invPage - 1})" ${invPage <= 1 ? 'disabled' : ''}>‹</button>
      ${pageBtns}
      <button class="sw-page-btn" onclick="goToInvPage(${invPage + 1})" ${invPage >= totalPages ? 'disabled' : ''}>›</button>
    </div>
    <div style="display:flex;align-items:center;gap:6px">
      <span>Mostrar</span>
      <select class="form-input" style="width:64px;padding:4px 6px;font-size:12px" onchange="setInvPageSize(this.value)">
        ${[10,25,50,100].map(n=>`<option value="${n}" ${n===invPageSize?'selected':''}>${n}</option>`).join('')}
      </select>
      <span>por página</span>
    </div>`;
}

function goToInvPage(p) { invPage = p; _lastInventorySig = null; renderInventory(); }
function setInvPageSize(n) { invPageSize = parseInt(n, 10); invPage = 1; _lastInventorySig = null; renderInventory(); }

// ── Menú de acciones (⋮) por fila/tarjeta: se agrega al body (no dentro del
// contenedor con scroll de la tabla) para que no lo recorte el overflow. ───
function toggleInvRowMenu(e, id) {
  e.stopPropagation();
  const existing = document.getElementById('inv-row-menu-portal');
  const wasForSameRow = existing && existing.dataset.forId === id;
  if (existing) { existing.remove(); document.removeEventListener('click', _closeInvRowMenu); }
  if (wasForSameRow) return;
  const a = allAgents.find(x => x.id === id);
  if (!a) return;
  const btn = e.currentTarget;
  const menu = document.createElement('div');
  menu.className = 'export-menu open';
  menu.id = 'inv-row-menu-portal';
  menu.dataset.forId = id;
  menu.style.position = 'fixed';
  menu.innerHTML = `
    <div class="export-menu-item" onclick="closeInvRowMenu();openDetail('${id}')">Ver equipo</div>
    <div class="export-menu-item" onclick="closeInvRowMenu();openAssignModal('${id}')">Asignar</div>
    <div class="export-menu-item" onclick="closeInvRowMenu();invRowReturn('${id}')">Devolver</div>
    <div class="export-menu-item" style="justify-content:space-between" onclick="closeInvRowMenu();openAgentHistoryPanel('${id}','assignments')">Historial <span>›</span></div>
    <div class="export-menu-item" style="justify-content:space-between" onclick="closeInvRowMenu();invRowSoftware('${id}')">Software <span>›</span></div>
    <div class="export-menu-item" style="justify-content:space-between" onclick="closeInvRowMenu();openAgentHistoryPanel('${id}','hardware')">Hardware <span>›</span></div>
    <div class="export-menu-item" style="color:var(--red)" onclick="closeInvRowMenu();invRowDelete('${id}')">Eliminar</div>`;
  document.body.appendChild(menu);
  const r = btn.getBoundingClientRect();
  const mw = menu.offsetWidth || 200;
  let left = r.right - mw;
  if (left < 8) left = 8;
  let top = r.bottom + 4;
  if (top + menu.offsetHeight > window.innerHeight - 8) top = r.top - menu.offsetHeight - 4;
  menu.style.left = left + 'px';
  menu.style.top = top + 'px';
  menu.style.zIndex = 300;
  setTimeout(() => document.addEventListener('click', _closeInvRowMenu), 0);
}
function _closeInvRowMenu(e) {
  const m = document.getElementById('inv-row-menu-portal');
  if (!m) return;
  if (e && m.contains(e.target)) return;
  m.remove();
  document.removeEventListener('click', _closeInvRowMenu);
}
function closeInvRowMenu() { _closeInvRowMenu(); }

function invRowSoftware(id) { currentAgentId = id; openSoftware(); }

async function invRowReturn(id) {
  const rows = await api(`/api/agents/${id}/assignments`);
  const openRec = rows && rows[0] && (rows[0].assigned_to || rows[0].assigned_to_name) && !rows[0].returned_at ? rows[0] : null;
  if (!openRec) { alert('Este equipo no tiene una asignación abierta para devolver.'); return; }
  openReturnModal(id, openRec.id);
}

function invRowDelete(id) {
  const a = allAgents.find(x => x.id === id);
  const name = a ? (a.display_name || a.hostname) : id;
  if (!confirm(`¿Eliminar "${name}" del listado? Esto borra su historial (métricas, eventos, asignaciones).\n\nOJO: si el agente sigue instalado y corriendo, volverá a aparecer solo con el próximo reporte — esto no lo desinstala remotamente.`)) return;
  api(`/api/agents/${id}`, {method:'DELETE'}).then(() => fetchAgents());
}

const INV_LAPTOP_ICON = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>';

function inventoryRowHTML(a) {
  return `<tr style="cursor:pointer" onclick="openDetail('${a.id}')">
    <td>
      <div class="inv-equipo-cell">
        <div class="s-icon blue">${INV_LAPTOP_ICON}</div>
        <div>
          <div style="font-weight:600;font-size:13px">${a.display_name || a.hostname}</div>
          <div style="font-size:11px;color:var(--text-dim)">${[a.manufacturer, a.model].filter(Boolean).join(' ') || '--'}</div>
          <div style="font-size:10.5px;color:var(--text-dim);font-family:var(--mono)">Serie: ${a.serial_number || '--'}</div>
        </div>
      </div>
    </td>
    <td>${inventoryUserCellHTML(a)}</td>
    <td>${inventoryEstadoHTML(a)}</td>
    <td>${inventoryOsHTML(a)}</td>
    <td>${inventorySpecsHTML(a)}</td>
    <td style="min-width:150px">${inventoryPerfHTML(a)}</td>
    <td>${a.sede || '--'}</td>
    <td style="text-align:center;font-size:18px" title="${a.device_type||'Sin tipo'}">${deviceTypeIcon(a.device_type)}</td>
    <td class="inv-col-actions" style="text-align:center" onclick="event.stopPropagation()">
      <button class="inv-row-menu-btn" onclick="toggleInvRowMenu(event,'${a.id}')" title="Acciones">⋮</button>
    </td>
  </tr>`;
}

function renderInventory() {
  // Poblar el selector de Área (idempotente, conserva la selección actual)
  const sedeSel = document.getElementById('inv-filter-sede');
  if (sedeSel && areas && areas.length) {
    const cur = sedeSel.value;
    sedeSel.innerHTML = '<option value="">Todas las áreas</option>' +
      areas.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
    sedeSel.value = cur;
  }

  // Poblar el selector de Usuario (idempotente, conserva la selección actual)
  const userSel = document.getElementById('inv-filter-user');
  if (userSel && allUsers && allUsers.length) {
    const cur = userSel.value;
    userSel.innerHTML = '<option value="">Todos</option>' +
      allUsers.map(u => `<option value="${u.id}">${u.name}</option>`).join('');
    userSel.value = cur;
    enhanceSearchableSelect('inv-filter-user');
  }

  // Tarjetas de resumen: siempre sobre el TOTAL de equipos, no sobre el
  // filtrado — reflejan el estado real de la flota, no de la búsqueda actual.
  const totalEl = document.getElementById('inv-s-total');
  if (totalEl) {
    totalEl.textContent = allAgents.length;
    document.getElementById('inv-s-online').textContent = allAgents.filter(a => a.status === 'online').length;
    document.getElementById('inv-s-offline').textContent = allAgents.filter(a => a.status !== 'online').length;
    document.getElementById('inv-s-maint').textContent = allAgents.filter(a => a.review_status === 'en_observacion').length;
  }

  const q = (document.getElementById('inv-filter-search')?.value || '').toLowerCase().trim();
  const sede = document.getElementById('inv-filter-sede')?.value || '';
  const tipo = document.getElementById('inv-filter-type')?.value || '';
  const status = document.getElementById('inv-filter-status')?.value || '';
  const userId = document.getElementById('inv-filter-user')?.value || '';
  const filtered = allAgents.filter(a => {
    if (q && !`${a.display_name||''} ${a.hostname||''} ${a.assigned_user_name||''} ${a.serial_number||''} ${a.model||''}`.toLowerCase().includes(q)) return false;
    if (sede && (a.sede_id || '') !== sede) return false;
    if (tipo && (a.device_type || '') !== tipo) return false;
    if (status && (a.status || '') !== status) return false;
    // Al filtrar por usuario, por defecto solo se muestra el equipo vigente
    // de esa persona; los anteriores solo aparecen si pidió "Ver historial
    // completo" (_invFilterUserShowAll).
    if (userId) {
      if (!_invFilterUserAssignments || !_invFilterUserAssignments.has(a.id)) return false;
      const rec = _invFilterUserAssignments.get(a.id);
      if (!_invFilterUserShowAll && rec.returned_at) return false;
    }
    return true;
  });
  if (userId && _invFilterUserAssignments) {
    // El equipo vigente de la persona siempre va primero; los anteriores
    // detrás, del más reciente al más antiguo.
    filtered.sort((x, y) => {
      const rx = _invFilterUserAssignments.get(x.id), ry = _invFilterUserAssignments.get(y.id);
      const vx = rx && !rx.returned_at, vy = ry && !ry.returned_at;
      if (vx !== vy) return vx ? -1 : 1;
      return (ry?.assigned_at || '').localeCompare(rx?.assigned_at || '');
    });
  }

  const info = document.getElementById('inv-results-info');
  if (info) info.textContent = `${filtered.length} equipos encontrados`;

  const historyBtn = document.getElementById('inv-filter-user-history');
  if (historyBtn) {
    const userHasPast = userId && _invFilterUserAssignments &&
      [..._invFilterUserAssignments.values()].some(r => r.returned_at);
    if (userHasPast) {
      historyBtn.style.display = '';
      historyBtn.textContent = _invFilterUserShowAll ? '− Ocultar equipos anteriores' : '+ Ver historial completo (incluye equipos anteriores)';
    } else {
      historyBtn.style.display = 'none';
    }
  }

  // Tipos de dispositivo configurados + los personalizados ya en uso
  const dtypes = deviceTypeNames();
  const dl = document.getElementById('dtypes');
  if (dl) dl.innerHTML = dtypes.map(t => `<option value="${t}">`).join('');

  // El refresco en vivo (SSE) llama a esta función cada pocos segundos aunque
  // nada haya cambiado — reconstruir la tabla entera cada vez causaba un
  // titileo visible (menú ⋯, etc. se recrean de cero). Si los datos
  // relevantes son idénticos a la última vez, no se toca el DOM.
  const sig = JSON.stringify(filtered.map(a => [a.id, a.display_name, a.hostname, a.manufacturer, a.model,
    a.serial_number, a.os, a.os_version, a.cpu_model, a.cpu_cores, a.ram_total_gb, a.cpu_percent, a.ram_percent,
    a.disk_percent, a.cpu_temp, a.sede, a.device_type, a.status, a.last_seen_ago,
    a.assigned_user_name, a.assigned_user_email, a.returned_at, a.review_status]))
    + '|' + userId + ':' + (_invFilterUserAssignments ? [..._invFilterUserAssignments.entries()].map(([k,v])=>k+','+v.assigned_at+','+v.returned_at).sort().join(';') : '')
    + '|' + invPage + ':' + invPageSize;
  if (sig === _lastInventorySig) {
    return;
  }
  _lastInventorySig = sig;

  const totalPages = Math.max(1, Math.ceil(filtered.length / invPageSize));
  if (invPage > totalPages) invPage = totalPages;
  const pageItems = filtered.slice((invPage - 1) * invPageSize, invPage * invPageSize);

  const tbody = document.getElementById('inventory-body');
  tbody.innerHTML = pageItems.map(inventoryRowHTML).join('');
  const pagTable = document.getElementById('inv-pagination');
  if (pagTable) pagTable.innerHTML = inventoryPaginationHTML(filtered.length);
}

function applyInventoryFilter() { renderInventory(); }

async function onInventoryUserFilterChange() {
  const userId = document.getElementById('inv-filter-user')?.value || '';
  _invFilterUserShowAll = false;
  if (!userId) {
    _invFilterUserAssignments = null;
    renderInventory();
    return;
  }
  // Mientras carga, vaciar (no dejar los resultados del usuario anterior).
  _invFilterUserAssignments = new Map();
  renderInventory();
  try {
    const rows = await api(`/api/agents/by-user/${userId}/assignments`);
    if (document.getElementById('inv-filter-user')?.value !== userId) return; // cambió mientras esperábamos
    const map = new Map();
    (rows || []).forEach(r => { if (r.agent_id && !map.has(r.agent_id)) map.set(r.agent_id, r); });
    _invFilterUserAssignments = map;
    renderInventory();
  } catch (e) { /* deja el resultado vacío */ }
}

function toggleUserFilterShowAll() {
  _invFilterUserShowAll = !_invFilterUserShowAll;
  renderInventory();
}

function clearInventoryFilter() {
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  set('inv-filter-search', ''); set('inv-filter-sede', ''); set('inv-filter-type', ''); set('inv-filter-status', ''); set('inv-filter-user', '');
  _invFilterUserAssignments = null;
  _invFilterUserShowAll = false;
  renderInventory();
}

// ── Otros activos (inventario general: monitores, cables, celulares, líneas...) ──
let allAssetTypes = [];
let allAssets = [];
const ASSET_STATUS_LABEL = {nuevo:'Nuevo', almacen:'En almacén', asignado:'Asignado', 'dañado':'Dañado', baja:'Dado de baja'};
const ASSET_STATUS_BADGE_CLASS = {nuevo:'technician', almacen:'offline', asignado:'active', 'dañado':'inactive', baja:'inactive'};

async function fetchAssetTypes() {
  const types = await api('/api/assets/types');
  if (!types) return;
  allAssetTypes = types;
  const filterSel = document.getElementById('ast-filter-type');
  if (filterSel) {
    const cur = filterSel.value;
    filterSel.innerHTML = '<option value="">Todos</option>' + types.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
    filterSel.value = cur;
  }
  // allAssetTypes es tambien la fuente unica para el "Tipo" de equipos
  // monitoreados (antes vivia aparte, en /data/config.json) - se refresca
  // el filtro/datalist de Inventario cada vez que esta lista cambia.
  renderDeviceTypeFilter();
  updateDtypeDatalist();
}

async function fetchAssets() {
  const list = await api('/api/assets');
  if (!list) return;
  allAssets = list;
  const sedeSel = document.getElementById('ast-filter-sede');
  if (sedeSel) {
    const cur = sedeSel.value;
    sedeSel.innerHTML = '<option value="">Todas</option>' + (areas||[]).map(s => `<option value="${s.id}">${s.name}</option>`).join('');
    sedeSel.value = cur;
  }
  const userSel = document.getElementById('ast-filter-user');
  if (userSel) {
    const cur = userSel.value;
    const names = [...new Map(list.filter(a=>a.assigned_user).map(a=>[a.assigned_user, a.assigned_user_name])).entries()];
    userSel.innerHTML = '<option value="">Todos</option>' + names.map(([id,name]) => `<option value="${id}">${name||id}</option>`).join('');
    userSel.value = cur;
  }
  applyAssetsFilter();
}

function applyAssetsFilter() {
  const q      = (document.getElementById('ast-filter-search')?.value || '').toLowerCase().trim();
  const typeId = document.getElementById('ast-filter-type')?.value || '';
  const status = document.getElementById('ast-filter-status')?.value || '';
  const sedeId = document.getElementById('ast-filter-sede')?.value || '';
  const userId = document.getElementById('ast-filter-user')?.value || '';
  const filtered = (allAssets||[]).filter(a => {
    if (q && !((a.name||'').toLowerCase().includes(q) || (a.code||'').toLowerCase().includes(q))) return false;
    if (typeId && a.type_id !== typeId) return false;
    if (status && a.status !== status) return false;
    if (sedeId && a.sede_id !== sedeId) return false;
    if (userId && a.assigned_user !== userId) return false;
    return true;
  });
  const info = document.getElementById('ast-results-info');
  if (info) info.textContent = filtered.length ? `${filtered.length} de ${allAssets.length} activo${allAssets.length!==1?'s':''}` : '';
  renderAssetsTable(filtered);
}

function clearAssetsFilter() {
  ['ast-filter-search','ast-filter-type','ast-filter-status','ast-filter-sede','ast-filter-user'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  applyAssetsFilter();
}

function renderAssetsTable(list) {
  const body = document.getElementById('assets-body');
  if (!body) return;
  if (!list.length) {
    body.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:24px">${allAssets.length?'Sin resultados para los filtros seleccionados':'No hay activos registrados todavía'}</td></tr>`;
    return;
  }
  body.innerHTML = list.map(a => {
    const statusCol = a.type_kind === 'stock'
      ? `<span style="font-size:12px">${a.stock_available ?? 0} disponibles / ${a.stock_total ?? 0} total</span>`
      : `<span class="badge ${ASSET_STATUS_BADGE_CLASS[a.status]||'technician'}">${ASSET_STATUS_LABEL[a.status]||a.status}</span>`;
    return `<tr>
      <td><strong>${a.name}</strong>${a.linked_asset_name?`<div style="font-size:11px;color:var(--text-dim)">↔ ${a.linked_asset_name}</div>`:''}</td>
      <td><span class="badge technician">${a.type_name}</span></td>
      <td style="font-size:12px;color:var(--text-mid)">${a.code||'—'}</td>
      <td>${statusCol}</td>
      <td style="font-size:13px">${a.assigned_user_name||'—'}</td>
      <td style="font-size:12px;color:var(--text-dim)">${a.sede_name||'—'}</td>
      <td>
        <button class="btn btn-xs btn-ghost" onclick="openEditAsset('${a.id}')">Ver / Editar</button>
      </td>
    </tr>`;
  }).join('');
}

function _renderAssetTypeSelectOptions(selectEl) {
  selectEl.innerHTML = allAssetTypes.map(t => `<option value="${t.id}" data-kind="${t.kind}">${t.name}</option>`).join('');
}

function openNewAsset() {
  document.getElementById('asset-id').value = '';
  document.getElementById('modal-asset-title').textContent = 'Nuevo activo';
  document.getElementById('asset-name').value = '';
  document.getElementById('asset-code').value = '';
  document.getElementById('asset-status').value = 'nuevo';
  document.getElementById('asset-stock-initial').value = '';
  document.getElementById('asset-purchase-date').value = '';
  document.getElementById('asset-invoice').value = '';
  document.getElementById('asset-notes').value = '';
  document.getElementById('asset-error').style.display = 'none';
  document.getElementById('asset-manage-section').style.display = 'none';
  const sedeSel = document.getElementById('asset-sede');
  sedeSel.innerHTML = '<option value="">Sin área</option>' + (areas||[]).map(s => `<option value="${s.id}">${s.name}</option>`).join('');
  const typeSel = document.getElementById('asset-type-select');
  _renderAssetTypeSelectOptions(typeSel);
  if (allAssetTypes.length) typeSel.value = allAssetTypes[0].id;
  onAssetTypeChange();
  openModal('modal-asset');
}

let _currentAssetDetail = null;

async function openEditAsset(id) {
  const detail = await api(`/api/assets/${id}`);
  if (!detail) return;
  _currentAssetDetail = detail;
  document.getElementById('asset-id').value = detail.id;
  document.getElementById('modal-asset-title').textContent = detail.name;
  const sedeSel = document.getElementById('asset-sede');
  sedeSel.innerHTML = '<option value="">Sin área</option>' + (areas||[]).map(s => `<option value="${s.id}">${s.name}</option>`).join('');
  sedeSel.value = detail.sede_id || '';
  const typeSel = document.getElementById('asset-type-select');
  _renderAssetTypeSelectOptions(typeSel);
  typeSel.value = detail.type_id;
  typeSel.disabled = true; // no se cambia el tipo de un activo ya creado
  document.getElementById('asset-name').value = detail.name;
  document.getElementById('asset-code').value = detail.code || '';
  document.getElementById('asset-status').value = detail.status;
  document.getElementById('asset-purchase-date').value = detail.purchase_date || '';
  document.getElementById('asset-invoice').value = detail.invoice_number || '';
  document.getElementById('asset-notes').value = detail.notes || '';
  document.getElementById('asset-error').style.display = 'none';
  onAssetTypeChange(detail.extra_data, detail.linked_asset_id);

  document.getElementById('asset-manage-section').style.display = 'block';
  const t = allAssetTypes.find(x => x.id === detail.type_id);
  document.getElementById('asset-btn-stock').style.display = (t && t.kind === 'stock') ? 'inline-flex' : 'none';
  document.getElementById('asset-btn-assign').style.display = 'inline-flex';
  ['assign','return','stock'].forEach(k => document.getElementById(`asset-subform-${k}`).style.display = 'none');

  let statusHtml = '';
  if (t && t.kind === 'stock') {
    statusHtml = `<strong>${detail.stock_available ?? 0}</strong> disponibles de <strong>${detail.stock_total ?? 0}</strong> en total`;
  } else {
    statusHtml = `Estado: <strong>${ASSET_STATUS_LABEL[detail.status]||detail.status}</strong>` +
      (detail.assigned_user_name ? ` — asignado a <strong>${detail.assigned_user_name}</strong> desde ${detail.assigned_at||'--'}` : '');
  }
  document.getElementById('asset-current-status').innerHTML = statusHtml;

  renderAssetHistory(detail.assignments || []);
  openModal('modal-asset');
}

function _linkableTypeIds(typeId) {
  const t = allAssetTypes.find(x => x.id === typeId);
  const ids = new Set();
  if (t && t.linkable_type_id) ids.add(t.linkable_type_id);
  allAssetTypes.forEach(other => { if (other.linkable_type_id === typeId) ids.add(other.id); });
  return ids;
}

// El select de "otra opción..." queda seleccionado hasta que el usuario
// escribe algo (o cancela, en cuyo caso vuelve a quedar vacío) - se guarda
// tanto en el activo actual como en la categoría, para que quede disponible
// la próxima vez sin tener que ir al editor de categorías.
async function _onExtraSelectChange(selectEl) {
  if (selectEl.value !== '__new__') return;
  const newVal = (prompt('Nueva opción:') || '').trim();
  if (!newVal) { selectEl.value = ''; return; }
  const typeId = selectEl.dataset.typeId;
  const fieldKey = selectEl.dataset.key;
  try {
    const updated = await api(`/api/assets/types/${typeId}/extra-field-option`, {method:'POST', body:{field_key: fieldKey, option: newVal}});
    const idx = allAssetTypes.findIndex(t => t.id === typeId);
    if (idx >= 0) allAssetTypes[idx] = updated;
    const newOpt = document.createElement('option');
    newOpt.value = newVal; newOpt.textContent = newVal;
    selectEl.insertBefore(newOpt, selectEl.querySelector('option[value="__new__"]'));
    selectEl.value = newVal;
  } catch (e) {
    alert(e.message || 'No se pudo agregar la opción.');
    selectEl.value = '';
  }
}

function onAssetTypeChange(existingExtra, linkedIdOverride) {
  const typeSel = document.getElementById('asset-type-select');
  const opt = typeSel.options[typeSel.selectedIndex];
  const kind = opt ? opt.dataset.kind : 'serialized';
  const isCreate = !document.getElementById('asset-id').value;
  document.getElementById('asset-serialized-fields').style.display = kind === 'stock' ? 'none' : 'grid';
  document.getElementById('asset-stock-initial-group').style.display = (kind === 'stock' && isCreate) ? 'block' : 'none';

  const t = allAssetTypes.find(x => x.id === typeSel.value);
  const extra = (t && t.extra_fields) || [];
  const wrap = document.getElementById('asset-extra-fields');
  wrap.innerHTML = extra.map(f => {
    const current = (existingExtra && existingExtra[f.key]) || '';
    if (f.type === 'select') {
      const opts = (f.options || []);
      return `<div class="form-group">
        <label class="form-label">${f.label || f.key}</label>
        <select class="form-input asset-extra-input" data-key="${f.key}" data-type-id="${t.id}" onchange="_onExtraSelectChange(this)">
          <option value="">Selecciona...</option>
          ${opts.map(o => `<option value="${o}" ${o===current?'selected':''}>${o}</option>`).join('')}
          <option value="__new__">+ Otra opción...</option>
        </select>
      </div>`;
    }
    return `<div class="form-group">
      <label class="form-label">${f.label || f.key}</label>
      <input class="form-input asset-extra-input" data-key="${f.key}" type="text" value="${current}">
    </div>`;
  }).join('');

  // "Vincular con" solo muestra activos de la categoría compatible (ej.
  // Celular <-> Línea telefónica) - se recalcula cada vez que cambia el tipo.
  const linkableIds = _linkableTypeIds(typeSel.value);
  const currentAssetId = document.getElementById('asset-id').value;
  const currentLinked = linkedIdOverride !== undefined ? (linkedIdOverride || '') : document.getElementById('asset-linked').value;
  const linkedSel = document.getElementById('asset-linked');
  const candidates = (allAssets || []).filter(a => a.id !== currentAssetId && linkableIds.has(a.type_id));
  linkedSel.innerHTML = '<option value="">Sin vincular</option>' +
    candidates.map(a => `<option value="${a.id}">${a.name} (${a.type_name})</option>`).join('');
  linkedSel.value = candidates.some(a => a.id === currentLinked) ? currentLinked : '';
  linkedSel.disabled = linkableIds.size === 0;
}

async function saveAsset() {
  const err = document.getElementById('asset-error');
  err.style.display = 'none';
  const id = document.getElementById('asset-id').value;
  const name = document.getElementById('asset-name').value.trim();
  if (!name) { err.textContent = 'El nombre es obligatorio'; err.style.display = 'block'; return; }
  const extra_data = {};
  document.querySelectorAll('.asset-extra-input').forEach(inp => { if (inp.value.trim()) extra_data[inp.dataset.key] = inp.value.trim(); });
  const body = {
    name,
    code: document.getElementById('asset-code').value.trim(),
    status: document.getElementById('asset-status').value,
    sede_id: document.getElementById('asset-sede').value || null,
    linked_asset_id: document.getElementById('asset-linked').value || null,
    purchase_date: document.getElementById('asset-purchase-date').value || null,
    invoice_number: document.getElementById('asset-invoice').value.trim(),
    notes: document.getElementById('asset-notes').value.trim(),
    extra_data,
  };
  try {
    if (id) {
      await api(`/api/assets/${id}`, {method:'PUT', body});
    } else {
      body.type_id = document.getElementById('asset-type-select').value;
      const stockInitial = document.getElementById('asset-stock-initial').value;
      if (stockInitial) body.stock_total = parseInt(stockInitial, 10);
      await api('/api/assets', {method:'POST', body});
    }
    closeModal('modal-asset');
    await fetchAssets();
  } catch (e) {
    err.textContent = e.message || 'No se pudo guardar el activo.';
    err.style.display = 'block';
  }
}

async function deleteAssetFromModal() {
  const id = document.getElementById('asset-id').value;
  if (!id) return;
  if (!confirm('¿Eliminar este activo? Esta acción no se puede deshacer.')) return;
  try {
    await api(`/api/assets/${id}`, {method:'DELETE'});
    closeModal('modal-asset');
    await fetchAssets();
  } catch (e) {
    alert(e.message || 'No se pudo eliminar.');
  }
}

function toggleAssetSubform(which) {
  const id = document.getElementById('asset-id').value;
  const detail = _currentAssetDetail;
  ['assign','return','stock'].forEach(k => {
    const el = document.getElementById(`asset-subform-${k}`);
    if (k === which) {
      const willOpen = el.style.display === 'none';
      el.style.display = willOpen ? 'block' : 'none';
      if (willOpen && k === 'assign') _prepAssetAssignForm(detail);
      if (willOpen && k === 'return') _prepAssetReturnForm(detail);
    } else {
      el.style.display = 'none';
    }
  });
}

function _prepAssetAssignForm(detail) {
  const t = allAssetTypes.find(x => x.id === detail.type_id);
  document.getElementById('asset-assign-qty-group').style.display = (t && t.kind === 'stock') ? 'block' : 'none';
  document.getElementById('asset-assign-qty').value = 1;
  document.getElementById('asset-assign-notes').value = '';
  const sel = document.getElementById('asset-assign-user');
  sel.innerHTML = (allUsers||[]).map(u => `<option value="${u.id}">${u.name}</option>`).join('');
  enhanceSearchableSelect('asset-assign-user');
}

function _prepAssetReturnForm(detail) {
  const t = allAssetTypes.find(x => x.id === detail.type_id);
  const wrap = document.getElementById('asset-return-allocations');
  document.getElementById('asset-return-notes').value = '';
  if (t && t.kind === 'stock') {
    const open = (detail.assignments||[]).filter(r => (r.quantity - r.returned_quantity) > 0);
    if (!open.length) { wrap.innerHTML = '<div style="font-size:12px;color:var(--text-dim)">No hay asignaciones abiertas para devolver.</div>'; return; }
    wrap.innerHTML = `<div class="form-group"><label class="form-label">¿Quién devuelve?</label>
      <select class="form-input" id="asset-return-record">
        ${open.map(r => `<option value="${r.id}" data-open="${r.quantity - r.returned_quantity}">${r.assigned_to_name||'—'} (tiene ${r.quantity - r.returned_quantity})</option>`).join('')}
      </select></div>
      <div class="form-group"><label class="form-label">Cantidad a devolver</label><input class="form-input" id="asset-return-qty" type="number" min="1" value="1"></div>`;
  } else {
    const open = (detail.assignments||[]).find(r => !r.returned_at);
    if (!open) { wrap.innerHTML = '<div style="font-size:12px;color:var(--text-dim)">Este activo no tiene una asignación abierta.</div>'; return; }
    wrap.innerHTML = `<input type="hidden" id="asset-return-record" value="${open.id}"><div style="font-size:13px">Devolviendo de: <strong>${open.assigned_to_name||'—'}</strong></div>`;
  }
}

async function confirmAssetAssign() {
  const id = document.getElementById('asset-id').value;
  const userSel = document.getElementById('asset-assign-user');
  const body = {
    assigned_to: userSel.value,
    quantity: parseInt(document.getElementById('asset-assign-qty').value || '1', 10),
    delivery_notes: document.getElementById('asset-assign-notes').value.trim(),
  };
  try {
    await api(`/api/assets/${id}/assignments`, {method:'POST', body});
    await fetchAssets();
    await openEditAsset(id);
  } catch (e) {
    alert(e.message || 'No se pudo asignar.');
  }
}

async function confirmAssetReturn() {
  const id = document.getElementById('asset-id').value;
  const recordSel = document.getElementById('asset-return-record');
  if (!recordSel) return;
  const recordId = recordSel.value;
  const qtyInput = document.getElementById('asset-return-qty');
  const body = { return_notes: document.getElementById('asset-return-notes').value.trim() };
  if (qtyInput) body.return_quantity = parseInt(qtyInput.value || '1', 10);
  try {
    await api(`/api/assets/${id}/assignments/${recordId}`, {method:'PUT', body});
    await fetchAssets();
    await openEditAsset(id);
  } catch (e) {
    alert(e.message || 'No se pudo registrar la devolución.');
  }
}

async function confirmAssetStockAdd() {
  const id = document.getElementById('asset-id').value;
  const qty = parseInt(document.getElementById('asset-stock-add-qty').value || '0', 10);
  const notes = document.getElementById('asset-stock-add-notes').value.trim();
  try {
    await api(`/api/assets/${id}/stock/add`, {method:'POST', body: {quantity: qty, notes}});
    await fetchAssets();
    await openEditAsset(id);
  } catch (e) {
    alert(e.message || 'No se pudo agregar stock.');
  }
}

function renderAssetHistory(assignments) {
  const wrap = document.getElementById('asset-history-list');
  if (!assignments.length) { wrap.innerHTML = '<div style="font-size:12px;color:var(--text-dim);padding:8px 0">Sin movimientos todavía</div>'; return; }
  wrap.innerHTML = assignments.map(r => {
    const open = r.quantity - r.returned_quantity;
    const status = r.returned_at ? `Devuelto ${r.returned_at}` : (open < r.quantity ? `${open} sin devolver` : 'Activo');
    return `<div class="event-item">
      <div class="event-icon online">➕</div>
      <div class="event-detail">
        <div class="event-msg">${r.quantity>1?`${r.quantity}x `:''}${r.assigned_to_name||'—'} — ${status}</div>
        <div class="event-time">${r.assigned_at||''} ${r.delivery_notes?'· '+r.delivery_notes:''}</div>
      </div>
    </div>`;
  }).join('');
}

// ── Categorías de activos ────────────────────────────────────────────────
function renderAssetTypesList() {
  const wrap = document.getElementById('ast-types-list');
  wrap.innerHTML = allAssetTypes.map(t => `
    <div style="display:flex;align-items:center;gap:10px;background:var(--surface2);border-radius:var(--radius-sm);padding:10px 14px">
      <span style="width:24px;display:inline-flex;justify-content:center">${deviceTypePreview(t.icon)}</span>
      <div style="flex:1">
        <strong>${t.name}</strong>
        <span style="font-size:11px;color:var(--text-dim);margin-left:8px">${t.kind==='stock'?'Por cantidad':'Serializado'}</span>
      </div>
      <button class="btn btn-xs btn-ghost" onclick="editAssetType('${t.id}')">Editar</button>
      <button class="btn btn-xs btn-danger" onclick="deleteAssetTypeAction('${t.id}')">Eliminar</button>
    </div>`).join('') || '<div style="font-size:12px;color:var(--text-dim)">Sin categorías todavía</div>';
}

function assetTypeIconUpload(input) {
  const file = input.files && input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    document.getElementById('ast-type-icon').value = reader.result;
    document.getElementById('ast-type-icon-preview').innerHTML = deviceTypePreview(reader.result);
  };
  reader.readAsDataURL(file);
}

function _renderAssetTypeLinkableOptions(selectedId, excludeId) {
  const sel = document.getElementById('ast-type-linkable');
  sel.innerHTML = '<option value="">No vincula</option>' +
    allAssetTypes.filter(t => t.id !== excludeId).map(t => `<option value="${t.id}">${t.name}</option>`).join('');
  sel.value = selectedId || '';
}

function _extraFieldToLine(f) {
  if (f.type === 'select') return `${f.key}=${f.label}=${(f.options||[]).join(',')}`;
  return `${f.key}=${f.label}`;
}

function openNewAssetTypeForm() {
  document.getElementById('ast-type-id').value = '';
  document.getElementById('ast-type-name').value = '';
  document.getElementById('ast-type-kind').value = 'serialized';
  document.getElementById('ast-type-kind').disabled = false;
  document.getElementById('ast-type-extra').value = '';
  document.getElementById('ast-type-icon').value = 'other';
  document.getElementById('ast-type-icon-preview').innerHTML = deviceTypePreview('other');
  document.getElementById('ast-type-error').style.display = 'none';
  _renderAssetTypeLinkableOptions('', null);
  document.getElementById('ast-type-form').style.display = 'block';
}

function closeAssetTypeForm() {
  document.getElementById('ast-type-form').style.display = 'none';
}

function editAssetType(id) {
  const t = allAssetTypes.find(x => x.id === id);
  if (!t) return;
  document.getElementById('ast-type-id').value = t.id;
  document.getElementById('ast-type-name').value = t.name;
  document.getElementById('ast-type-kind').value = t.kind;
  document.getElementById('ast-type-kind').disabled = (allAssets||[]).some(a => a.type_id === id);
  document.getElementById('ast-type-extra').value = (t.extra_fields||[]).map(_extraFieldToLine).join('\n');
  document.getElementById('ast-type-icon').value = t.icon || 'other';
  document.getElementById('ast-type-icon-preview').innerHTML = deviceTypePreview(t.icon || 'other');
  document.getElementById('ast-type-error').style.display = 'none';
  // El vinculo entre categorias se guarda de un solo lado (ej. Celular ->
  // Linea) pero se muestra en ambos editores - si esta categoria no declara
  // linkable_type_id propio, se busca si OTRA categoria la declara a ella.
  const reverseLink = t.linkable_type_id ? null : allAssetTypes.find(x => x.linkable_type_id === id);
  _renderAssetTypeLinkableOptions(t.linkable_type_id || (reverseLink && reverseLink.id) || '', id);
  document.getElementById('ast-type-form').style.display = 'block';
}

async function saveAssetType() {
  const err = document.getElementById('ast-type-error');
  err.style.display = 'none';
  const id = document.getElementById('ast-type-id').value;
  const name = document.getElementById('ast-type-name').value.trim();
  if (!name) { err.textContent = 'El nombre es obligatorio'; err.style.display = 'block'; return; }
  const extra_fields = document.getElementById('ast-type-extra').value.split('\n')
    .map(l => l.trim()).filter(Boolean)
    .map(l => {
      const parts = l.split('=');
      const key = (parts[0]||'').trim();
      const label = (parts[1]||key).trim();
      if (parts.length >= 3) {
        const options = parts.slice(2).join('=').split(',').map(o=>o.trim()).filter(Boolean);
        return {key, label, type:'select', options};
      }
      return {key, label, type:'text'};
    })
    .filter(f => f.key);
  const body = {
    name, kind: document.getElementById('ast-type-kind').value, extra_fields,
    icon: document.getElementById('ast-type-icon').value || 'other',
    linkable_type_id: document.getElementById('ast-type-linkable').value || null,
  };
  try {
    if (id) await api(`/api/assets/types/${id}`, {method:'PUT', body});
    else await api('/api/assets/types', {method:'POST', body});
    await fetchAssetTypes();
    renderAssetTypesList();
    closeAssetTypeForm();
  } catch (e) {
    err.textContent = e.message || 'No se pudo guardar la categoría.';
    err.style.display = 'block';
  }
}

async function deleteAssetTypeAction(id) {
  if (!confirm('¿Eliminar esta categoría?')) return;
  try {
    await api(`/api/assets/types/${id}`, {method:'DELETE'});
    await fetchAssetTypes();
    renderAssetTypesList();
  } catch (e) {
    alert(e.message || 'No se pudo eliminar (¿todavía tiene activos?).');
  }
}

// ── Eventos globales ────────────────────────────────────────────────────────
const evTypeLabel = {
  offline:'Alerta', online:'Alerta',
  cpu_high:'Alerta', ram_high:'Alerta',
  disk_high:'Alerta', temp_high:'Alerta',
  exception_created:'Excepción creada',
  asset_created:'Activo creado', asset_status_changed:'Cambio de estado',
  asset_assigned:'Activo asignado', asset_returned:'Activo devuelto',
  asset_stock_added:'Stock agregado', asset_linked:'Vínculo actualizado',
};

let _eventsCache = [];

function _eventsFilterQuery(overrideLimit) {
  const agent = document.getElementById('ev-filter-agent')?.value || '';
  const sede  = document.getElementById('ev-filter-sede')?.value  || '';
  const type  = document.getElementById('ev-filter-type')?.value  || '';
  const from  = document.getElementById('ev-filter-from')?.value  || '';
  const to    = document.getElementById('ev-filter-to')?.value    || '';
  const limit = overrideLimit || document.getElementById('ev-filter-limit')?.value || '500';
  const params = new URLSearchParams({limit});
  if (agent) params.set('agent_id', agent);
  if (sede)  params.set('sede_id', sede);
  if (type)  params.set('event_type', type);
  if (from)  params.set('from_date', from);
  if (to)    params.set('to_date', to);
  return params.toString();
}

function _populateAgentSelector() {
  const sel = document.getElementById('ev-filter-agent');
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">Todos los equipos</option>' +
    allAgents.map(a => `<option value="${a.id}">${a.display_name||a.hostname}</option>`).join('');
  if (current) sel.value = current;
  enhanceSearchableSelect('ev-filter-agent');
}

function _populateSedeSelector() {
  const sel = document.getElementById('ev-filter-sede');
  if (!sel || !areas || !areas.length) return;
  const current = sel.value;
  sel.innerHTML = '<option value="">Todas las áreas</option>' +
    areas.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
  if (current) sel.value = current;
}

function clearEventsFilter() {
  ['ev-filter-agent','ev-filter-sede','ev-filter-type','ev-filter-from','ev-filter-to'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  const lim = document.getElementById('ev-filter-limit');
  if (lim) lim.value = '500';
  fetchGlobalEvents();
}

function toggleExportMenu() {
  const menu = document.getElementById('ev-export-menu');
  menu.classList.toggle('open');
}

document.addEventListener('click', e => {
  const btn = document.getElementById('ev-export-btn');
  const menu = document.getElementById('ev-export-menu');
  if (menu && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
    menu.classList.remove('open');
  }
});

function exportEventsCSV(mode) {
  document.getElementById('ev-export-menu')?.classList.remove('open');
  let rows = _eventsCache;
  if (mode === 'equipo') {
    const agentId = document.getElementById('ev-filter-agent')?.value;
    if (agentId) rows = rows.filter(e => e.agent_id === agentId);
  } else if (mode === 'area') {
    const sedeId = document.getElementById('ev-filter-sede')?.value;
    if (sedeId) {
      const sede = areas?.find(s => String(s.id) === sedeId);
      if (sede) rows = rows.filter(e => e.sede === sede.name);
    }
  }
  if (!rows.length) { alert('Sin eventos para exportar con el filtro actual.'); return; }
  const headers = ['Fecha','Hora','Equipo','Área','Tipo','Motivo','Detalle'];
  const csv = [headers.join(','), ...rows.map(e => {
    const d = new Date(e.timestamp + (e.timestamp.endsWith('Z') ? '' : 'Z'));
    const fecha = d.toLocaleDateString('es',{day:'2-digit',month:'2-digit',year:'numeric'});
    const hora  = d.toLocaleTimeString('es',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const esc = v => `"${(v||'').toString().replace(/"/g,'""')}"`;
    return [esc(fecha), esc(hora), esc(e.display_name||e.hostname), esc(e.sede||'Sin área'),
            esc(evTypeLabel[e.type]||e.type), esc(e.reason), esc(e.detail)].join(',');
  })].join('\n');
  const blob = new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const suffix = mode === 'equipo' ? '_equipo' : mode === 'area' ? '_area' : '_general';
  a.href = url; a.download = `eventos${suffix}_${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(url);
}

async function fetchGlobalEvents() {
  _populateAgentSelector();
  _populateSedeSelector();
  const tbody = document.getElementById('global-events');
  const info  = document.getElementById('ev-results-info');
  tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:32px">Cargando...</td></tr>`;
  const data = await api(`/api/agents/events/global?${_eventsFilterQuery()}`);
  if (!data) return;
  _eventsCache = data;
  if (info) info.textContent = data.length ? `${data.length} evento${data.length!==1?'s':''} encontrado${data.length!==1?'s':''}` : '';
  if (!data.length) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:32px">Sin eventos para los filtros seleccionados</td></tr>`;
    return;
  }
  tbody.innerHTML = data.map(e => {
    const d = new Date(e.timestamp + (e.timestamp.endsWith('Z') ? '' : 'Z'));
    const fecha = d.toLocaleDateString('es',{day:'2-digit',month:'2-digit',year:'numeric'});
    const hora  = d.toLocaleTimeString('es',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    return `<tr>
      <td style="font-family:var(--mono);font-size:12px;white-space:nowrap">${fecha}</td>
      <td style="font-family:var(--mono);font-size:12px;white-space:nowrap;color:var(--text-dim)">${hora}</td>
      <td><strong style="font-size:13px">${e.display_name||e.hostname}</strong></td>
      <td style="font-size:12px;color:var(--text-dim)">${e.sede||'—'}</td>
      <td><span class="ev-type-pill ${e.type}">${eventIcons[e.type]||''} ${evTypeLabel[e.type]||e.type}</span></td>
      <td style="font-size:12px;color:var(--text-mid)">${e.reason||'—'}</td>
      <td style="font-size:12px;color:var(--text-mid)">${e.detail}</td>
    </tr>`;
  }).join('');
}

// ── Historial de accesos ────────────────────────────────────────────────────
function _loginHistoryFilterQuery() {
  const email   = document.getElementById('lh-filter-email')?.value.trim() || '';
  const success = document.getElementById('lh-filter-success')?.value    || '';
  const from    = document.getElementById('lh-filter-from')?.value      || '';
  const to      = document.getElementById('lh-filter-to')?.value        || '';
  const limit   = document.getElementById('lh-filter-limit')?.value    || '200';
  const params = new URLSearchParams({ limit });
  if (email)   params.set('email', email);
  if (success) params.set('success', success);
  if (from)    params.set('from_date', from);
  if (to)      params.set('to_date', to);
  return params.toString();
}

function clearLoginHistoryFilter() {
  ['lh-filter-email','lh-filter-success','lh-filter-from','lh-filter-to'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  fetchLoginHistory();
}

async function fetchLoginHistory() {
  const tbody = document.getElementById('login-history-body');
  const info  = document.getElementById('lh-results-info');
  if (!tbody) return;
  tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:32px">Cargando...</td></tr>`;
  const data = await api(`/api/auth/login-attempts?${_loginHistoryFilterQuery()}`);
  if (!data) return;
  if (info) info.textContent = data.length ? `${data.length} registro${data.length!==1?'s':''} encontrado${data.length!==1?'s':''}` : '';
  if (!data.length) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:32px">Sin registros para los filtros seleccionados</td></tr>`;
    return;
  }
  tbody.innerHTML = data.map(r => {
    const d = new Date(r.timestamp + (r.timestamp.endsWith('Z') ? '' : 'Z'));
    const fecha = d.toLocaleDateString('es',{day:'2-digit',month:'2-digit',year:'numeric'});
    const hora  = d.toLocaleTimeString('es',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    const badge = r.success
      ? `<span class="ev-type-pill online">✅ Éxito</span>`
      : `<span class="ev-type-pill offline">⛔ Fallido</span>`;
    return `<tr>
      <td style="font-family:var(--mono);font-size:12px;white-space:nowrap">${fecha}</td>
      <td style="font-family:var(--mono);font-size:12px;white-space:nowrap;color:var(--text-dim)">${hora}</td>
      <td style="font-size:13px">${r.email||'—'}</td>
      <td style="font-size:13px">${r.user_name||'—'}</td>
      <td>${badge}</td>
      <td style="font-size:12px;color:var(--text-mid)">${r.reason||'—'}</td>
      <td style="font-family:var(--mono);font-size:12px;color:var(--text-dim)">${r.ip_address||'—'}</td>
    </tr>`;
  }).join('');
}

// ── Política de contraseñas: helpers compartidos (hints en otros modales) ──
let _passwordPolicyCache = null;

async function _getPasswordPolicyCached() {
  if (_passwordPolicyCache) return _passwordPolicyCache;
  _passwordPolicyCache = await api('/api/auth/password-policy');
  return _passwordPolicyCache;
}

function _passwordPolicyHintText(p) {
  if (!p) return '';
  const reqs = [];
  if (p.require_uppercase) reqs.push('una mayúscula');
  if (p.require_lowercase) reqs.push('una minúscula');
  if (p.require_number) reqs.push('un número');
  if (p.require_special) reqs.push('un carácter especial');
  let txt = `Mínimo ${p.min_length} caracteres`;
  if (reqs.length) txt += `, con al menos ${reqs.join(', ')}`;
  return txt + '.';
}

async function openForceChangeModal() {
  document.getElementById('fc-new-pass').value = '';
  document.getElementById('fc-confirm-pass').value = '';
  document.getElementById('fc-error').style.display = 'none';
  document.getElementById('fc-pw-hint').textContent = _passwordPolicyHintText(await _getPasswordPolicyCached());
  openModal('modal-force-change');
}

// ── Telegram / Umbrales / Correo (Configuración) ────────────────────────────
async function loadSettings() {
  try {
    const tg = await api('/api/config/telegram');
    if (tg) {
      document.getElementById('tg-token').value = tg.token || '';
      document.getElementById('tg-chat').value = tg.chat_id || '';
      document.getElementById('tg-enabled').checked = !!tg.enabled;
    }
  } catch (e) {}

  try {
    const thr = await api('/api/alerts/config/global');
    if (thr) {
      document.getElementById('thr-cpu').value = thr.cpu_threshold;
      document.getElementById('thr-ram').value = thr.ram_threshold;
      document.getElementById('thr-disk').value = thr.disk_threshold;
      document.getElementById('thr-temp').value = thr.temp_threshold;
    }
  } catch (e) {}

  try {
    const wa = await api('/api/config/whatsapp');
    if (wa) {
      document.getElementById('wa-enabled').checked = !!wa.enabled;
      renderWhatsappRecipients(wa.recipients);
      document.getElementById('wa-activation-number').value = wa.activation_number || '';
    }
  } catch (e) {}

  fetchEmailConfig();
}

// ── Lista de destinatarios WhatsApp (CallMeBot: 1 API key por numero) ──────
function addWhatsappRecipientRow(phone, apikey) {
  const wrap = document.getElementById('wa-recipients-list');
  const row = document.createElement('div');
  row.className = 'wa-recipient-row';
  row.style.cssText = 'display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:end;margin-bottom:10px';
  row.innerHTML = `
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">Teléfono (con código de país, sin +)</label>
      <input class="form-input wa-r-phone" type="text" placeholder="51987654321" value="${(phone||'').replace(/"/g,'&quot;')}">
    </div>
    <div class="form-group" style="margin-bottom:0">
      <label class="form-label">API key de CallMeBot</label>
      <input class="form-input wa-r-apikey" type="text" placeholder="123456" value="${(apikey||'').replace(/"/g,'&quot;')}">
    </div>
    <button class="btn btn-danger btn-xs" type="button" onclick="this.closest('.wa-recipient-row').remove()">Quitar</button>
  `;
  wrap.appendChild(row);
}

function renderWhatsappRecipients(recipients) {
  const wrap = document.getElementById('wa-recipients-list');
  wrap.innerHTML = '';
  const list = (recipients && recipients.length) ? recipients : [{phone:'', apikey:''}];
  list.forEach(r => addWhatsappRecipientRow(r.phone, r.apikey));
}

// Acciones independientes: cada boton manda SOLO su campo - el backend
// ahora actualiza unicamente lo que llega en el body, sin tocar el resto.
async function saveWhatsapp() {
  const status = document.getElementById('wa-status');
  status.style.display = 'none';
  const recipients = [...document.querySelectorAll('.wa-recipient-row')].map(row => ({
    phone: row.querySelector('.wa-r-phone').value.trim(),
    apikey: row.querySelector('.wa-r-apikey').value.trim(),
  })).filter(r => r.phone && r.apikey);
  try {
    await api('/api/config/whatsapp', {method:'PUT', body: {
      enabled: document.getElementById('wa-enabled').checked,
      recipients,
    }});
    status.style.color = 'var(--green)';
    status.textContent = 'Guardado correctamente.';
    status.style.display = 'block';
  } catch (e) {
    status.style.color = 'var(--red)';
    status.textContent = e.message;
    status.style.display = 'block';
  }
}

