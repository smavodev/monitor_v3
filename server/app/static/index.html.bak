async function fetchEmailConfig() {
  try {
    const em = await api('/api/config/email');
    if (!em) return;
    document.getElementById('em-host').value = em.host || '';
    document.getElementById('em-port').value = em.port || 587;
    document.getElementById('em-user').value = em.username || '';
    document.getElementById('em-pass').value = em.password || '';
    document.getElementById('em-from').value = em.from_addr || '';
    document.getElementById('em-to').value = em.to_addrs || '';
    document.getElementById('em-cc').value = em.cc_addrs || '';
    document.getElementById('em-bcc').value = em.bcc_addrs || '';
    document.getElementById('em-enabled').checked = !!em.enabled;
    const tpl = document.getElementById('em-template');
    if (tpl) {
      const t = (em.html_template && em.html_template.trim()) ? em.html_template
               : (em.default_template || DEFAULT_EMAIL_TEMPLATE || '');
      tpl.value = t;
      _renderEmailPreview();
    }
    _emailDefaultTemplate = em.default_template || DEFAULT_EMAIL_TEMPLATE || (tpl ? tpl.value : '');
    const subj = document.getElementById('em-subject');
    if (subj) subj.value = em.subject_template || '';
  } catch (e) {}
}

