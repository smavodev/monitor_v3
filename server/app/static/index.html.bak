  </div>
  <div style="text-align:center;margin-top:20px;color:#94a3b8;font-size:12px">
    🛡 SmartMonitor · Sistema de Gestión de Equipos<br>
    <span style="font-size:11px">© {{anio}} SmartMonitor. Todos los derechos reservados.</span>
  </div>
</div>`;

let _emailDefaultTemplate = '';

function _renderEmailPreview() {
  const tpl = document.getElementById('em-template');
  const prev = document.getElementById('em-preview');
  if (!tpl || !prev) return;
  const sample = {
    titulo:  '🔥 CPU alta — servidor-01',
    equipo:  'servidor-01',
    detalle: 'CPU al 97.4%',
    fecha:   new Date().toLocaleString('es-ES'),
    anio:    new Date().getFullYear(),
    panel_button: '<a href="#" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-weight:600;font-size:12px;padding:8px 14px;border-radius:8px;white-space:nowrap">Ir a SmartMonitor →</a>',
  };
  let html = tpl.value || '';
  for (const k in sample) {
    html = html.split('{{' + k + '}}').join(sample[k]);
  }
  prev.innerHTML = html;
}

function _restoreDefaultTemplate() {
  const tpl = document.getElementById('em-template');
  if (!tpl) return;
  tpl.value = _emailDefaultTemplate || DEFAULT_EMAIL_TEMPLATE || tpl.value;
  _renderEmailPreview();
}

// ── Política de contraseñas (Configuración) ─────────────────────────────────
function _ppToggleExpiration() {
  const on = document.getElementById('pp-expiration').checked;
  document.getElementById('pp-expiration-wrap').style.opacity = on ? '1' : '.4';
  document.getElementById('pp-expire-days').disabled = !on;
}

function _ppToggleReuse() {
  const on = document.getElementById('pp-prevent-reuse').checked;
  document.getElementById('pp-reuse-wrap').style.opacity = on ? '1' : '.4';
  document.getElementById('pp-reuse-count').disabled = !on;
}

async function fetchPasswordPolicy() {
  const p = await api('/api/auth/password-policy');
  if (!p) return;
  document.getElementById('pp-min-length').value = p.min_length;
  document.getElementById('pp-uppercase').checked = p.require_uppercase;
  document.getElementById('pp-lowercase').checked = p.require_lowercase;
  document.getElementById('pp-number').checked = p.require_number;
  document.getElementById('pp-special').checked = p.require_special;
  document.getElementById('pp-expiration').checked = p.expiration_enabled;
  document.getElementById('pp-expire-days').value = p.expire_days;
  document.getElementById('pp-prevent-reuse').checked = p.prevent_reuse;
  document.getElementById('pp-reuse-count').value = p.reuse_remember_count;
  _ppToggleExpiration();
  _ppToggleReuse();
}

async function savePasswordPolicy() {
  const status = document.getElementById('pp-status');
  status.style.display = 'none';
  const body = {
    min_length: parseInt(document.getElementById('pp-min-length').value) || 8,
    require_uppercase: document.getElementById('pp-uppercase').checked,
    require_lowercase: document.getElementById('pp-lowercase').checked,
    require_number: document.getElementById('pp-number').checked,
    require_special: document.getElementById('pp-special').checked,
    expiration_enabled: document.getElementById('pp-expiration').checked,
    expire_days: parseInt(document.getElementById('pp-expire-days').value) || 90,
    prevent_reuse: document.getElementById('pp-prevent-reuse').checked,
    reuse_remember_count: parseInt(document.getElementById('pp-reuse-count').value) || 3,
  };
  try {
    await api('/api/auth/password-policy', {method: 'PUT', body});
    _passwordPolicyCache = null;
    status.style.color = 'var(--green)';
    status.textContent = 'Política guardada ✓';
    status.style.display = 'block';
    setTimeout(() => status.style.display = 'none', 2500);
  } catch (e) {
    status.style.color = 'var(--red)';
    status.textContent = e.message || 'Error al guardar.';
    status.style.display = 'block';
  }
}

// ── Usuarios ───────────────────────────────────────────────────────────────
function userActions(u) {
  const edit = `<button class="btn btn-xs btn-ghost" onclick="editUser('${u.id}','${encodeURIComponent(u.name)}','${u.email}','${u.role_id}',${u.has_access === false ? 0 : 1})">Editar</button>`;
  const reset = `<button class="btn btn-xs btn-ghost" onclick="openUserAccessModal('${u.id}','${encodeURIComponent(u.name)}',${u.active})">Restablecer contraseña</button>`;
  // Nadie puede desactivarse ni eliminarse a sí mismo: lo debe hacer otro admin
  // (o quien tenga permiso de gestión de usuarios).
  if (u.id === (currentUser && currentUser.id)) {
    return edit + reset + ' <span style="font-size:11px;color:var(--text-dim);align-self:center">Tú</span>';
  }
  const tog = `<button class="btn btn-xs ${u.active?'btn-ghost':'btn-primary'}" onclick="toggleUserActive('${u.id}','${encodeURIComponent(u.name)}',${u.active})">${u.active?'Desactivar':'Activar'}</button>`;
  // El admin por defecto no se puede eliminar desde el panel (protegido en
  // el backend tambien) - solo desactivar o restablecer su contraseña.
  if (u.is_default_admin) {
    return edit + reset + tog + ' <span style="font-size:11px;color:var(--text-dim);align-self:center" title="Protegido: no se puede eliminar desde el panel">Protegido</span>';
  }
  const del = `<button class="btn btn-xs btn-danger" onclick="deleteUser('${u.id}')">Eliminar</button>`;
  return edit + reset + tog + del;
}

async function fetchUsers() {
  const users = await api('/api/auth/users');
  if (!users) return;
  allUsers = users;
  _populateUsersRoleFilter();
  applyUsersFilter();
}

function _populateUsersRoleFilter() {
  const sel = document.getElementById('usr-filter-role');
  if (!sel) return;
  const current = sel.value;
  const roles = [...new Set(allUsers.map(u => u.role_name).filter(Boolean))].sort();
  sel.innerHTML = '<option value="">Todos</option>' +
    roles.map(r => `<option value="${r}">${r}</option>`).join('');
  sel.value = current;
}

function applyUsersFilter() {
  const search = (document.getElementById('usr-filter-search')?.value || '').toLowerCase().trim();
  const role   = document.getElementById('usr-filter-role')?.value || '';
  const status = document.getElementById('usr-filter-status')?.value || '';
  const access = document.getElementById('usr-filter-access')?.value || '';

  const filtered = (allUsers || []).filter(u => {
    if (search && !(u.name.toLowerCase().includes(search) || u.email.toLowerCase().includes(search))) return false;
    if (role && u.role_name !== role) return false;
    if (status === 'activo' && !u.active) return false;
    if (status === 'desactivado' && u.active) return false;
    if (access === 'con' && u.has_access === false) return false;
    if (access === 'sin' && u.has_access !== false) return false;
    return true;
  });

  const info = document.getElementById('usr-results-info');
  if (info) info.textContent = filtered.length ? `${filtered.length} de ${allUsers.length} usuario${allUsers.length!==1?'s':''}` : '';

  document.getElementById('users-body').innerHTML = filtered.length ? filtered.map(u => `<tr>
    <td>
      ${u.name}
      ${u.must_change_password ? '<span style="font-size:10px;background:rgba(245,158,11,.15);color:var(--yellow);padding:2px 7px;border-radius:10px;margin-left:6px;font-weight:600">TEMP</span>' : ''}
      ${u.has_access === false ? '<span style="font-size:10px;background:rgba(148,163,184,.15);color:var(--text-dim);padding:2px 7px;border-radius:10px;margin-left:6px;font-weight:600" title="No puede iniciar sesión — solo existe para asignarle equipos">SIN ACCESO</span>' : ''}
    </td>
    <td style="font-family:var(--mono);font-size:12px">${u.email}</td>
    <td><span class="badge admin">${u.role_name}</span></td>
    <td><span class="badge ${u.active?'active':'inactive'}">${u.active?'Activo':'Desactivado'}</span></td>
    <td style="display:flex;gap:6px;flex-wrap:wrap">${userActions(u)}</td>
  </tr>`).join('') : `<tr><td colspan="5" style="text-align:center;color:var(--text-dim);padding:24px">${allUsers.length?'Sin resultados para los filtros seleccionados':'No hay usuarios'}</td></tr>`;
}

function clearUsersFilter() {
  ['usr-filter-search','usr-filter-role','usr-filter-status','usr-filter-access'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  applyUsersFilter();
}

async function _populateUserRolePicker(selectedRoleId) {
  const roles = await api('/api/roles');
  const sel = document.getElementById('user-role-id');
  sel.innerHTML = (roles || []).map(r => `<option value="${r.id}">${r.name}</option>`).join('');
  if (selectedRoleId) sel.value = selectedRoleId;
}

async function editUser(id, nameEnc, email, roleId, hasAccess) {
  const name = decodeURIComponent(nameEnc);
  document.getElementById('user-id').value = id;
  document.getElementById('user-name').value = name;
  document.getElementById('user-email').value = email;
  document.getElementById('user-has-access').checked = hasAccess !== 0;
  await _populateUserRolePicker(roleId);
  document.getElementById('modal-user-title').textContent = 'Editar Usuario';
  openModal('modal-user');
}

async function openNewUser() {
  document.getElementById('user-id').value = '';
  document.getElementById('user-name').value = '';
  document.getElementById('user-email').value = '';
  document.getElementById('user-has-access').checked = true;
  await _populateUserRolePicker(null);
  document.getElementById('modal-user-title').textContent = 'Nuevo Usuario';
  openModal('modal-user');
}

async function saveUser() {
  const id        = document.getElementById('user-id').value;
  const name      = document.getElementById('user-name').value.trim();
  const email     = document.getElementById('user-email').value.trim();
  const roleId    = document.getElementById('user-role-id').value;
  const hasAccess = document.getElementById('user-has-access').checked;
  if (!name || !email) return;
  if (id) {
    await api(`/api/auth/users/${id}`, {method:'PUT', body: {name, email, role_id: roleId, has_access: hasAccess}});
    closeModal('modal-user');
    document.getElementById('user-id').value = '';
    fetchUsers();
  } else {
    const res = await api('/api/auth/users', {method:'POST', body: {name, email, role_id: roleId, has_access: hasAccess}});
    closeModal('modal-user');
    if (res && res.temp_password) {
      document.getElementById('temp-pass-value').textContent = res.temp_password;
      openModal('modal-temp-pass');
    }
    fetchUsers();
  }
}

// ── Roles ────────────────────────────────────────────────────────────────
let rolesCache = [];
let roleSectionsCache = null;

async function fetchRoleSections() {
  if (roleSectionsCache) return roleSectionsCache;
  roleSectionsCache = await api('/api/roles/sections');
  return roleSectionsCache;
}

async function fetchRoles() {
  const roles = await api('/api/roles');
  if (!roles) return;
  rolesCache = roles;
  document.getElementById('roles-body').innerHTML = roles.map(r => `<tr>
    <td>${r.name}${r.is_admin_role ? ' <span class="badge admin" style="margin-left:6px">Sistema</span>' : ''}</td>
    <td>${r.user_count}</td>
    <td style="display:flex;gap:6px;flex-wrap:wrap">
      <button class="btn btn-xs btn-ghost" onclick="openEditRole('${r.id}')">Editar</button>
      ${r.is_admin_role ? '' : `<button class="btn btn-xs btn-danger" onclick="deleteRole('${r.id}','${encodeURIComponent(r.name)}',${r.user_count})">Eliminar</button>`}
    </td>
  </tr>`).join('');
}

const LEVEL_LABELS = {none: 'Sin acceso', view: 'Ver', edit: 'Ver y editar', manage: 'Control total'};

async function _renderRoleRows(permissions, isAdminRole) {
  const sections = await fetchRoleSections();
  const wrap = document.getElementById('role-permissions-rows');
  wrap.innerHTML = sections.map(s => {
    const level = (permissions && permissions[s.key]) || 'none';
    const locked = isAdminRole && s.key === 'users';
    return `<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)">
      <span style="font-size:13px">${s.label}</span>
      <select class="form-input" data-section="${s.key}" style="max-width:180px;padding:6px 10px;margin-top:0" ${locked ? 'disabled' : ''}>
        ${Object.entries(LEVEL_LABELS).map(([val, label]) => `<option value="${val}" ${level===val?'selected':''}>${label}</option>`).join('')}
      </select>
    </div>`;
  }).join('');
}

async function openNewRole() {
  document.getElementById('role-id').value = '';
  document.getElementById('role-name').value = '';
  document.getElementById('role-admin-note').style.display = 'none';
  document.getElementById('role-error').style.display = 'none';
  document.getElementById('modal-role-title').textContent = 'Nuevo rol';
  await _renderRoleRows({}, false);
  openModal('modal-role');
}

async function openEditRole(id) {
  const role = rolesCache.find(r => r.id === id);
  if (!role) return;
  document.getElementById('role-id').value = role.id;
  document.getElementById('role-name').value = role.name;
  document.getElementById('role-error').style.display = 'none';
  document.getElementById('role-admin-note').style.display = role.is_admin_role ? 'block' : 'none';
  document.getElementById('modal-role-title').textContent = 'Editar rol';
  await _renderRoleRows(role.permissions, role.is_admin_role);
  openModal('modal-role');
}

async function saveRole() {
  const id = document.getElementById('role-id').value;
  const name = document.getElementById('role-name').value.trim();
  const err = document.getElementById('role-error');
  err.style.display = 'none';
  if (!name) { err.textContent = 'El nombre del rol es obligatorio'; err.style.display = 'block'; return; }
  const permissions = {};
  document.querySelectorAll('#role-permissions-rows select[data-section]').forEach(sel => {
    permissions[sel.dataset.section] = sel.value;
  });
  try {
    if (id) {
      await api(`/api/roles/${id}`, {method: 'PUT', body: {name, permissions}});
    } else {
      await api('/api/roles', {method: 'POST', body: {name, permissions}});
    }
    closeModal('modal-role');
    fetchRoles();
  } catch (e) {
    err.textContent = e.message || 'Error al guardar.';
    err.style.display = 'block';
  }
}

async function deleteRole(id, nameEnc, userCount) {
  const name = decodeURIComponent(nameEnc);
  if (userCount > 0) {
    alert(`No puedes eliminar "${name}": hay ${userCount} usuario(s) con este rol asignado. Reasígnalos primero.`);
    return;
  }
  if (!confirm(`¿Eliminar el rol "${name}"?`)) return;
  try {
    await api(`/api/roles/${id}`, {method: 'DELETE'});
    fetchRoles();
  } catch (e) {
    alert(e.message || 'No se pudo eliminar el rol.');
  }
}

async function deleteUser(id) {
  if (id === (currentUser && currentUser.id)) {
    alert('No puedes eliminar tu propia cuenta.');
    return;
  }
  if (!confirm('¿Eliminar este usuario?')) return;
  try {
    await api(`/api/auth/users/${id}`, {method:'DELETE'});
    fetchUsers();
  } catch (e) {
    alert(e.message || 'No se pudo eliminar el usuario.');
  }
}

async function openUserAccessModal(id, nameEnc, active) {
  const name = decodeURIComponent(nameEnc);
  document.getElementById('access-user-id').value = id;
  document.getElementById('access-user-name').textContent = 'Usuario: ' + name;
  document.getElementById('access-error').style.display = 'none';
  document.getElementById('access-pw-value').value = '';
  document.getElementById('access-pw-confirm').value = '';
  document.getElementById('access-pw-show').checked = false;
  document.getElementById('access-pw-value').type = 'password';
  document.getElementById('access-pw-confirm').type = 'password';
  document.getElementById('access-force-change').checked = false;
  document.getElementById('access-revoke-sessions').checked = false;
  document.querySelector('input[name="access-pwmode"][value="auto"]').checked = true;
  document.getElementById('access-pw-hint').textContent = _passwordPolicyHintText(await _getPasswordPolicyCached());

  document.getElementById('access-disabled-note').style.display = active ? 'none' : 'block';
  document.getElementById('access-save-btn').textContent = active ? 'Guardar' : 'Reactivar y guardar';
  switchAccessPwMode();
  openModal('modal-user-access');
}

function toggleAccessPwVisibility() {
  const type = document.getElementById('access-pw-show').checked ? 'text' : 'password';
  document.getElementById('access-pw-value').type = type;
  document.getElementById('access-pw-confirm').type = type;
}

async function toggleUserActive(id, nameEnc, active) {
  const name = decodeURIComponent(nameEnc);
  if (id === (currentUser && currentUser.id)) {
    alert('No puedes desactivar tu propia cuenta.');
    return;
  }
  if (active) {
    // Desactivar no necesita contraseña: acción directa e inmediata.
    if (!confirm(`¿Desactivar el acceso de ${name}? No podrá iniciar sesión hasta que lo reactives.`)) return;
    try {
      await api(`/api/auth/users/${id}/access`, {method:'POST', body: {disable: true}});
      fetchUsers();
    } catch (e) {
      alert(e.message || 'No se pudo desactivar el usuario.');
    }
  } else {
    // Reactivar exige definir una contraseña: se resuelve en el modal de restablecer.
    openUserAccessModal(id, nameEnc, false);
  }
}

function switchAccessPwMode() {
  const custom = document.querySelector('input[name="access-pwmode"]:checked')?.value === 'custom';
  document.getElementById('access-custom-pw-wrap').style.display = custom ? 'block' : 'none';
}

async function saveUserAccess() {
  const id = document.getElementById('access-user-id').value;
  const err = document.getElementById('access-error');
  err.style.display = 'none';

  try {
    const pwMode = document.querySelector('input[name="access-pwmode"]:checked')?.value;
    const body = {
      disable: false,
      password_mode: pwMode,
      force_change: document.getElementById('access-force-change').checked,
      revoke_sessions: document.getElementById('access-revoke-sessions').checked,
    };
    if (pwMode === 'custom') {
      const pw  = document.getElementById('access-pw-value').value;
      const pw2 = document.getElementById('access-pw-confirm').value;
      if (pw !== pw2) { err.textContent = 'Las contraseñas no coinciden'; err.style.display = 'block'; return; }
      body.custom_password = pw;
    }
    const res = await api(`/api/auth/users/${id}/access`, {method:'POST', body});
    if (!res) return;
    closeModal('modal-user-access');
    if (res.temp_password) {
      document.getElementById('temp-pass-value').textContent = res.temp_password;
      openModal('modal-temp-pass');
    }
    fetchUsers();
  } catch (e) {
    err.textContent = e.message || 'Error al guardar.';
    err.style.display = 'block';
  }
}

function copyTempPass() {
  const val = document.getElementById('temp-pass-value').textContent;
  navigator.clipboard.writeText(val).then(() => {
    const btn = document.querySelector('#modal-temp-pass .btn-ghost');
    const orig = btn.textContent;
    btn.textContent = '✓ Copiado';
    setTimeout(() => btn.textContent = orig, 2000);
  });
}

async function generateUninstallCode() {
  if (!currentAgentId) return;
  const res = await api(`/api/agents/${currentAgentId}/uninstall-code`, {method:'POST'});
  if (!res) return;
  document.getElementById('uninstall-code-value').textContent = res.code;
  document.getElementById('uninstall-code-expiry').textContent =
    `Expira en ${res.expires_in_minutes} minutos o al primer uso (lo que ocurra primero).`;
  document.getElementById('uninstall-code-generate-btn').style.display = 'none';
  document.getElementById('uninstall-code-active').style.display = 'block';
}

function copyUninstallCode() {
  const val = document.getElementById('uninstall-code-value').textContent;
  navigator.clipboard.writeText(val).then(() => {
    const btn = document.querySelector('#uninstall-code-active .btn-ghost');
    const orig = btn.textContent;
    btn.textContent = '✓ Copiado';
    setTimeout(() => btn.textContent = orig, 2000);
  });
}

function _resetUninstallCodeSection() {
  document.getElementById('uninstall-code-active').style.display = 'none';
  document.getElementById('uninstall-code-generate-btn').style.display = 'block';
}

let _pauseCodeInterval = null;
let _pauseCodeExpiresAt = null;

async function generatePauseCode() {
  if (!currentAgentId) return;
  const res = await api(`/api/agents/${currentAgentId}/pause-code`, {method:'POST'});
  if (!res) return;
  document.getElementById('pause-code-value').textContent = res.code;
  // Contar desde el reloj del propio navegador (Date.now()), no desde
  // res.expires_at - comparar una fecha del servidor contra el reloj local
  // asume que los dos relojes estan perfectamente sincronizados, y no
  // siempre es asi (confirmado: se vio arrancar en 10:36 en vez de 10:00
  // por design de reloj entre el server y el navegador del admin).
  _pauseCodeExpiresAt = Date.now() + res.expires_in_minutes * 60000;
  document.getElementById('pause-code-generate-btn').style.display = 'none';
  document.getElementById('pause-code-expired').style.display = 'none';
  document.getElementById('pause-code-active').style.display = 'block';
  if (_pauseCodeInterval) clearInterval(_pauseCodeInterval);
  _tickPauseCodeCountdown();
  _pauseCodeInterval = setInterval(_tickPauseCodeCountdown, 1000);
}

function _tickPauseCodeCountdown() {
  const msLeft = _pauseCodeExpiresAt - Date.now();
  if (msLeft <= 0) {
    clearInterval(_pauseCodeInterval);
    _pauseCodeInterval = null;
    document.getElementById('pause-code-active').style.display = 'none';
    document.getElementById('pause-code-expired').style.display = 'block';
    return;
  }
  const totalSec = Math.floor(msLeft / 1000);
  const mm = Math.floor(totalSec / 60);
  const ss = totalSec % 60;
  document.getElementById('pause-code-countdown').textContent = `${mm}:${String(ss).padStart(2, '0')}`;
}

function _resetPauseCodeSection() {
  if (_pauseCodeInterval) clearInterval(_pauseCodeInterval);
  _pauseCodeInterval = null;
  document.getElementById('pause-code-active').style.display = 'none';
  document.getElementById('pause-code-expired').style.display = 'none';
  document.getElementById('pause-code-generate-btn').style.display = 'block';
}

function copyPauseCode() {
  const val = document.getElementById('pause-code-value').textContent;
  navigator.clipboard.writeText(val).then(() => {
    const btn = document.querySelector('#pause-code-active .btn-ghost');
    const orig = btn.textContent;
    btn.textContent = '✓ Copiado';
    setTimeout(() => btn.textContent = orig, 2000);
  });
}

function openPauseModal() {
  if (!currentAgentId) return;
  _renderPauseStatus();
  _resetPauseCodeSection();
  _resetUninstallCodeSection();
  openModal('modal-pause-agent');
}

function _renderPauseStatus() {
  const a = allAgents.find(x => x.id === currentAgentId);
  const statusEl = document.getElementById('pause-current-status');
  const resumeBtn = document.getElementById('pause-resume-top-btn');
  const until = a && a.paused_until ? new Date(a.paused_until) : null;
  // Ver PAUSE_INDEFINITE_ISO/deactivateAgentBlocking() - un año muy lejano
  // (2050+) es el mismo mecanismo que una pausa normal, solo que tan largo
  // que en la practica es "desactivado hasta que lo reactives".
  const isIndefinite = !!(until && until.getFullYear() >= 2050);
  const isPaused = !!(until && until > new Date());
  if (isPaused) {
    statusEl.textContent = isIndefinite
      ? '⏻ Bloqueo desactivado (hasta que lo reactives)'
      : `Pausado hasta: ${until.toLocaleString()}`;
    statusEl.style.display = 'block';
  } else {
    statusEl.style.display = 'none';
  }
  // Un solo boton arriba, visible solo si hay alguna pausa activa - sin
  // importar cual de las 4 opciones la disparo (5 min, hoy, fecha o
  // indefinido), reanuda igual.
  resumeBtn.style.display = isPaused ? 'block' : 'none';
}

async function _setPauseUntil(pausedUntil) {
  if (!currentAgentId) return;
  const res = await api(`/api/agents/${currentAgentId}/pause`, {method:'POST', body:{paused_until: pausedUntil}});
  if (!res) return;
  const a = allAgents.find(x => x.id === currentAgentId);
  if (a) a.paused_until = res.paused_until;
  _renderPauseStatus();
}

function pauseAgentMinutes(mins) {
  const d = new Date(Date.now() + mins * 60000);
  _setPauseUntil(d.toISOString());
}

function pauseAgentToday() {
  const d = new Date();
  d.setHours(23, 59, 59, 999);
  _setPauseUntil(d.toISOString());
}

function pauseAgentUntilDate() {
  // Se llama con oninput - dispara en cada tecla mientras se tipea la fecha
  // a mano (no solo al usar el selector nativo), y .value queda vacío hasta
  // que los 5 segmentos (año/mes/día/hora/minuto) estén completos. Por eso
  // no hay alert: no hace falta avisar nada, simplemente no pasa nada todavía.
  const v = document.getElementById('pause-until-input').value;
  if (!v) return;
  _setPauseUntil(new Date(v).toISOString());
}

// No hay un estado "indefinido" aparte en el modelo - paused_until siempre es
// una fecha (ver resolve_should_block() en agents.py, que solo compara contra
// datetime.utcnow()). "Desactivar" reusa el mismo campo con una fecha muy
// lejana en vez de agregar una columna/estado nuevo - funcionalmente
// equivalente a "para siempre" y se revierte igual que cualquier otra pausa,
// con "Reanudar ahora".
const PAUSE_INDEFINITE_ISO = '2099-01-01T00:00:00.000Z';

function deactivateAgentBlocking() {
  _setPauseUntil(PAUSE_INDEFINITE_ISO);
}

function resumeAgentNow() {
  _setPauseUntil(null);
}

async function forceChangePassword() {
  const nw  = document.getElementById('fc-new-pass').value;
  const con = document.getElementById('fc-confirm-pass').value;
  const err = document.getElementById('fc-error');
  err.style.display = 'none';
  if (nw !== con) { err.textContent = 'Las contraseñas no coinciden'; err.style.display = 'block'; return; }
  try {
    const res = await api('/api/auth/change-password', {method:'PUT', body: {new_password: nw}});
    if (!res) return;
    closeModal('modal-force-change');
    currentUser.must_change_password = false;
  } catch (e) {
    err.textContent = e.message || 'Error al cambiar contraseña.';
    err.style.display = 'block';
  }
}

// ── Áreas ──────────────────────────────────────────────────────────────────
async function fetchAreas() {
  const data = await api('/api/sedes');
  if (!data) return;
  areas = data;
  renderAreas();
  // Actualizar select en modal agente
  const sel = document.getElementById('agent-sede-select');
  sel.innerHTML = '<option value="">Sin área</option>' + areas.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
}

function renderAreas() {
  document.getElementById('areas-body').innerHTML = areas.map(s => `<tr>
    <td><strong>${s.name}</strong></td>
    <td>${s.location||'--'}</td>
    <td>${s.agents} equipo${s.agents!==1?'s':''}</td>
    <td style="display:flex;gap:6px">
      <button class="btn btn-sm btn-ghost" onclick="editArea('${s.id}','${encodeURIComponent(s.name)}','${encodeURIComponent(s.location||'')}')">Editar</button>
      <button class="btn btn-sm btn-danger" onclick="deleteArea('${s.id}')">Eliminar</button>
    </td>
  </tr>`).join('');
}

function editArea(id, nameEnc, locEnc) {
  document.getElementById('area-id').value = id;
  document.getElementById('area-name').value = decodeURIComponent(nameEnc);
  document.getElementById('area-location').value = decodeURIComponent(locEnc);
  document.getElementById('modal-area-title').textContent = 'Editar Área';
  openModal('modal-area');
}

async function saveArea() {
  const id       = document.getElementById('area-id').value;
  const name     = document.getElementById('area-name').value.trim();
  const location = document.getElementById('area-location').value.trim();
  if (!name) return;
  if (id) {
    await api(`/api/sedes/${id}`, {method:'PUT', body: JSON.stringify({name, location})});
  } else {
    await api('/api/sedes', {method:'POST', body: JSON.stringify({name, location})});
  }
  closeModal('modal-area');
  document.getElementById('area-id').value = '';
  document.getElementById('area-name').value = '';
  document.getElementById('area-location').value = '';
  document.getElementById('modal-area-title').textContent = 'Nueva Área';
  await fetchAreas();
}

async function deleteArea(id) {
  if (!confirm('¿Eliminar esta área?')) return;
  await api(`/api/sedes/${id}`, {method:'DELETE'});
  fetchAreas();
}

// ── Bloqueo de sitios ─────────────────────────────────────────────────────
let allBlockedSites = [];
let pbPage = 1, pbPageSize = 10;

const PB_ICON_TAG = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.63 5.84C17.27 5.33 16.67 5 16 5L5 5.01C3.9 5.01 3 5.9 3 7v10c0 1.1.9 1.99 2 1.99L16 19c.67 0 1.27-.33 1.63-.84L22 12l-4.37-6.16z"/></svg>';
const PB_ICON_PEOPLE = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>';
const PB_ICON_GLOBE = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.9 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/></svg>';

// Letra + color por dominio conocido, para que la columna Dominio se vea con
// un ícono reconocible en vez de todos iguales - no son logos reales (evita
// depender de assets externos), solo una insignia de color consistente.
const PB_DOMAIN_BRANDS = {
  'youtube.com':   {letter: 'YT', color: 'red'},
  'facebook.com':  {letter: 'f',  color: 'blue'},
  'tiktok.com':    {letter: 'TT', color: 'purple'},
  'instagram.com': {letter: 'IG', color: 'purple'},
  'twitter.com':   {letter: 'X',  color: 'blue'},
  'x.com':         {letter: 'X',  color: 'blue'},
  'linkedin.com':  {letter: 'in', color: 'blue'},
  'pinterest.com': {letter: 'P',  color: 'red'},
  'reddit.com':    {letter: 'r/', color: 'yellow'},
  'snapchat.com':  {letter: 'SC', color: 'yellow'},
  'threads.net':   {letter: '@',  color: 'purple'},
  'whatsapp.com':  {letter: 'W',  color: 'green'},
  'telegram.org':  {letter: 'T',  color: 'blue'},
  'discord.com':   {letter: 'D',  color: 'purple'},
  'netflix.com':   {letter: 'N',  color: 'red'},
  'twitch.tv':     {letter: 'T',  color: 'purple'},
};
function pbDomainIconInfo(domain) {
  const d = (domain || '').toLowerCase().replace(/^www\./, '');
  return PB_DOMAIN_BRANDS[d] || {letter: (d[0] || '?').toUpperCase(), color: 'blue'};
}

// Si el favicon real no carga (sitio caído, sin ícono, red sin salida a
// Google), cae a la insignia de color con inicial - así nunca queda un
// hueco vacío en la columna.
function pbFaviconError(img, letter, color) {
  const div = document.createElement('div');
  div.className = `s-icon ${color} ahp-item-icon`;
  div.style.fontSize = '11px';
  div.style.fontWeight = '700';
  div.textContent = letter;
  img.replaceWith(div);
}

function pbDomainHTML(s) {
  const domain = (s.domain || '').toLowerCase().replace(/^www\./, '');
  const fallback = pbDomainIconInfo(s.domain);
  const favicon = `https://www.google.com/s2/favicons?sz=64&domain=${encodeURIComponent(domain)}`;
  return `<div style="display:flex;align-items:center;gap:10px">
    <div class="ahp-item-icon" style="background:var(--surface2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <img src="${favicon}" width="18" height="18" style="border-radius:3px" loading="lazy" onerror="pbFaviconError(this,'${fallback.letter}','${fallback.color}')">
    </div>
    <strong style="font-size:13px">${s.domain}</strong>
  </div>`;
}

function pbCategoryHTML(s) {
  if (!s.category_label) return `<span style="color:var(--text-dim);font-size:13px">Personalizado</span>`;
  return `<div style="display:flex;align-items:center;gap:6px;color:var(--red);font-size:13px;font-weight:600">
    <span style="width:15px;height:15px;flex-shrink:0">${PB_ICON_TAG}</span>${s.category_label}
  </div>`;
}

function pbAlcanceHTML(s) {
  if (s.agent_name) return `<div style="display:flex;align-items:center;gap:6px;font-size:13px"><span style="width:16px;height:16px;flex-shrink:0;color:var(--text-dim)">${INV_LAPTOP_ICON}</span>${s.agent_name}</div>`;
  if (s.sede_name) return `<div style="display:flex;align-items:center;gap:6px;font-size:13px"><span style="width:16px;height:16px;flex-shrink:0;color:var(--text-dim)">${PB_ICON_PEOPLE}</span>Área: ${s.sede_name}</div>`;
  return `<div style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-dim)"><span style="width:16px;height:16px;flex-shrink:0">${PB_ICON_GLOBE}</span>Global</div>`;
}

function pbEstadoHTML(s) {
  return `<div style="display:flex;align-items:center;gap:7px">
    <span class="inv-status-dot" style="background:${s.active ? 'var(--green)' : 'var(--text-dim)'}"></span>
    <span style="font-size:13px;color:${s.active ? 'var(--green)' : 'var(--text-dim)'}">${s.active ? 'Activo' : 'Inactivo'}</span>
  </div>`;
}

function togglePbRowMenu(e, id) {
  e.stopPropagation();
  const existing = document.getElementById('pb-row-menu-portal');
  const wasForSameRow = existing && existing.dataset.forId === id;
  if (existing) { existing.remove(); document.removeEventListener('click', _closePbRowMenu); }
  if (wasForSameRow) return;
  const s = allBlockedSites.find(x => x.id === id);
  if (!s) return;
  const btn = e.currentTarget;
  const menu = document.createElement('div');
  menu.className = 'export-menu open';
  menu.id = 'pb-row-menu-portal';
  menu.dataset.forId = id;
  menu.style.position = 'fixed';
  const items = [];
  if (!s.is_exception && !s.agent_id) {
    items.push(`<div class="export-menu-item" onclick="closePbRowMenu();openExceptionFor('${encodeURIComponent(s.domain)}')">+ Agregar excepción</div>`);
  }
  if (!items.length) return; // nada para mostrar en este equipo/sitio
  menu.innerHTML = items.join('');
  document.body.appendChild(menu);
  const r = btn.getBoundingClientRect();
  const mw = menu.offsetWidth || 200;
  let left = r.right - mw;
  if (left < 8) left = 8;
  let top = r.bottom + 4;
  if (top + menu.offsetHeight > window.innerHeight - 8) top = r.top - menu.offsetHeight - 4;
  menu.style.left = left + 'px';
  menu.style.top = top + 'px';
  menu.style.zIndex = 300;
  setTimeout(() => document.addEventListener('click', _closePbRowMenu), 0);
}
function _closePbRowMenu(e) {
  const m = document.getElementById('pb-row-menu-portal');
  if (!m) return;
  if (e && m.contains(e.target)) return;
  m.remove();
  document.removeEventListener('click', _closePbRowMenu);
}
function closePbRowMenu() { _closePbRowMenu(); }

function _blockedRow(s) {
  return `<tr>
    <td>${pbDomainHTML(s)}</td>
    <td><span class="badge ${s.is_exception?'admin':'technician'}">${s.is_exception?'Excepción':'Bloqueo'}</span></td>
    <td>${pbCategoryHTML(s)}</td>
    <td>${pbAlcanceHTML(s)}</td>
    <td style="font-size:12px;color:var(--text-mid)">${s.reason || '--'}${s.expires_at ? `<br><span style="color:var(--yellow)">Expira: ${s.expires_at.slice(0,10)}</span>` : ''}</td>
    <td>${pbEstadoHTML(s)}</td>
    <td class="inv-col-actions" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-xs btn-ghost" onclick="toggleBlockedSite('${s.id}',${s.active})">${s.active?'Desactivar':'Activar'}</button>
      <button class="btn btn-xs btn-danger" onclick="deleteBlockedSite('${s.id}')">Eliminar</button>
      ${s.category ? `<button class="btn btn-xs btn-ghost" onclick="deleteCategoryGroup('${s.category}','${s.agent_id||''}','${s.sede_id||''}',${s.is_exception},'${s.category_label}')" title="Quita todos los sitios de esta categoría en este alcance">Quitar categoría</button>` : ''}
      ${(!s.is_exception && !s.agent_id) ? `<button class="inv-row-menu-btn" onclick="togglePbRowMenu(event,'${s.id}')" title="Más acciones">⋮</button>` : ''}
    </td>
  </tr>`;
}

function pbPaginationHTML(total) {
  const totalPages = Math.max(1, Math.ceil(total / pbPageSize));
  if (pbPage > totalPages) pbPage = totalPages;
  const start = (pbPage - 1) * pbPageSize;
  const from = total ? start + 1 : 0;
  const to = Math.min(start + pbPageSize, total);
  const addBtn = p => `<button class="sw-page-btn ${p === pbPage ? 'active' : ''}" onclick="goToPbPage(${p})">${p}</button>`;
  let pageBtns = '';
  if (totalPages <= 7) {
    for (let p = 1; p <= totalPages; p++) pageBtns += addBtn(p);
  } else {
    pageBtns += addBtn(1);
    if (pbPage > 3) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    for (let p = Math.max(2, pbPage - 1); p <= Math.min(totalPages - 1, pbPage + 1); p++) pageBtns += addBtn(p);
    if (pbPage < totalPages - 2) pageBtns += `<span class="sw-page-ellipsis">…</span>`;
    pageBtns += addBtn(totalPages);
  }
  return `<div>Mostrando ${from} a ${to} de ${total} sitios</div>
    <div class="sw-page-btns">
      <button class="sw-page-btn" onclick="goToPbPage(${pbPage - 1})" ${pbPage <= 1 ? 'disabled' : ''}>‹</button>
      ${pageBtns}
      <button class="sw-page-btn" onclick="goToPbPage(${pbPage + 1})" ${pbPage >= totalPages ? 'disabled' : ''}>›</button>
    </div>
    <div style="display:flex;align-items:center;gap:6px">
      <span>Mostrar</span>
      <select class="form-input" style="width:64px;padding:4px 6px;font-size:12px" onchange="setPbPageSize(this.value)">
        ${[10,25,50,100].map(n=>`<option value="${n}" ${n===pbPageSize?'selected':''}>${n}</option>`).join('')}
      </select>
      <span>por página</span>
    </div>`;
}
function goToPbPage(p) { pbPage = p; applyBlockedSitesFilter(); }
function setPbPageSize(n) { pbPageSize = parseInt(n, 10); pbPage = 1; applyBlockedSitesFilter(); }

function renderBlockedTable(bodyId, sites) {
  const el = document.getElementById(bodyId);
  if (!el) return;
  const emptyMsg = (allBlockedSites && allBlockedSites.length) ? 'Sin resultados para los filtros seleccionados' : 'No hay sitios bloqueados';
  const totalPages = Math.max(1, Math.ceil(sites.length / pbPageSize));
  if (pbPage > totalPages) pbPage = totalPages;
  const pageItems = sites.slice((pbPage - 1) * pbPageSize, pbPage * pbPageSize);
  el.innerHTML = pageItems.length ? pageItems.map(_blockedRow).join('')
    : `<tr><td colspan="7" style="text-align:center;color:var(--text-dim);padding:24px">${emptyMsg}</td></tr>`;
  const pag = document.getElementById('pb-pagination');
  if (pag) pag.innerHTML = pbPaginationHTML(sites.length);
}

function updateBlockedSitesStats() {
  const totalEl = document.getElementById('pb-s-total');
  if (!totalEl) return;
  totalEl.textContent = allBlockedSites.length;
  document.getElementById('pb-s-active').textContent = allBlockedSites.filter(s => s.active).length;
  document.getElementById('pb-s-inactive').textContent = allBlockedSites.filter(s => !s.active).length;
  // "Programados" (activación futura) no tiene un campo propio todavía en el
  // modelo de datos - solo existe expires_at (cuándo deja de aplicar, no
  // cuándo empieza), así que de momento queda siempre en 0.
  document.getElementById('pb-s-scheduled').textContent = 0;
}

async function fetchBlockedSites() {
  const sites = await api('/api/blocked-sites');
  if (!sites) return;
  allBlockedSites = sites;
  updateBlockedSitesStats();
  _populateBlockedCategoryFilter();
  applyBlockedSitesFilter();
}

function _populateBlockedCategoryFilter() {
  const sel = document.getElementById('pb-filter-categoria');
  if (!sel) return;
  const current = sel.value;
  const labels = [...new Set(allBlockedSites.map(s => s.category_label).filter(Boolean))].sort();
  sel.innerHTML = '<option value="">Todas</option>' +
    labels.map(l => `<option value="${l}">${l}</option>`).join('') +
    '<option value="__custom__">Personalizado</option>';
  sel.value = current;
}

function applyBlockedSitesFilter() {
  const search   = (document.getElementById('pb-filter-search')?.value || '').toLowerCase().trim();
  const tipo     = document.getElementById('pb-filter-tipo')?.value || '';
  const categoria= document.getElementById('pb-filter-categoria')?.value || '';
  const alcance  = document.getElementById('pb-filter-alcance')?.value || '';
  const estado   = document.getElementById('pb-filter-estado')?.value || '';

  const filtered = (allBlockedSites || []).filter(s => {
    if (search && !(s.domain.toLowerCase().includes(search) || (s.reason||'').toLowerCase().includes(search))) return false;
    if (tipo === 'bloqueo' && s.is_exception) return false;
    if (tipo === 'excepcion' && !s.is_exception) return false;
    if (categoria === '__custom__' && s.category_label) return false;
    if (categoria && categoria !== '__custom__' && s.category_label !== categoria) return false;
    if (alcance === 'equipo' && !s.agent_id) return false;
    if (alcance === 'area' && !(s.sede_id && !s.agent_id)) return false;
    if (alcance === 'global' && (s.agent_id || s.sede_id)) return false;
    if (estado === 'activo' && !s.active) return false;
    if (estado === 'inactivo' && s.active) return false;
    return true;
  });

  renderBlockedTable('parental-body', filtered);
}

function clearBlockedSitesFilter() {
  ['pb-filter-search','pb-filter-tipo','pb-filter-categoria','pb-filter-alcance','pb-filter-estado'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  applyBlockedSitesFilter();
}

// ── Reporte de bloqueos en Excel ─────────────────────────────────────────────
function openReportFilters() {
  const sedeSel = document.getElementById('report-sede-select');
  sedeSel.innerHTML = '<option value="">Todas las áreas</option>' +
    areas.map(a => `<option value="${a.id}">${a.name}</option>`).join('');
  const agentSel = document.getElementById('report-agent-select');
  agentSel.innerHTML = '<option value="">Todos los equipos</option>' +
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('report-agent-select');
  document.getElementById('report-only-blocked').checked = false;
  openModal('modal-report-filters');
}

async function downloadBlockReport() {
  const sedeId = document.getElementById('report-sede-select').value;
  const agentId = document.getElementById('report-agent-select').value;
  const onlyBlocked = document.getElementById('report-only-blocked').checked;
  const params = new URLSearchParams();
  if (sedeId) params.set('sede_id', sedeId);
  if (agentId) params.set('agent_id', agentId);
  if (onlyBlocked) params.set('only_with_blocks', 'true');
  const qs = params.toString();

  const r = await fetch(`/api/blocked-sites/report.xlsx${qs ? '?' + qs : ''}`, {headers:{'Authorization':`Bearer ${token}`}});
  if (!r.ok) { alert('No se pudo generar el reporte.'); return; }
  const blob = await r.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `smartmonitor_bloqueos_${new Date().toISOString().slice(0,10)}.xlsx`;
  a.click(); URL.revokeObjectURL(url);
  closeModal('modal-report-filters');
}

let selectedCategoryKey = null;
let blockModalTab = 'category';

function switchBlockTab(tab) {
  blockModalTab = tab;
  document.getElementById('tab-category').style.display = tab === 'category' ? 'block' : 'none';
  document.getElementById('tab-custom').style.display = tab === 'custom' ? 'block' : 'none';
  document.getElementById('tab-btn-category').className = 'btn btn-sm ' + (tab === 'category' ? 'btn-primary' : 'btn-ghost');
  document.getElementById('tab-btn-custom').className = 'btn btn-sm ' + (tab === 'custom' ? 'btn-primary' : 'btn-ghost');
}

async function loadCategoryPickerList() {
  selectedCategoryKey = null;
  const cats = await api('/api/blocked-sites/categories');
  const list = document.getElementById('category-list-clean');
  if (!cats) { list.innerHTML = ''; return; }
  list.innerHTML = cats.length ? cats.map(c => `
    <label style="display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:14px;cursor:pointer;box-shadow:var(--clay-in-sm)">
      <input type="radio" name="category-radio" value="${c.key}" onchange="selectedCategoryKey='${c.key}'">
      <span style="flex:1">${c.label}</span>
      <span style="font-size:11px;color:var(--text-dim)">${c.domain_count} sitios${c.applied_global?' · ya aplicada global':''}</span>
    </label>`).join('')
    : `<div style="font-size:12px;color:var(--text-dim)">No hay categorías todavía. Crea una desde "Control parental → Categorías".</div>`;
}

async function openNewBlockedSite() {
  document.getElementById('blocked-domain').value = '';
  document.getElementById('blocked-reason').value = '';
  document.getElementById('blocked-error').style.display = 'none';
  const sel = document.getElementById('blocked-agent-select');
  sel.innerHTML = '<option value="">Global (todos los equipos)</option>' +
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  sel.value = '';
  enhanceSearchableSelect('blocked-agent-select');
  switchBlockTab('category');
  await loadCategoryPickerList();
  openModal('modal-blocked');
}

async function saveBlockFromModal() {
  const agent_id = document.getElementById('blocked-agent-select').value || null;
  const reason   = document.getElementById('blocked-reason').value.trim();
  const err      = document.getElementById('blocked-error');
  err.style.display = 'none';

  if (blockModalTab === 'category') {
    if (!selectedCategoryKey) { err.textContent = 'Selecciona una categoría.'; err.style.display = 'block'; return; }
    try {
      await api(`/api/blocked-sites/categories/${selectedCategoryKey}`, {method:'POST', body: JSON.stringify({agent_id, reason})});
    } catch (e) {
      err.textContent = e.message || 'No se pudo bloquear la categoría.';
      err.style.display = 'block';
      return;
    }
  } else {
    const domain = document.getElementById('blocked-domain').value.trim();
    if (!domain) { err.textContent = 'Ingresa un dominio.'; err.style.display = 'block'; return; }
    try {
      await api('/api/blocked-sites', {method:'POST', body: JSON.stringify({domain, agent_id, reason})});
    } catch (e) {
      err.textContent = e.message || 'No se pudo bloquear el sitio.';
      err.style.display = 'block';
      return;
    }
  }
  closeModal('modal-blocked');
  fetchBlockedSites();
}

// ── Excepciones (equipo exceptuado de un bloqueo global) ───────────────────
function switchExceptionScope(type) {
  setFieldVisible('exception-agent-select', type === 'agent');
  setFieldVisible('exception-sede-select', type === 'sede');
}

function openExceptionFor(domainEnc) {
  const domain = decodeURIComponent(domainEnc);
  document.getElementById('exception-domain').value = domain;
  document.getElementById('exception-reason').value = '';
  document.getElementById('exception-expires').value = '';
  document.getElementById('exception-error').style.display = 'none';
  document.querySelector('input[name="exception-scope"][value="agent"]').checked = true;
  switchExceptionScope('agent');
  document.getElementById('exception-agent-select').innerHTML =
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('exception-agent-select');
  document.getElementById('exception-sede-select').innerHTML =
    areas.map(a => `<option value="${a.id}">${a.name}</option>`).join('');
  openModal('modal-exception');
}

async function saveException() {
  const domain     = document.getElementById('exception-domain').value;
  const scope      = document.querySelector('input[name="exception-scope"]:checked').value;
  const reason     = document.getElementById('exception-reason').value.trim();
  const expires_at = document.getElementById('exception-expires').value || null;
  const err        = document.getElementById('exception-error');
  err.style.display = 'none';
  const body = {domain, reason, is_exception: true, expires_at};
  if (scope === 'agent') body.agent_id = document.getElementById('exception-agent-select').value;
  else body.sede_id = document.getElementById('exception-sede-select').value;
  try {
    await api('/api/blocked-sites', {method:'POST', body: JSON.stringify(body)});
  } catch (e) {
    err.textContent = e.message || 'No se pudo agregar la excepción.';
    err.style.display = 'block';
    return;
  }
  closeModal('modal-exception');
  fetchBlockedSites();
}

// ── Categorías personalizadas (gestión, solo desde la página Categorías) ────
function openCustomCategory() {
  document.getElementById('custom-category-id').value = '';
  document.getElementById('custom-category-title').textContent = 'Crear categoría personalizada';
  document.getElementById('custom-category-save-btn').textContent = 'Crear';
  document.getElementById('custom-category-label').value = '';
  document.getElementById('custom-category-domains').value = '';
  document.getElementById('custom-category-error').style.display = 'none';
  openModal('modal-custom-category');
}

async function editCustomCategory(id) {
  const cats = await api('/api/blocked-sites/custom-categories');
  if (!cats) return;
  const cat = cats.find(c => c.id === id);
  if (!cat) return;
  document.getElementById('custom-category-id').value = cat.id;
  document.getElementById('custom-category-title').textContent = 'Editar categoría personalizada';
  document.getElementById('custom-category-save-btn').textContent = 'Guardar';
  document.getElementById('custom-category-label').value = cat.label;
  document.getElementById('custom-category-domains').value = cat.domains.join('\n');
  document.getElementById('custom-category-error').style.display = 'none';
  openModal('modal-custom-category');
}

function returnFromCategoryModal() {
  fetchParentalCategories();
  fetchBlockedSites();
}

async function saveCustomCategory() {
  const id     = document.getElementById('custom-category-id').value;
  const label  = document.getElementById('custom-category-label').value.trim();
  const domains = document.getElementById('custom-category-domains').value
    .split('\n').map(d => d.trim()).filter(Boolean);
  const err = document.getElementById('custom-category-error');
  err.style.display = 'none';
  if (!label) { err.textContent = 'Ingresa un nombre.'; err.style.display = 'block'; return; }
  if (!domains.length) { err.textContent = 'Agrega al menos un dominio.'; err.style.display = 'block'; return; }
  try {
    if (id) {
      await api(`/api/blocked-sites/custom-categories/${id}`, {method:'PUT', body: JSON.stringify({label, domains})});
    } else {
      await api('/api/blocked-sites/custom-categories', {method:'POST', body: JSON.stringify({label, domains})});
    }
  } catch (e) {
    err.textContent = e.message || 'No se pudo guardar la categoría.';
    err.style.display = 'block';
    return;
  }
  closeModal('modal-custom-category');
  returnFromCategoryModal();
}

async function deleteCustomCategory(id, labelEnc) {
  const label = decodeURIComponent(labelEnc);
  if (!confirm(`¿Eliminar la categoría personalizada "${label}"? Esto también quita los bloqueos que ya se hayan aplicado con ella.`)) return;
  await api(`/api/blocked-sites/custom-categories/${id}`, {method:'DELETE'});
  returnFromCategoryModal();
}

// ── Página "Control parental" ▸ Categorías ──────────────────────────────────
function _categoryChip(label, onclickArgs, cssClass) {
  return `<span class="badge ${cssClass}" style="margin-right:4px">${label} <a href="#" onclick="event.preventDefault();deleteCategoryGroup(${onclickArgs})" style="color:inherit;margin-left:4px;text-decoration:none">✕</a></span>`;
}

async function fetchParentalCategories() {
  const cats = await api('/api/blocked-sites/categories');
  if (!cats) return;
  document.getElementById('parental-categories-body').innerHTML = cats.length ? cats.map(c => {
    const scopes = [];
    if (c.applied_global) {
      scopes.push(_categoryChip('Global', `'${c.key}','','', false,'${encodeURIComponent(c.label)}'`, 'active'));
    }
    c.applied_sede_ids.forEach(sid => {
      const s = areas.find(x => x.id === sid);
      scopes.push(_categoryChip(s ? s.name : sid, `'${c.key}','','${sid}', false,'${encodeURIComponent(c.label)}'`, 'active'));
    });
    c.applied_agent_ids.forEach(aid => {
      const a = allAgents.find(x => x.id === aid);
      const name = a ? (a.display_name || a.hostname) : aid;
      scopes.push(_categoryChip(name, `'${c.key}','${aid}','', false,'${encodeURIComponent(c.label)}'`, 'active'));
    });
    c.excepted_sede_ids.forEach(sid => {
      const s = areas.find(x => x.id === sid);
      scopes.push(_categoryChip(`Excepción: ${s ? s.name : sid}`, `'${c.key}','','${sid}', true,'${encodeURIComponent(c.label)}'`, 'admin'));
    });
    c.excepted_agent_ids.forEach(aid => {
      const a = allAgents.find(x => x.id === aid);
      const name = a ? (a.display_name || a.hostname) : aid;
      scopes.push(_categoryChip(`Excepción: ${name}`, `'${c.key}','${aid}','', true,'${encodeURIComponent(c.label)}'`, 'admin'));
    });
    return `<tr>
      <td><strong>${c.label}</strong></td>
      <td>${c.domain_count} sitios</td>
      <td>${scopes.length ? scopes.join('') : '<span style="color:var(--text-dim)">No aplicada</span>'}</td>
      <td style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-xs btn-primary" onclick="openApplyCategory('${c.key}','${encodeURIComponent(c.label)}')">Bloquear</button>
        <button class="btn btn-xs btn-ghost" onclick="openExceptCategory('${c.key}','${encodeURIComponent(c.label)}')">Exceptuar</button>
        <button class="btn btn-xs btn-ghost" onclick="editCustomCategory('${c.key}')">Editar</button>
        <button class="btn btn-xs btn-danger" onclick="deleteCustomCategory('${c.key}','${encodeURIComponent(c.label)}')">Eliminar</button>
      </td>
    </tr>`;
  }).join('') : `<tr><td colspan="4" style="text-align:center;color:var(--text-dim);padding:24px">No hay categorías</td></tr>`;
}

function switchApplyCategoryScope(type) {
  setFieldVisible('apply-category-agent-select', type === 'agent');
  setFieldVisible('apply-category-sede-select', type === 'sede');
}

function openApplyCategory(key, labelEnc) {
  document.getElementById('apply-category-key').value = key;
  document.getElementById('apply-category-label').value = decodeURIComponent(labelEnc);
  document.getElementById('apply-category-reason').value = '';
  document.getElementById('apply-category-error').style.display = 'none';
  document.querySelector('input[name="apply-category-scope"][value="global"]').checked = true;
  switchApplyCategoryScope('global');
  document.getElementById('apply-category-agent-select').innerHTML =
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('apply-category-agent-select');
  document.getElementById('apply-category-sede-select').innerHTML =
    areas.map(a => `<option value="${a.id}">${a.name}</option>`).join('');
  openModal('modal-apply-category');
}

async function confirmApplyCategory() {
  const key    = document.getElementById('apply-category-key').value;
  const scope  = document.querySelector('input[name="apply-category-scope"]:checked').value;
  const reason = document.getElementById('apply-category-reason').value.trim();
  const err    = document.getElementById('apply-category-error');
  err.style.display = 'none';
  const body = {reason};
  if (scope === 'agent') body.agent_id = document.getElementById('apply-category-agent-select').value;
  if (scope === 'sede') body.sede_id = document.getElementById('apply-category-sede-select').value;
  try {
    await api(`/api/blocked-sites/categories/${key}`, {method:'POST', body: JSON.stringify(body)});
  } catch (e) {
    err.textContent = e.message || 'No se pudo bloquear la categoría.';
    err.style.display = 'block';
    return;
  }
  closeModal('modal-apply-category');
  fetchParentalCategories();
  fetchBlockedSites();
}

function switchExceptCategoryScope(type) {
  setFieldVisible('except-category-agent-select', type === 'agent');
  setFieldVisible('except-category-sede-select', type === 'sede');
}

function openExceptCategory(key, labelEnc) {
  document.getElementById('except-category-key').value = key;
  document.getElementById('except-category-label').value = decodeURIComponent(labelEnc);
  document.getElementById('except-category-reason').value = '';
  document.getElementById('except-category-expires').value = '';
  document.getElementById('except-category-error').style.display = 'none';
  document.querySelector('input[name="except-category-scope"][value="sede"]').checked = true;
  switchExceptCategoryScope('sede');
  document.getElementById('except-category-agent-select').innerHTML =
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('except-category-agent-select');
  document.getElementById('except-category-sede-select').innerHTML =
    areas.map(a => `<option value="${a.id}">${a.name}</option>`).join('');
  openModal('modal-except-category');
}

async function confirmExceptCategory() {
  const key        = document.getElementById('except-category-key').value;
  const scope      = document.querySelector('input[name="except-category-scope"]:checked').value;
  const reason     = document.getElementById('except-category-reason').value.trim();
  const expires_at = document.getElementById('except-category-expires').value || null;
  const err        = document.getElementById('except-category-error');
  err.style.display = 'none';
  const body = {reason, expires_at, is_exception: true};
  if (scope === 'agent') body.agent_id = document.getElementById('except-category-agent-select').value;
  else body.sede_id = document.getElementById('except-category-sede-select').value;
  try {
    await api(`/api/blocked-sites/categories/${key}`, {method:'POST', body: JSON.stringify(body)});
  } catch (e) {
    err.textContent = e.message || 'No se pudo agregar la excepción.';
    err.style.display = 'block';
    return;
  }
  closeModal('modal-except-category');
  fetchParentalCategories();
  fetchBlockedSites();
}

async function deleteCategoryGroup(key, agentId, sedeId, isException, label) {
  const scopeTxt = agentId ? 'para este equipo' : sedeId ? 'para esta área' : '(global)';
  const kindTxt = isException ? 'la excepción' : 'el bloqueo';
  if (!confirm(`¿Quitar ${kindTxt} de la categoría "${label}" ${scopeTxt}?`)) return;
  const params = new URLSearchParams();
  if (agentId) params.set('agent_id', agentId);
  if (sedeId) params.set('sede_id', sedeId);
  if (isException) params.set('is_exception', 'true');
  const qs = params.toString();
  await api(`/api/blocked-sites/categories/${key}${qs ? '?' + qs : ''}`, {method:'DELETE'});
  fetchParentalCategories();
  fetchBlockedSites();
}

async function toggleBlockedSite(id, active) {
  await api(`/api/blocked-sites/${id}`, {method:'PUT', body: JSON.stringify({active: !active})});
  fetchBlockedSites();
}

async function deleteBlockedSite(id) {
  if (!confirm('¿Eliminar este bloqueo?')) return;
  await api(`/api/blocked-sites/${id}`, {method:'DELETE'});
  fetchBlockedSites();
}

// ── Horario de bloqueo (Control parental ▸ Horario) ─────────────────────────
const WEEKDAYS = [
  ['mon','Lunes'], ['tue','Martes'], ['wed','Miércoles'], ['thu','Jueves'],
  ['fri','Viernes'], ['sat','Sábado'], ['sun','Domingo'],
];

function renderDayEditor(containerId, days) {
  const el = document.getElementById(containerId);
  el.innerHTML = WEEKDAYS.map(([key, label]) => {
    const rng = (days || {})[key];
    const checked = !!rng;
    const start = rng ? rng[0] : '06:00';
    const end   = rng ? rng[1] : '19:00';
    return `<div style="display:flex;align-items:center;gap:10px;padding:6px 0">
      <label style="display:flex;align-items:center;gap:8px;width:110px;font-size:13px;cursor:pointer">
        <input type="checkbox" data-day="${key}" ${checked?'checked':''} onchange="this.parentElement.nextElementSibling.querySelectorAll('input').forEach(i=>i.disabled=!this.checked)">
        ${label}
      </label>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="time" class="form-input" data-start="${key}" style="width:150px" value="${start}" ${checked?'':'disabled'}>
        <span style="color:var(--text-dim);font-size:12px">a</span>
        <input type="time" class="form-input" data-end="${key}" style="width:150px" value="${end}" ${checked?'':'disabled'}>
      </div>
    </div>`;
  }).join('');
}

function collectDaysFromEditor(containerId) {
  const el = document.getElementById(containerId);
  const days = {};
  WEEKDAYS.forEach(([key]) => {
    const cb = el.querySelector(`input[data-day="${key}"]`);
    if (cb && cb.checked) {
      const start = el.querySelector(`input[data-start="${key}"]`).value;
      const end   = el.querySelector(`input[data-end="${key}"]`).value;
      days[key] = [start, end];
    }
  });
  return days;
}

function scheduleSummary(s) {
  const parts = WEEKDAYS.filter(([k]) => s.days && s.days[k]).map(([k,label]) => `${label.slice(0,3)} ${s.days[k][0]}-${s.days[k][1]}`);
  return parts.length ? parts.join(', ') : 'Sin días configurados (nunca bloquea)';
}

async function fetchDefaultSchedule() {
  const s = await api('/api/block-schedules/default');
  if (!s) return;
  document.getElementById('default-schedule-status-badge').className = 'badge active';
  document.getElementById('default-schedule-status-badge').textContent = 'Activo';
  document.getElementById('default-schedule-summary').textContent = scheduleSummary(s);
}

// scheduleModalScope: 'default' | 'area' | 'equipo' — controla qué campos se ven y a qué endpoint se guarda
let scheduleModalScope = 'equipo';
let pendingOverrideSedeId = null;  // sede_id pendiente al crear el horario de un área por primera vez

async function editDefaultSchedule() {
  scheduleModalScope = 'default';
  pendingOverrideSedeId = null;
  const s = await api('/api/block-schedules/default');
  if (!s) return;
  document.getElementById('schedule-override-id').value = '';
  document.getElementById('schedule-override-scope-group').style.display = 'none';
  document.getElementById('schedule-override-expires-group').style.display = 'none';
  document.getElementById('schedule-override-title').textContent = 'Horario por defecto';
  document.getElementById('schedule-override-save-btn').textContent = 'Guardar';
  document.getElementById('schedule-override-error').style.display = 'none';
  document.getElementById('override-schedule-tz').value = s.timezone || 'America/Lima';
  renderDayEditor('override-schedule-days', s.days);
  openModal('modal-schedule-override');
}

async function fetchScheduleOverrides() {
  const rows = await api('/api/block-schedules/overrides');
  const body = document.getElementById('schedule-overrides-body');
  if (!rows) return;
  const agentRows = rows.filter(s => s.scope === 'agent');
  body.innerHTML = agentRows.length ? agentRows.map(s => `<tr>
    <td><strong>${s.target}</strong></td>
    <td style="font-size:12px;color:var(--text-mid)">${scheduleSummary(s)}</td>
    <td style="font-size:12px;color:var(--text-mid)">${s.expires_at ? s.expires_at.slice(0,10) : 'Sin expiración'}</td>
    <td style="display:flex;gap:6px;flex-wrap:wrap">
      <button class="btn btn-xs btn-ghost" onclick="editScheduleOverride('${s.id}')">Editar</button>
      <button class="btn btn-xs btn-danger" onclick="deleteScheduleOverride('${s.id}','${encodeURIComponent(s.target)}')">Eliminar</button>
    </td>
  </tr>`).join('') : `<tr><td colspan="4" style="text-align:center;color:var(--text-dim);padding:24px">No hay excepciones por equipo</td></tr>`;
}

async function fetchAreaSchedules() {
  const [overrides, def] = await Promise.all([
    api('/api/block-schedules/overrides'),
    api('/api/block-schedules/default'),
  ]);
  const body = document.getElementById('area-schedules-body');
  if (!overrides || !def) return;
  const bySede = {};
  overrides.filter(s => s.scope === 'sede').forEach(s => { bySede[s.sede_id] = s; });
  body.innerHTML = areas.length ? areas.map(a => {
    const o = bySede[a.id];
    const effective = o || def;
    return `<tr>
      <td><strong>${a.name}</strong></td>
      <td>${o ? '<span style="font-size:10px;color:var(--text-dim)">Personalizado</span>' : '<span style="font-size:10px;color:var(--text-dim)">Horario global</span>'}</td>
      <td style="font-size:12px;color:var(--text-mid)">${scheduleSummary(effective)}</td>
      <td style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-xs btn-primary" onclick="editAreaSchedule('${a.id}','${encodeURIComponent(a.name)}')">${o?'Editar':'Personalizar'}</button>
        ${o ? `<button class="btn btn-xs btn-ghost" onclick="deleteScheduleOverride('${o.id}','${encodeURIComponent(a.name)}')">Quitar personalización</button>` : ''}
      </td>
    </tr>`;
  }).join('') : `<tr><td colspan="4" style="text-align:center;color:var(--text-dim);padding:24px">No hay áreas creadas todavía</td></tr>`;
}

function openNewScheduleOverride() {
  scheduleModalScope = 'equipo';
  pendingOverrideSedeId = null;
  document.getElementById('schedule-override-id').value = '';
  document.getElementById('schedule-override-title').textContent = 'Agregar excepción por equipo';
  document.getElementById('schedule-override-save-btn').textContent = 'Guardar';
  document.getElementById('schedule-override-scope-group').style.display = 'block';
  document.getElementById('schedule-override-expires-group').style.display = 'block';
  document.getElementById('schedule-override-expires').value = '';

  const agentSel = document.getElementById('schedule-override-agent-select');
  agentSel.innerHTML = allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('schedule-override-agent-select');

  document.getElementById('override-schedule-tz').value = 'America/Lima';
  document.getElementById('schedule-override-error').style.display = 'none';
  openModal('modal-schedule-override');
  onScheduleAgentChange();  // precarga con el horario heredado del primer equipo de la lista
}

async function onScheduleAgentChange() {
  const agentId = document.getElementById('schedule-override-agent-select').value;
  if (!agentId) { renderDayEditor('override-schedule-days', {}); return; }
  const inherited = await api(`/api/block-schedules/inherited/${agentId}`);
  renderDayEditor('override-schedule-days', inherited ? inherited.days : {});
}

async function editScheduleOverride(id) {
  const rows = await api('/api/block-schedules/overrides');
  if (!rows) return;
  const s = rows.find(r => r.id === id);
  if (!s) return;
  scheduleModalScope = 'equipo';
  pendingOverrideSedeId = null;
  document.getElementById('schedule-override-id').value = s.id;
  document.getElementById('schedule-override-title').textContent = `Editar excepción — ${s.target}`;
  document.getElementById('schedule-override-save-btn').textContent = 'Guardar';
  document.getElementById('schedule-override-scope-group').style.display = 'none';
  document.getElementById('schedule-override-expires-group').style.display = 'block';
  document.getElementById('schedule-override-expires').value = s.expires_at ? s.expires_at.slice(0,10) : '';
  document.getElementById('override-schedule-tz').value = s.timezone || 'America/Lima';
  renderDayEditor('override-schedule-days', s.days);
  document.getElementById('schedule-override-error').style.display = 'none';
  openModal('modal-schedule-override');
}

async function editAreaSchedule(sedeId, nameEnc) {
  const name = decodeURIComponent(nameEnc);
  const overrides = await api('/api/block-schedules/overrides');
  const existing = overrides ? overrides.find(s => s.scope === 'sede' && s.sede_id === sedeId) : null;

  scheduleModalScope = 'area';
  document.getElementById('schedule-override-scope-group').style.display = 'none';
  document.getElementById('schedule-override-expires-group').style.display = 'none';
  document.getElementById('schedule-override-title').textContent = `Horario — ${name}`;
  document.getElementById('schedule-override-save-btn').textContent = 'Guardar';
  document.getElementById('schedule-override-error').style.display = 'none';

  if (existing) {
    pendingOverrideSedeId = null;
    document.getElementById('schedule-override-id').value = existing.id;
    document.getElementById('override-schedule-tz').value = existing.timezone || 'America/Lima';
    renderDayEditor('override-schedule-days', existing.days);
  } else {
    pendingOverrideSedeId = sedeId;
    document.getElementById('schedule-override-id').value = '';
    document.getElementById('override-schedule-tz').value = 'America/Lima';
    const def = await api('/api/block-schedules/default');
    renderDayEditor('override-schedule-days', def ? def.days : {});
  }
  openModal('modal-schedule-override');
}

async function saveScheduleOverride() {
  const id = document.getElementById('schedule-override-id').value;
  const timezone = document.getElementById('override-schedule-tz').value.trim() || 'America/Lima';
  const days = collectDaysFromEditor('override-schedule-days');
  const err = document.getElementById('schedule-override-error');
  err.style.display = 'none';

  try {
    if (scheduleModalScope === 'default') {
      await api('/api/block-schedules/default', {method:'PUT', body: JSON.stringify({enabled: true, timezone, days})});
    } else if (id) {
      const body = {enabled: true, timezone, days};
      if (scheduleModalScope === 'equipo') body.expires_at = document.getElementById('schedule-override-expires').value || null;
      await api(`/api/block-schedules/overrides/${id}`, {method:'PUT', body: JSON.stringify(body)});
    } else {
      const body = {enabled: true, timezone, days};
      if (scheduleModalScope === 'area') {
        body.sede_id = pendingOverrideSedeId;
      } else {
        body.agent_id = document.getElementById('schedule-override-agent-select').value;
        body.expires_at = document.getElementById('schedule-override-expires').value || null;
      }
      await api('/api/block-schedules/overrides', {method:'POST', body: JSON.stringify(body)});
    }
  } catch (e) {
    err.textContent = e.message || 'No se pudo guardar.';
    err.style.display = 'block';
    return;
  }
  closeModal('modal-schedule-override');
  fetchDefaultSchedule();
  fetchScheduleOverrides();
  fetchAreaSchedules();
}

async function deleteScheduleOverride(id, targetEnc) {
  if (!confirm(`¿Eliminar la excepción de horario para "${decodeURIComponent(targetEnc)}"? Volverá a usar el horario heredado.`)) return;
  await api(`/api/block-schedules/overrides/${id}`, {method:'DELETE'});
  fetchScheduleOverrides();
  fetchAreaSchedules();
}

// ── Redes WiFi (botón en Control parental ▸ Bloqueo de sitios) ─────────────
let networkGateList = [];

function _setNetworkGateButton(cfg) {
  const btn = document.getElementById('network-gate-toggle-btn');
  if (!btn) return;
  const on = !!(cfg && cfg.enabled);
  btn.className = on ? 'btn btn-primary' : 'btn btn-ghost';
  btn.title = on
    ? `Restricción por red WiFi activa (${(cfg.networks || []).length} red${(cfg.networks || []).length === 1 ? '' : 'es'}) — clic para configurar`
    : 'Configurar restricción por red WiFi (desactivada)';
  btn.style.width = '38px';
  btn.style.height = '38px';
  btn.style.padding = '0';
  btn.style.borderRadius = '50%';
  btn.style.display = 'flex';
  btn.style.alignItems = 'center';
  btn.style.justifyContent = 'center';
}

async function refreshNetworkGateButton() {
  const cfg = await api('/api/network-gate');
  if (cfg) _setNetworkGateButton(cfg);
}

async function openNetworkGateModal() {
  const cfg = await api('/api/network-gate');
  if (!cfg) return;
  document.getElementById('network-gate-enabled').checked = cfg.enabled;
  networkGateList = cfg.networks || [];
  document.getElementById('network-gate-hint').textContent = '';
  renderNetworkGate();

  try {
    const intervalCfg = await api('/api/config/interval');
    const blSel = document.getElementById('modal-blocklist-interval-select');
    if (blSel) {
      const blInterval = intervalCfg.blocklist_interval || 60;
      const blOpts = Array.from(blSel.options).map(o => parseInt(o.value));
      const blClosest = blOpts.reduce((a, b) => Math.abs(b - blInterval) < Math.abs(a - blInterval) ? b : a);
      blSel.value = String(blClosest);
    }
  } catch {}

  openModal('modal-network-gate');
}

function renderNetworkGate() {
  const enabled = document.getElementById('network-gate-enabled').checked;
  document.getElementById('network-gate-list-wrap').style.opacity = enabled ? '1' : '.5';
  document.getElementById('network-gate-onoff-modal').textContent = enabled ? 'ON' : 'OFF';
  document.getElementById('network-gate-chips').innerHTML = networkGateList.length
    ? networkGateList.map(n => `<span class="badge active" style="margin-right:4px">${n} <a href="#" onclick="event.preventDefault();removeNetworkGateEntry('${encodeURIComponent(n)}')" style="color:inherit;margin-left:4px;text-decoration:none">✕</a></span>`).join('')
    : `<div style="font-size:12px;color:var(--text-dim)">Todavía no agregaste ninguna red.</div>`;
}

function addNetworkGateEntry() {
  const input = document.getElementById('network-gate-input');
  const val = input.value.trim();
  if (!val) return;
  if (!networkGateList.some(n => n.toLowerCase() === val.toLowerCase())) {
    networkGateList.push(val);
  }
  input.value = '';
  renderNetworkGate();
}

function removeNetworkGateEntry(nameEnc) {
  const name = decodeURIComponent(nameEnc);
  networkGateList = networkGateList.filter(n => n !== name);
  renderNetworkGate();
}

async function saveNetworkGate() {
  let enabled = document.getElementById('network-gate-enabled').checked;
  const hint = document.getElementById('network-gate-hint');
  hint.textContent = '';
  // Si se activa sin definir ninguna red, no tiene sentido dejarlo encendido:
  // se apaga solo en vez de bloquear el guardado con un error.
  if (enabled && networkGateList.length === 0) {
    enabled = false;
    document.getElementById('network-gate-enabled').checked = false;
    hint.textContent = 'Se desactivó automáticamente porque no definiste ninguna red WiFi.';
  }
  const cfg = await api('/api/network-gate', {method: 'PUT', body: {enabled, networks: networkGateList}});
  if (cfg) _setNetworkGateButton(cfg);
  if (!hint.textContent) closeModal('modal-network-gate');
}

// ── Intentos bloqueados (Control parental ▸ Intentos bloqueados) ───────────
function fmtLocalDatetime(ts) {
  if (!ts) return '--';
  return ts.replace('T', ' ').slice(0, 16);
}

async function initBlockAttempts() {
  const sedeSel = document.getElementById('attempts-sede-filter');
  sedeSel.innerHTML = '<option value="">Todas</option>' +
    areas.map(a => `<option value="${a.id}">${a.name}</option>`).join('') +
    '<option value="__none__">Sin área asignada</option>';
  const agentSel = document.getElementById('attempts-agent-filter');
  agentSel.innerHTML = '<option value="">Todos</option>' +
    allAgents.map(a => `<option value="${a.id}">${a.display_name || a.hostname}</option>`).join('');
  enhanceSearchableSelect('attempts-agent-filter');
  await Promise.all([fetchBlockAttempts(), fetchAttemptsRetention()]);
}

async function fetchBlockAttempts() {
  const sedeId = document.getElementById('attempts-sede-filter').value;
  const agentId = document.getElementById('attempts-agent-filter').value;
  const days = document.getElementById('attempts-days-filter').value;
  const status = document.getElementById('attempts-status-filter').value;
  const params = new URLSearchParams({days});
  if (sedeId) params.set('sede_id', sedeId);
  if (agentId) params.set('agent_id', agentId);
  if (status) params.set('status', status);
  const data = await api(`/api/block-attempts?${params.toString()}`);
  if (!data) return;
  const rows = data.items || [];
  const info = document.getElementById('attempts-results-info');
  if (info) {
    info.textContent = `${data.filtered_count} de ${data.total_count} intentos en el rango · ~${data.rate_per_minute} intentos/minuto (promedio)`;
  }
  document.getElementById('attempts-body').innerHTML = rows.length ? rows.map(r => `
    <tr>
      <td>${r.date}</td>
      <td>${r.agent_name}</td>
      <td style="font-size:12px;color:var(--text-mid)">${r.tailnet_ip || '—'}</td>
      <td>${r.sede_name || '--'}</td>
      <td>${r.domain}</td>
      <td>${r.blocked ? '<span class="badge offline">Bloqueado</span>' : '<span class="badge active">Exitoso</span>'}${r.has_exception ? `<div style="font-size:11px;color:var(--text-dim);margin-top:3px">Excepción: ${r.exception_reason || 'sin motivo'}${r.exception_expires ? ` · expira ${r.exception_expires.slice(0,10)}` : ''}</div>` : ''}</td>
      <td style="text-align:right;font-weight:600">${r.count}</td>
      <td style="font-size:12px;color:var(--text-mid)">${fmtLocalDatetime(r.last_seen)}</td>
    </tr>`).join('') : `<tr><td colspan="8" style="text-align:center;color:var(--text-dim);padding:24px">Sin intentos registrados en este rango.</td></tr>`;
}

let _tunnelAgentsCache = [];

function _tunnelStatusKey(a) {
  if (a.tailnet_ip && a.status === 'online') return 'conectado';
  if (a.tailnet_ip) return 'desconectado';
  return 'no_conectado';
}

async function fetchWireguardTunnel() {
  const data = await api('/api/agents');
  if (!data) return;
  _tunnelAgentsCache = [...data].sort((a, b) => (b.tailnet_ip ? 1 : 0) - (a.tailnet_ip ? 1 : 0));
  applyTunnelFilter();
}

function applyTunnelFilter() {
  const search = (document.getElementById('tun-filter-search')?.value || '').toLowerCase().trim();
  const status = document.getElementById('tun-filter-status')?.value || '';

  const rows = _tunnelAgentsCache.filter(a => {
    if (search) {
      const name = (a.display_name || a.hostname || '').toLowerCase();
      const serial = (a.serial_number || '').toLowerCase();
      if (!(name.includes(search) || serial.includes(search))) return false;
    }
    if (status && _tunnelStatusKey(a) !== status) return false;
    return true;
  });

  const info = document.getElementById('tun-results-info');
  if (info) info.textContent = rows.length ? `${rows.length} de ${_tunnelAgentsCache.length} equipo${_tunnelAgentsCache.length!==1?'s':''}` : '';

  document.getElementById('tunnel-body').innerHTML = rows.length ? rows.map(a => {
    // tailnet_ip por si solo no alcanza: si el equipo se desinstalo (o esta
    // apagado) sin llegar a reportar que el tunel se cerro, la IP queda
    // pegada con el ultimo valor real. Se cruza con el mismo "online" que
    // ya usa el resto del panel (basado en hace cuanto no reporta), no en
    // un aviso explicito de desinstalacion que puede no llegar nunca.
    let badge;
    if (a.tailnet_ip && a.status === 'online') {
      badge = '<span class="badge active">Conectado</span>';
    } else if (a.tailnet_ip) {
      badge = '<span class="badge offline">Desconectado (equipo sin reportar)</span>';
    } else {
      badge = '<span class="badge offline">No conectado</span>';
    }
    return `
    <tr>
      <td>${a.display_name || a.hostname}</td>
      <td style="font-size:12px;color:var(--text-mid)">${a.serial_number || '—'}</td>
      <td style="font-size:12px;color:var(--text-mid)">${a.tailnet_ip || '—'}</td>
      <td>${badge}</td>
    </tr>`;
  }).join('') : `<tr><td colspan="4" style="text-align:center;color:var(--text-dim);padding:24px">${_tunnelAgentsCache.length?'Sin resultados para los filtros seleccionados':'No hay equipos registrados.'}</td></tr>`;
}

function clearTunnelFilter() {
  ['tun-filter-search','tun-filter-status'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  applyTunnelFilter();
}

async function fetchAttemptsRetention() {
  const cfg = await api('/api/block-attempts/retention');
  if (!cfg) return;
  document.getElementById('attempts-retention-select').value = cfg.retention_days ? String(cfg.retention_days) : '';
}

function openAttemptsRetentionModal() {
  fetchAttemptsRetention();
  openModal('modal-attempts-retention');
}

async function saveAttemptsRetention() {
  const v = document.getElementById('attempts-retention-select').value;
  await api('/api/block-attempts/retention', {method: 'PUT', body: {retention_days: v ? parseInt(v) : null}});
  closeModal('modal-attempts-retention');
}

// ── Editar agente ──────────────────────────────────────────────────────────
function openEditAgent() {
  const a = allAgents.find(x => x.id === currentAgentId);
  if (!a) return;
  document.getElementById('agent-display-name').value  = a.display_name || a.hostname;
  document.getElementById('agent-sede-select').value  = a.sede_id || '';
  document.getElementById('agent-notes').value        = a.notes || '';
  document.getElementById('agent-purchase-date').value  = a.purchase_date || '';
  document.getElementById('agent-invoice-number').value = a.invoice_number || '';
  const dtSel = document.getElementById('agent-device-type');
  dtSel.innerHTML = deviceTypeNames().map(t => `<option value="${t}">${t}</option>`).join('');
  dtSel.value = a.device_type || '';
  dtSel.dataset.current = a.device_type || '';
  openModal('modal-agent');
}

async function saveAgent() {
  const body = {
    display_name: document.getElementById('agent-display-name').value,
    sede_id:      document.getElementById('agent-sede-select').value || null,
    notes:        document.getElementById('agent-notes').value,
    device_type:  document.getElementById('agent-device-type').value || null,
    purchase_date:  document.getElementById('agent-purchase-date').value || null,
    invoice_number: document.getElementById('agent-invoice-number').value || null,
  };
  await api(`/api/agents/${currentAgentId}`, {method:'PUT', body: JSON.stringify(body)});
  closeModal('modal-agent');
  await fetchAgents();
  const fresh = allAgents.find(a => a.id === currentAgentId);
  if (fresh) {
    updateDetailMetrics(fresh);
    document.getElementById('agent-device-type').value = fresh.device_type || '';
    document.getElementById('agent-device-type').dataset.current = fresh.device_type || '';
  }
}


// ── Modales ────────────────────────────────────────────────────────────────
// ── Tipo de dispositivo e historial de cambios ──────────────────────────────
const ICON_LAPTOP = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M2 20h20"/></svg>';
const ICON_DESKTOP = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="12" rx="1"/><path d="M8 21h8M12 15v6"/></svg>';
const ICON_TABLET = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M11 18h2"/></svg>';
const ICON_SERVER = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="1"/><rect x="3" y="13" width="18" height="7" rx="1"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>';
const ICON_PHONE = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>';
const ICON_OTHER = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/><path d="M8 7h.01M8 17h.01"/></svg>';
const DEVICE_ICON_KEYS = { laptop:ICON_LAPTOP, desktop:ICON_DESKTOP, tablet:ICON_TABLET, server:ICON_SERVER, phone:ICON_PHONE, other:ICON_OTHER };
const DEVICE_ICON_OPTIONS = [
  {key:'laptop',  label:'Laptop'},
  {key:'desktop', label:'PC / Escritorio'},
  {key:'tablet',  label:'Tablet'},
  {key:'server',  label:'Servidor'},
  {key:'phone',   label:'Teléfono'},
  {key:'other',   label:'Otro'},
];
// "Tipo de dispositivo" (para equipos monitoreados) ya no vive en su propio
// config separado - allAssetTypes (la misma tabla que usa "Otros activos")
// es la unica fuente para ambos, unificado en un solo lugar.
function deviceTypeNames() {
  const names = (allAssetTypes || []).map(t => t.name);
  (allAgents || []).forEach(a => { if (a.device_type && !names.includes(a.device_type)) names.push(a.device_type); });
  return [...new Set(names)];
}
function deviceTypeIcon(t) {
  const cfg = (allAssetTypes || []).find(d => d.name === t);
  return deviceTypePreview(cfg ? cfg.icon : 'other');
}
const CHANGE_FIELD_LABEL = { RAM:'RAM', 'Batería':'Batería', Fuente:'Fuente de poder', Disco:'Disco', Otro:'Otro', Baja:'Baja de equipo', EnObservacion:'En observación', Reactivacion:'Reactivación', SistemaOperativo:'Sistema operativo' };

let _changeAgentId = null;
let _changeEditRecordId = null; // id del registro en edición (null = registrando uno nuevo)

// ── Filtro/datalist de "Tipo" en Inventario (equipos monitoreados) ─────────
function renderDeviceTypeFilter() {
  const sel = document.getElementById('inv-filter-type');
  if (!sel) return;
  const cur = sel.value;
  sel.innerHTML = '<option value="">Todos</option>' +
    deviceTypeNames().map(t => `<option value="${t}">${t}</option>`).join('');
  sel.value = cur;
}
function updateDtypeDatalist() {
  const dl = document.getElementById('dtypes');
  if (dl) dl.innerHTML = deviceTypeNames().map(t => `<option value="${t}">`).join('');
}

function openDeviceTypesModal() {
  renderAssetTypesList();
  closeAssetTypeForm();
  openModal('modal-device-types');
}
function deviceTypePreview(icon) {
  if (typeof icon === 'string' && icon.startsWith('data:')) {
    return `<img src="${icon}" style="width:24px;height:24px;vertical-align:middle">`;
  }
  return DEVICE_ICON_KEYS[icon] || ICON_OTHER;
}

async function setAgentDeviceType(id, val) {
  try {
    await api(`/api/agents/${id}`, {method:'PUT', body: JSON.stringify({device_type: val})});
    await fetchAgents();
  } catch (e) { alert(e.message || 'No se pudo guardar el tipo de dispositivo.'); }
}

function openChangeHistory(id) {
  _changeAgentId = id;
  _changeEditRecordId = null;
  document.getElementById('modal-change-history-title').textContent = 'Registrar cambio / mantenimiento';
  document.getElementById('ch-field').value = 'RAM';
  const d = document.getElementById('ch-date');
  if (d) d.value = new Date().toISOString().slice(0, 10);
  document.getElementById('ch-note').value = '';
  updateChangeFieldIcon();
  openModal('modal-change-history');
}

function openEditChangeModal(id, recordId) {
  const rec = (_changeRowsCache[id] || []).find(r => r.id === recordId);
  if (!rec) return;
  _changeAgentId = id;
  _changeEditRecordId = recordId;
  document.getElementById('modal-change-history-title').textContent = 'Editar registro de cambio';
  document.getElementById('ch-field').value = rec.field;
  document.getElementById('ch-date').value  = rec.change_date || '';
  document.getElementById('ch-note').value  = rec.note || '';
  updateChangeFieldIcon();
  openModal('modal-change-history');
}

async function saveAgentChange() {
  const field = document.getElementById('ch-field').value;
  const change_date = document.getElementById('ch-date').value;
  const note = document.getElementById('ch-note').value.trim();
  if (!field || !change_date || !note) {
    alert('Todos los campos son obligatorios: componente, fecha de cambio y motivo.');
    return;
  }
  const body = { field, change_date, note };
  try {
    if (_changeEditRecordId) {
      await api(`/api/agents/${_changeAgentId}/changes/${_changeEditRecordId}`, {method:'PUT', body: JSON.stringify(body)});
    } else {
      await api(`/api/agents/${_changeAgentId}/changes`, {method:'POST', body: JSON.stringify(body)});
    }
    closeModal('modal-change-history');
    if (_ahpAgentId === _changeAgentId && _ahpTab === 'hardware' && document.getElementById('modal-agent-history').classList.contains('open')) {
      await renderHistoryPanelHardware(_changeAgentId);
    }
  } catch (e) { alert(e.message || 'No se pudo registrar el cambio.'); }
}

// ── Panel lateral: Historial del equipo (Asignaciones / Cambios de hardware / Eventos / Notas) ──
let _ahpAgentId = null;
let _ahpTab = 'assignments';
let _assignmentAgentId = null;
let _assignmentMode = 'assign'; // 'assign' | 'return' | 'edit'
let _assignmentRecordId = null; // id del registro abierto a devolver/editar
let _assignmentRowsCache = {}; // agentId -> registros de asignación tal como vinieron de la API
let _changeRowsCache = {};     // agentId -> registros de historial de cambios

const AHP_ICON_PERSON  = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>';
const AHP_ICON_BATTERY  = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.67 4H15V2H9v2H7.33C6.6 4 6 4.6 6 5.33v15.33C6 21.4 6.6 22 7.33 22h9.33c.74 0 1.34-.6 1.34-1.33V5.33C18 4.6 17.4 4 16.67 4z"/></svg>';
const AHP_ICON_BOLT     = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66l.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"/></svg>';
const AHP_ICON_WRENCH   = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>';

function ahpFieldIconSvg(kind) {
  if (kind === 'ram') return INV_RAM_ICON;
  if (kind === 'disk') return INV_DISK_ICON;
  if (kind === 'battery') return AHP_ICON_BATTERY;
  if (kind === 'bolt') return AHP_ICON_BOLT;
  if (kind === 'os') return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="${HIST_ICON_PATHS.os_change}"/></svg>`;
  return AHP_ICON_WRENCH;
}
const AHP_FIELD_META = {
  RAM:               {title:'Memoria RAM actualizada',    icon:'ram',     color:'blue'},
  'Batería':         {title:'Batería reemplazada',        icon:'battery', color:'green'},
  Fuente:            {title:'Fuente reemplazada',         icon:'bolt',    color:'yellow'},
  Disco:             {title:'Disco reemplazado',          icon:'disk',    color:'purple'},
  Otro:              {title:'Componente actualizado',     icon:'wrench',  color:'yellow'},
  SistemaOperativo:  {title:'Sistema operativo cambiado', icon:'os',      color:'blue'},
  Baja:              {title:'Equipo dado de baja',        icon:'wrench',  color:'red'},
  EnObservacion:     {title:'Marcado en observación',     icon:'wrench',  color:'yellow'},
  Reactivacion:      {title:'Reactivado',                 icon:'wrench',  color:'green'},
};

// Ícono en vivo junto al selector "Tipo" del modal de registrar/editar cambio
// de hardware - cambia según la opción elegida (mismo set que usa la lista
// de "Cambios de hardware" del panel, para que se vea consistente).
function updateChangeFieldIcon() {
  const field = document.getElementById('ch-field').value;
  const meta = AHP_FIELD_META[field] || {icon: 'wrench', color: 'yellow'};
  const el = document.getElementById('ch-field-icon');
  el.className = `s-icon ${meta.color}`;
  el.innerHTML = ahpFieldIconSvg(meta.icon);
}

function ahpEmpty(msg) {
  return `<div style="text-align:center;padding:24px 10px;color:var(--text-dim);font-size:13px;border:1px dashed var(--border);border-radius:10px">${msg}</div>`;
}

function openAgentHistoryPanel(id, tab) {
  const a = allAgents.find(x => x.id === id);
  if (!a) return;
  _ahpAgentId = id;
  document.getElementById('ahp-hostname').textContent = a.display_name || a.hostname;
  document.getElementById('ahp-model').textContent = [a.manufacturer, a.model].filter(Boolean).join(' ') || '--';
  document.getElementById('ahp-serial').textContent = 'Serie: ' + (a.serial_number || '--');
  document.getElementById('ahp-user').textContent = a.assigned_user_name || '--';
  const online = a.status === 'online';
  document.getElementById('ahp-status').innerHTML = `<span style="color:${online?'var(--green)':'var(--red)'};font-weight:600">● ${online?'Online':'Offline'}</span>`;
  document.getElementById('ahp-area').textContent = a.sede || '--';
  openModal('modal-agent-history');
  setHistoryPanelTab(tab || 'assignments');
}

function setHistoryPanelTab(tab) {
  _ahpTab = tab;
  document.querySelectorAll('.side-panel-tab').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  if (tab === 'assignments') renderHistoryPanelAssignments(_ahpAgentId);
  else if (tab === 'hardware') renderHistoryPanelHardware(_ahpAgentId);
  else if (tab === 'events') renderHistoryPanelEvents(_ahpAgentId);
  else if (tab === 'notes') renderHistoryPanelNotes(_ahpAgentId);
}

async function renderHistoryPanelAssignments(id) {
  const body = document.getElementById('ahp-body');
  body.innerHTML = '<div style="text-align:center;padding:30px 0;color:var(--text-dim)">Cargando…</div>';
  try {
    const rows = await api(`/api/agents/${id}/assignments`);
    _assignmentRowsCache[id] = rows || [];
    if (!rows || !rows.length) { body.innerHTML = ahpEmpty('📋 Sin asignaciones registradas para este equipo.'); return; }
    const items = [];
    rows.forEach(r => {
      items.push({label:'Asignado', name:r.assigned_to_name, date:r.assigned_at, note:r.delivery_notes, recordId:r.id});
      if (r.returned_at) items.push({label:'Devuelto', name:r.assigned_to_name, date:r.returned_at, note:r.return_notes, recordId:r.id});
    });
    items.sort((x, y) => (y.date || '').localeCompare(x.date || ''));
    if (_ahpAgentId !== id) return; // el panel cambió de equipo mientras esperábamos
    body.innerHTML = items.map(it => `<div class="ahp-item">
      <div class="s-icon blue ahp-item-icon">${AHP_ICON_PERSON}</div>
      <div class="ahp-item-body">
        <div class="ahp-item-title">${it.label}</div>
        <div class="ahp-item-sub">${it.name || '--'}</div>
        ${it.note ? `<div class="ahp-item-sub">${it.note}</div>` : ''}
      </div>
      <div>
        <div class="ahp-item-date">${it.date || '--'}</div>
        <button class="btn btn-ghost btn-sm" style="padding:2px 6px;margin-top:4px" title="Editar" onclick="openEditAssignmentModal('${id}',${it.recordId})">✎</button>
      </div>
    </div>`).join('');
  } catch (e) { body.innerHTML = `<div style="color:var(--red)">${e.message || 'Error'}</div>`; }
}

async function renderHistoryPanelHardware(id) {
  const body = document.getElementById('ahp-body');
  body.innerHTML = '<div style="text-align:center;padding:30px 0;color:var(--text-dim)">Cargando…</div>';
  try {
    const rows = await api(`/api/agents/${id}/changes`);
    _changeRowsCache[id] = rows || [];
    if (_ahpAgentId !== id) return;
    const addBtn = `<div style="display:flex;justify-content:flex-end;gap:8px;margin-bottom:14px">
      <button class="btn btn-ghost btn-sm" onclick="openReviewStatusModal('${id}')">Cambiar estado</button>
      <button class="btn btn-primary btn-sm" onclick="openChangeHistory('${id}')">+ Registrar cambio</button>
    </div>`;
    if (!rows || !rows.length) { body.innerHTML = addBtn + ahpEmpty('🗒️ Sin cambios registrados para este equipo.'); return; }
    const list = rows.map(r => {
      const meta = AHP_FIELD_META[r.field] || {title: CHANGE_FIELD_LABEL[r.field] || r.field, icon: 'wrench', color: 'yellow'};
      const diff = (r.old_value || r.new_value) ? `${r.old_value || '—'} → ${r.new_value || '—'}` : (r.note || '');
      const date = r.change_date || (r.changed_at ? r.changed_at.slice(0, 10) : '--');
      return `<div class="ahp-item">
        <div class="s-icon ${meta.color} ahp-item-icon">${ahpFieldIconSvg(meta.icon)}</div>
        <div class="ahp-item-body">
          <div class="ahp-item-title">${meta.title}</div>
          <div class="ahp-item-sub">${diff}</div>
          ${r.changed_by ? `<div class="ahp-item-sub">Realizado por ${r.changed_by}</div>` : ''}
        </div>
        <div>
          <div class="ahp-item-date">${date}</div>
          <button class="btn btn-ghost btn-sm" style="padding:2px 6px;margin-top:4px" title="Editar" onclick="openEditChangeModal('${id}',${r.id})">✎</button>
        </div>
      </div>`;
    }).join('');
    body.innerHTML = addBtn + list;
  } catch (e) { body.innerHTML = `<div style="color:var(--red)">${e.message || 'Error'}</div>`; }
}

async function renderHistoryPanelEvents(id) {
  const body = document.getElementById('ahp-body');
  body.innerHTML = '<div style="text-align:center;padding:30px 0;color:var(--text-dim)">Cargando…</div>';
  try {
    const rows = await api(`/api/agents/${id}/events`);
    if (_ahpAgentId !== id) return;
    if (!rows || !rows.length) { body.innerHTML = ahpEmpty('Sin eventos registrados.'); return; }
    body.innerHTML = rows.slice(0, 50).map(e => {
      const meta = eventMeta(e.type);
      const [datePart, timePart] = fmtDatetime(e.timestamp).split(' ');
      return `<div class="ahp-item">
        <div class="s-icon ${meta.color} ahp-item-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="${meta.path}"/></svg></div>
        <div class="ahp-item-body">
          <div class="ahp-item-title">${e.detail || '--'}</div>
          ${e.reason ? `<div class="ahp-item-sub">${e.reason}</div>` : ''}
        </div>
        <div class="ahp-item-date">${datePart}<br>${timePart}</div>
      </div>`;
    }).join('');
  } catch (e) { body.innerHTML = `<div style="color:var(--red)">${e.message || 'Error'}</div>`; }
}

function renderHistoryPanelNotes(id) {
  const a = allAgents.find(x => x.id === id);
  document.getElementById('ahp-body').innerHTML = `
    <textarea class="form-input" id="ahp-notes-text" rows="10" style="resize:vertical;font-size:13px" placeholder="Sin notas para este equipo...">${a && a.notes ? a.notes : ''}</textarea>
    <div style="text-align:right;margin-top:10px"><button class="btn btn-primary btn-sm" onclick="saveHistoryPanelNotes('${id}')">Guardar notas</button></div>`;
}

async function saveHistoryPanelNotes(id) {
  await api(`/api/agents/${id}`, {method: 'PUT', body: JSON.stringify({notes: document.getElementById('ahp-notes-text').value})});
  await fetchAgents();
}

async function openAssignModal(id) {
  _assignmentAgentId = id;
  _assignmentMode = 'assign';
  _assignmentRecordId = null;
  document.getElementById('modal-assignment-title').textContent = 'Asignar equipo';
  document.getElementById('asg-section-assign').style.display = '';
  document.getElementById('asg-section-return').style.display = 'none';
  document.getElementById('asg-section-edit').style.display = 'none';
  const au = document.getElementById('asg-user');
  if (au) {
    au.innerHTML = '<option value="">Sin asignar</option>' +
      (allUsers || []).map(u => `<option value="${u.id}">${u.name}</option>`).join('');
    au.value = '';
  }
  const dateInput = document.getElementById('asg-assigned-at');
  dateInput.value = '';
  dateInput.min = '';
  document.getElementById('asg-assignment-notes').value = '';
  openModal('modal-assignment');
  // No permitir elegir una fecha de asignación anterior a la devolución del
  // registro más reciente — evita solapar con una asignación ya cerrada.
  try {
    const rows = await api(`/api/agents/${id}/assignments`);
    _assignmentRowsCache[id] = rows || [];
    const latest = (rows || [])[0];
    if (latest && latest.returned_at) dateInput.min = latest.returned_at;
  } catch {}
}

function openReturnModal(id, recordId) {
  _assignmentAgentId = id;
  _assignmentMode = 'return';
  _assignmentRecordId = recordId;
  document.getElementById('modal-assignment-title').textContent = 'Devolver equipo';
  document.getElementById('asg-section-assign').style.display = 'none';
  document.getElementById('asg-section-return').style.display = '';
  document.getElementById('asg-section-edit').style.display = 'none';
  document.getElementById('asg-returned-at').value  = '';
  document.getElementById('asg-return-notes').value = '';
  openModal('modal-assignment');
}

function openEditAssignmentModal(id, recordId) {
  const rec = (_assignmentRowsCache[id] || []).find(r => r.id === recordId);
  if (!rec) return;
  _assignmentAgentId = id;
  _assignmentMode = 'edit';
  _assignmentRecordId = recordId;
  document.getElementById('modal-assignment-title').textContent = 'Editar registro de asignación';
  document.getElementById('asg-section-assign').style.display = 'none';
  document.getElementById('asg-section-return').style.display = 'none';
  document.getElementById('asg-section-edit').style.display = '';
  const au = document.getElementById('asg-edit-user');
  au.innerHTML = '<option value="">Sin asignar</option>' +
    (allUsers || []).map(u => `<option value="${u.id}">${u.name}</option>`).join('');
  au.value = rec.assigned_to || '';
  document.getElementById('asg-edit-assigned-at').value    = rec.assigned_at || '';
  document.getElementById('asg-edit-delivery-notes').value = rec.delivery_notes || '';
  document.getElementById('asg-edit-returned-at').value    = rec.returned_at || '';
  document.getElementById('asg-edit-return-notes').value   = rec.return_notes || '';
  openModal('modal-assignment');
}

async function saveAssignment() {
  const id = _assignmentAgentId;
  if (!id) return;
  try {
    if (_assignmentMode === 'return' && _assignmentRecordId) {
      await api(`/api/agents/${id}/assignments/${_assignmentRecordId}`, {method:'PUT', body: {
        returned_at:  document.getElementById('asg-returned-at').value || null,
        return_notes: document.getElementById('asg-return-notes').value,
      }});
    } else if (_assignmentMode === 'edit' && _assignmentRecordId) {
      await api(`/api/agents/${id}/assignments/${_assignmentRecordId}`, {method:'PUT', body: {
        assigned_to:     document.getElementById('asg-edit-user').value || null,
        assigned_at:     document.getElementById('asg-edit-assigned-at').value || null,
        delivery_notes:  document.getElementById('asg-edit-delivery-notes').value,
        returned_at:     document.getElementById('asg-edit-returned-at').value || null,
        return_notes:    document.getElementById('asg-edit-return-notes').value,
      }});
    } else {
      await api(`/api/agents/${id}/assignments`, {method:'POST', body: {
        assigned_to:    document.getElementById('asg-user').value || null,
        assigned_at:    document.getElementById('asg-assigned-at').value || null,
        delivery_notes: document.getElementById('asg-assignment-notes').value,
      }});
    }
    closeModal('modal-assignment');
    await fetchAgents();
    if (_ahpAgentId === id && _ahpTab === 'assignments' && document.getElementById('modal-agent-history').classList.contains('open')) {
      await renderHistoryPanelAssignments(id);
    }
    const fresh = allAgents.find(a => a.id === id);
    if (fresh) updateDetailMetrics(fresh);
  } catch (e) { alert(e.message || 'No se pudo guardar la asignación.'); }
}

let _reviewStatusAgentId = null;
function openReviewStatusModal(id) {
  const a = allAgents.find(x => x.id === id);
  if (!a) return;
  _reviewStatusAgentId = id;
  document.getElementById('rs-select').value = a.review_status || '';
  document.getElementById('rs-note').value = '';
  updateReviewStatusHint();
  openModal('modal-review-status');
}

function updateReviewStatusHint() {
  const a = allAgents.find(x => x.id === _reviewStatusAgentId);
  const val = document.getElementById('rs-select').value;
  const hint = document.getElementById('rs-hint');
  const isAssigned = a && a.assigned_user && !a.returned_at;
  hint.textContent = (val === 'baja' && isAssigned)
    ? 'Este equipo está asignado actualmente — al darlo de baja se cerrará esa asignación automáticamente (devolución de hoy).'
    : '';
  // El motivo es obligatorio siempre (En observación, Baja o al volver a
  // Normal/Disponible) — queda registrado en el historial de cambios.
  document.getElementById('rs-note-group').style.display = '';
  document.getElementById('rs-note-label').textContent = 'Motivo (obligatorio)';
}
document.getElementById('rs-select') && document.getElementById('rs-select').addEventListener('change', updateReviewStatusHint);

async function saveReviewStatus() {
  const id = _reviewStatusAgentId;
  if (!id) return;
  const status = document.getElementById('rs-select').value || null;
  const note = document.getElementById('rs-note').value.trim();
  if (!note) {
    alert('Indica el motivo.');
    return;
  }
  try {
    await api(`/api/agents/${id}/review-status`, {method:'PUT', body: { status, note }});
    closeModal('modal-review-status');
    await fetchAgents();
    if (_ahpAgentId === id && _ahpTab === 'hardware' && document.getElementById('modal-agent-history').classList.contains('open')) {
      await renderHistoryPanelHardware(id);
    }
  } catch (e) { alert(e.message || 'No se pudo actualizar el estado del equipo.'); }
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click', e => {
  if (e.target === m && m.id !== 'modal-force-change') m.classList.remove('open');
}));

// ── Descubrimiento de red ──────────────────────────────────────────────────
function _discoveryShow(id) {
  ['discovery-scanning','discovery-empty','discovery-results'].forEach(el =>
    document.getElementById(el).style.display = el === id ? 'block' : 'none'
  );
}

async function runDiscovery() {
  const subnet = document.getElementById('discovery-subnet').value.trim();
  if (!subnet) { alert('Ingresa un rango de red'); return; }
  const btn = document.getElementById('discovery-btn');
  btn.disabled = true;
  btn.textContent = 'Escaneando...';
  _discoveryShow('discovery-scanning');
  document.getElementById('discovery-scanning-label').textContent = `Escaneando ${subnet}...`;
  try {
    const data = await api('/api/discovery/scan', { method: 'POST', body: { subnet } });
    if (!data || data.error) { alert('Error: ' + (data?.error || 'sin respuesta')); _discoveryShow(null); return; }
    if (data.total === 0) { _discoveryShow('discovery-empty'); return; }
    const plural = data.total !== 1;
    document.getElementById('discovery-count').textContent =
      `${data.total} equipo${plural ? 's' : ''} encontrado${plural ? 's' : ''}`;
    const dim = `<td style="color:var(--text-dim);text-align:right">—</td>`;
    document.getElementById('discovery-body').innerHTML = data.results.map(h => {
      const a = h.agent;
      const name = a ? (a.display_name || a.hostname) : (h.hostname || '—');
      const os   = a ? `${a.os || ''}${a.os_version ? ' ' + a.os_version : ''}`.trim() || '—' : '—';
      const cpu  = a?.cpu_percent  != null ? metricCell(a.cpu_percent)  : dim;
      const ram  = a?.ram_percent  != null ? metricCell(a.ram_percent)  : dim;
      const disk = a?.disk_percent != null ? metricCell(a.disk_percent) : dim;
      const status = a
        ? (a.status === 'online'
            ? '<span style="color:var(--green);font-weight:600">● Online</span>'
            : '<span style="color:var(--red)">● Offline</span>')
        : '<span style="color:var(--text-dim)">Sin agente</span>';
      return `<tr>
        <td><strong>${h.ip}</strong></td>
        <td>${name}${a?.cpu_model ? `<br><span style="font-size:11px;color:var(--text-dim)">${a.cpu_model}</span>` : ''}</td>
        <td style="font-size:12px;color:var(--text-dim)">${os}</td>
        ${cpu}${ram}${disk}
        <td style="color:var(--text-dim);text-align:right">${h.latency_ms} ms</td>
        <td>${status}</td>
      </tr>`;
    }).join('');
    _discoveryShow('discovery-results');
  } catch(e) {
    _discoveryShow(null);
    alert('Error al escanear: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Escanear';
  }
}

// Autodetectar red local al abrir la vista de descubrimiento
function _initDiscovery() {
  const input = document.getElementById('discovery-subnet');
  if (!input.value) {
    fetch('/api/discovery/local-subnet', { headers: { 'Authorization': `Bearer ${token}` } })
      .then(r => r.ok ? r.json() : null)
      .then(d => { if (d?.subnet) input.value = d.subnet; })
      .catch(() => {});
  }
}

// ── Enter en login ─────────────────────────────────────────────────────────
document.getElementById('login-pass').addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); });

// ── Auto-login si hay token ────────────────────────────────────────────────
(async () => {
  // Si el link trae ?reset=TOKEN (desde el correo de "olvidé mi contraseña"),
  // priorizar esa pantalla por sobre el auto-login normal - aunque el
  // navegador ya tenga una sesión guardada, el usuario llegó acá para poner
  // una contraseña nueva.
  if (_resetToken) {
    document.getElementById('login-view').style.display = 'none';
    document.getElementById('reset-view').style.display = 'flex';
    return;
  }
  if (token) {
    const me = await fetch('/api/auth/me', {headers:{'Authorization':`Bearer ${token}`}});
    if (me.ok) {
      const d = await me.json();
      currentUser = d;
      await startApp();
      if (d.must_change_password) {
        openForceChangeModal();
      }
    } else {
      localStorage.removeItem('sm_token');
    }
  }
})();
</script>
</body>
</html>
