# ==============================================================================
# SmartMonitor v3 - Plantilla Completa de Variables de Entorno (.env)
# ==============================================================================
# Copia este archivo como '.env' en la carpeta 'server/' y ajusta los valores
# según tu entorno de producción antes de ejecutar 'docker compose up -d'.
# ==============================================================================

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=<db_name>
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>

# ── Seguridad y Autenticación del Servidor ───────────────────────────────────
# Generar una clave secreta segura en producción (ej. `openssl rand -hex 32`)
SECRET_KEY=<secret_key>
ADMIN_EMAIL=<admin_email>
ADMIN_PASSWORD=<admin_password>

# ── Red y Servidor DNS de Filtrado Web ──────────────────────────────────────
# IP LAN o Pública del servidor donde se redirige la página de bloqueo web
DNS_BLOCK_REDIRECT_IP=<dns_block_redirect_ip>

# Servidor DNS Upstream para resolver dominios permitidos (por defecto 1.1.1.1 / Cloudflare)
DNS_UPSTREAM=<dns_upstream>

# Habilitar endpoint DNS-over-HTTPS (/dns-query) para agentes cliente (por defecto true)
DOH_ENDPOINT_ENABLED=<doh_endpoint_enabled>

# Puertos para la página de bloqueo HTTP y HTTPS (por defecto 80 y 443)
DNS_BLOCK_HTTP_PORT=<dns_block_http_port>
DNS_BLOCK_HTTPS_PORT=<dns_block_https_port>

# (Opcional) Dominio público asignado al panel de administración (ej. monitoreo.smartboleta.com)
ADMIN_PANEL_DOMAIN=<admin_panel_domain>

# ── Servidor VPN Headscale / WireGuard ────────────────────────────────────────
# HEADSCALE_URL: Dirección interna de Headscale dentro de la red del contenedor
HEADSCALE_URL=<headscale_url>
# HEADSCALE_PUBLIC_URL: URL/IP pública alcanzable por las laptops clientes
HEADSCALE_PUBLIC_URL=<headscale_public_url>

# HEADSCALE_API_KEY: Clave de API de Headscale para generar Pre-Auth Keys de WireGuard.
# Generar ejecutando en la terminal del servidor: `docker exec -it smartmonitor-headscale headscale apikeys create`
HEADSCALE_API_KEY=

# HEADSCALE_USER_ID: ID o nombre del usuario/namespace en Headscale (por defecto '1' o 'smartmonitor')
# Ver usuarios existentes ejecutando: `docker exec -it smartmonitor-headscale headscale users list`
HEADSCALE_USER_ID=1

# (Opcional) IP estática asignada al servidor dentro del tailnet de Headscale
HEADSCALE_SERVER_TAILNET_IP=

# ── Certificados SSL/TLS Opcionales para el Panel de Administración ──────────
ADMIN_TLS_CERT=/data/tls/fullchain.pem
ADMIN_TLS_KEY=/data/tls/privkey.pem
ADMIN_TLS_BIND=127.0.0.1
